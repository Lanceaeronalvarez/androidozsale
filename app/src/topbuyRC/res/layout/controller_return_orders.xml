<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

        <include layout="@layout/partial_no_return_orders_placeholder_layout"
                 android:visibility="visible" />


    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/controller_return_orders_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextView
            android:fontFamily="@string/font_app_medium"
            android:id="@+id/controller_return_order_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingBottom="10dp"
            android:paddingStart="20dp"
            android:paddingLeft="20dp"
            android:paddingEnd="20dp"
            android:paddingRight="20dp"
            android:text="Select Orders"
            android:textSize="@dimen/text_size_headline1"
            android:textColor="#b7b7b7"/>

        <android.support.v7.widget.RecyclerView
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/controller_returns_select_orders_recyclerview"
            android:layout_below="@+id/controller_return_order_title"
            android:overScrollMode="never"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"/>

    </RelativeLayout>


</RelativeLayout>
