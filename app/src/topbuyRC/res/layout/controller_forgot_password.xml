<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/forgot_password_form_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:id="@+id/templateEditTextWrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:isScrollContainer="true"
        android:orientation="vertical"
        android:scrollbars="horizontal">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/forgot_password_guide"
            android:textColor="@color/dark_icon"
            android:layout_marginTop="20dp"
            fontPath="@string/font_app_light"/>

        <RelativeLayout
            android:id="@+id/forgot_password_button_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            tools:ignore="UselessParent">


            <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                            android:id="@+id/forgot_password_form"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingLeft="15dp"
                            android:paddingRight="15dp">

                <FrameLayout
                    android:id="@+id/controller_forgot_password_email_form"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:textAllCaps="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/email_address"
                            android:textColor="@color/dark_icon"
                            fontpath="@string/font_app_medium"/>

                        <android.support.design.widget.TextInputLayout
                            android:id="@+id/emailWrapper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:hintEnabled="false">

                            <EditText
                                android:id="@+id/controller_forgot_password_email_edittext"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top"
                                android:hint="@string/email_address"
                                android:padding="15dp"
                                android:paddingEnd="0dp"
                                android:paddingLeft="10dp"
                                android:paddingRight="0dp"
                                android:paddingStart="10dp"
                                android:singleLine="true"
                                android:textColor="@color/dark_icon"
                                android:textColorHint="#c1c1c1"
                                style="@style/DDEditTextStyle"
                                fontPath="@string/font_app_medium"
                                tools:ignore="Deprecated"/>

                        </android.support.design.widget.TextInputLayout>
                    </LinearLayout>
                </FrameLayout>


            </RelativeLayout>


            <Button
                android:id="@+id/controller_forgot_password_send_button"
                style="@style/DDButtonStyle"
                fontPath="@string/font_app_semibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/forgot_password_form"
                android:layout_marginTop="40dp"
                android:layout_marginLeft="@dimen/activity_horizontal_margin"
                android:layout_marginRight="@dimen/activity_horizontal_margin"
                android:text="@string/send"
                android:textSize="@dimen/text_size_headline1"/>


        </RelativeLayout>
    </LinearLayout>
</android.support.v4.widget.NestedScrollView>