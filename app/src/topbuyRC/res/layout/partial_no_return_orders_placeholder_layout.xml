<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/no_returns_placeholder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="@dimen/padding_default"
    android:paddingRight="@dimen/padding_default"
    tools:ignore="MissingPrefix">

    <ImageView
        android:layout_width="@dimen/placeholder_icon_width"
        android:layout_height="@dimen/placeholder_icon_height"
        android:layout_gravity="center"
        android:src="@drawable/ic_orders_placeholder" />

    <TextView
        fontPath="@string/font_app_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:layout_marginBottom="@dimen/default_button_height"
        android:paddingBottom="@dimen/default_button_height"
        android:text="you have not added any orders for return."
        android:textColor="#9f9f9f"
        android:textSize="@dimen/text_size_headline1" />
</LinearLayout>
