<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@android:color/white"
              android:paddingRight="16dp"
              android:orientation="horizontal" >


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/partial_checkout_payment_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:textColor="@color/dark_gray"
            android:fontFamily="@string/font_app_bold"
            android:textSize="@dimen/text_size_xxlarge"
            tools:text="Master Card" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/partial_checkout_payment_image"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:paddingBottom="5dp"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:src="@drawable/ic_my_vouchers" />

            <TextView
                android:id="@+id/partial_checkout_payment_details"
                android:layout_toRightOf="@+id/partial_checkout_payment_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/partial_checkout_payment_image"
                android:layout_alignBottom="@+id/partial_checkout_payment_image"
                android:gravity="center_vertical"
                android:layout_marginBottom="5dp"
                android:layout_marginLeft="5dp"
                android:textColor="@color/gray_field_text"
                tools:text="card ending in 02/16" />


        </RelativeLayout>

        <TextView
            android:id="@+id/partial_checkout_payment_remove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove"
            android:textColor="@color/gray_item_details"
            android:textSize="@dimen/text_size_xxlarge"
            android:visibility="gone" />

        <View
            android:id="@+id/item_payment_select_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#ECECEC"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>