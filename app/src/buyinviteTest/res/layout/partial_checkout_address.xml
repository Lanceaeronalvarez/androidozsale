<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical">


    <RelativeLayout
        android:id="@+id/partial_checkout_address_new_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:padding="15dp">

        <ImageView
            android:id="@+id/partial_checkout_address_image"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:paddingBottom="5dp"
            android:src="@drawable/ic_home_delivery" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:src="@drawable/ic_gray_chevron"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/partial_checkout_address_image"
            android:layout_alignBottom="@+id/partial_checkout_address_image"
            android:layout_toRightOf="@+id/partial_checkout_address_image"
            android:gravity="center_vertical"
            android:text="@string/add_new_address"
            android:layout_marginLeft="10dp"
            android:textColor="@color/text_medium"
            android:textSize="16sp"
            />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/partial_checkout_address_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="10dp"
        android:visibility="visible">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16sp"
            android:layout_marginRight="16sp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:clickable="true">

            <ImageView
                android:id="@+id/address_icon_temp"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:paddingBottom="10dp"
                android:src="@drawable/ic_home_delivery" />


            <TextView
                android:id="@+id/address_header"
                android:layout_toRightOf="@+id/address_icon_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Current Delivery Address"
                android:fontFamily="@string/font_app_bold"
                android:textColor="@color/dark_gray"
                android:layout_marginLeft="10dp"
                android:textSize="@dimen/text_size_body"/>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignEnd="@+id/partial_checkout_address_change"
                android:src="@drawable/ic_gray_chevron"/>

            <TextView
                android:id="@+id/partial_checkout_address_change"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginBottom="10dp"
                android:gravity="end"
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_headline3"
                android:visibility="invisible"/>

            <LinearLayout
                android:layout_alignLeft="@+id/address_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@+id/partial_checkout_address_change" >

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:paddingBottom="5dp"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:visibility="gone"
                    android:src="@drawable/ic_home_delivery"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" >

                    <TextView
                        android:id="@+id/partial_checkout_address_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dark_gray"
                        android:textSize="@dimen/text_size_headline2"
                        android:fontFamily="@string/font_app_bold"
                        tools:text="Mary Doe"/>

                    <TextView
                        android:id="@+id/partial_checkout_address_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_medium"
                        tools:text="Pharmacy Warringah, Shop 4123, Broovale, NSW, 2100, Australia, +0123 123 123"/>

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F2F2F2"/>

</LinearLayout>