<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <include layout="@layout/partial_toolbar_arrow" />

    <include layout="@layout/partial_checkout_empty" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/checkout_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/controller_checkout_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:descendantFocusability="blocksDescendants"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/controller_checkout_recyclerview_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <include layout="@layout/partial_checkout_address" />

            <include layout="@layout/partial_checkout_delivery_options" />

            <TextView
                fontPath="@string/font_app_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_default_half"
                android:paddingStart="@dimen/padding_default"
                android:paddingEnd="@dimen/padding_default"
                android:text="@string/payment"
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_caption2" />

            <include layout="@layout/partial_checkout_voucher" />

            <include layout="@layout/partial_checkout_summary" />

            <TextView
                fontPath="@string/font_app_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_default_half"
                android:layout_marginBottom="@dimen/padding_default_half"
                android:paddingStart="@dimen/padding_default"
                android:paddingEnd="@dimen/padding_default"
                android:text="@string/payment_options"
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_caption2" />

            <include layout="@layout/partial_checkout_button" />

            <include layout="@layout/partial_checkout_payment" />

            <Button
                android:id="@+id/controller_checkout_button_pay"
                style="@style/DDButtonPayCart"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="@string/pay"
                android:textSize="@dimen/text_size_headline2"
                android:layout_marginLeft="@dimen/padding_default"
                android:layout_marginTop="@dimen/padding_default"
                android:layout_marginRight="@dimen/padding_default"
                android:visibility="visible" />

            <include layout="@layout/partial_checkout_age_restriction" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_40" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</LinearLayout>
