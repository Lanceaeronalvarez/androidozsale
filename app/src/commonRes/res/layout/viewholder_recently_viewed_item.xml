<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewholder_banner_layout"
    android:layout_width="@dimen/recently_viewed_height"
    android:layout_height="@dimen/recently_viewed_width"
    android:layout_marginBottom="1dp"
    android:background="@color/white"
    android:clickable="true"
    android:orientation="vertical"
    android:paddingLeft="@dimen/horizontal_banner_spacing"
    android:paddingRight="@dimen/horizontal_banner_spacing"
    tools:ignore="MissingPrefix"
    android:paddingBottom="@dimen/margin_tiny">

    <ImageView
        android:id="@+id/viewholder_image_display_imageview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:transitionName="image"
        android:layout_above="@+id/viewholder_recently_viewed_text"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/viewholder_recently_viewed_text"
        android:text="text"
        android:layout_alignParentBottom="true"
        android:gravity="center_horizontal"
        android:textSize="@dimen/text_size_caption2"
        android:singleLine="true"
        android:ellipsize="end"/>

</RelativeLayout>