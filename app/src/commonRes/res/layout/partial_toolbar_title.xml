<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/toolbar_skin"
    android:contentInsetStart="0dp"
    android:contentInsetLeft="0dp"
    android:contentInsetEnd="0dp"
    android:contentInsetRight="0dp"
    app:contentInsetEnd="0dp"
    app:contentInsetLeft="0dp"
    app:contentInsetRight="0dp"
    app:contentInsetStart="0dp"
    tools:ignore="MissingPrefix">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@id/partial_toolbar_field_title_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_centerVertical="true"
            android:maxLines="1"
            android:padding="@dimen/margin_tiny"
            android:text=""
            android:textColor="@color/toolbar_text_dark"
            android:textSize="@dimen/text_size_headline2" />

        <ImageButton
            android:id="@+id/partial_toolbar_field_title_left_option"
            fontPath="@string/font_app_regular"
            android:layout_width="@dimen/partial_toolbar_button_width"
            android:layout_height="@dimen/partial_toolbar_button_height"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:background="@color/toolbar_skin"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left_black"
            android:textSize="@dimen/text_size_caption1"  />

        <ImageButton
            android:id="@+id/partial_toolbar_field_title_right_option"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignTop="@+id/partial_toolbar_field_title_textview"
            android:layout_alignBottom="@+id/partial_toolbar_field_title_textview"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@color/white"
            android:src="@drawable/ic_toolbar_filter"
            android:textSize="@dimen/text_size_caption1"
            android:visibility="invisible" />

    </RelativeLayout>

</androidx.appcompat.widget.Toolbar>