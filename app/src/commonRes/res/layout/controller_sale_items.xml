<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/controller_sale_items_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <include
        layout="@layout/partial_wishlist_empty"
        android:visibility="gone" />

    <include
        layout="@layout/partial_toolbar_title_details"
        android:visibility="gone" />

    <include layout="@layout/partial_toolbar_logo_sales"
        android:visibility="visible"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/beige"/>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/controller_sale_items_main_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible">

       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="vertical"
           app:layout_behavior="@string/appbar_scrolling_view_behavior">

           <RelativeLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content">

               <TextView
                   android:id="@+id/controller_sale_items_result_count"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:textSize="@dimen/text_size_body"
                   android:textColor="@color/black"
                   android:paddingTop="10dp"
                   android:paddingBottom="10dp"
                   android:layout_marginLeft="10dp"/>

           </RelativeLayout>

           <androidx.recyclerview.widget.RecyclerView
               android:id="@+id/controller_sale_items_grid_view"
               android:layout_width="match_parent"
               android:layout_height="match_parent"
               android:background="@color/white"
               android:clickable="true"
               android:focusable="true"
               android:paddingLeft="@dimen/margin_extra_small"
               android:paddingRight="@dimen/margin_extra_small"
               android:visibility="visible" />

       </LinearLayout>

        <LinearLayout
            android:id="@+id/controller_sale_items_text_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="?attr/actionBarSize"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                fontPath="@string/font_app_semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@string/font_app_bold"
                android:gravity="center"
                android:paddingLeft="@dimen/padding_default_half"
                android:paddingRight="@dimen/padding_default_half"
                android:text="@string/sorry_today_we_can_t_find_anything_by_your_request"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_size_headline3" />

            <TextView
                fontPath="@string/font_app_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@string/font_app_bold"
                android:gravity="center"
                android:paddingLeft="@dimen/padding_default_half"
                android:paddingRight="@dimen/padding_default_half"
                android:text="@string/meanwhile_why_not_search_for_something_else"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_size_body" />

        </LinearLayout>

        <com.bluelinelabs.conductor.ChangeHandlerFrameLayout
            android:id="@+id/controller_search_filter_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sale_details_app_bar_height"
            android:visibility="visible" />

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/controller_sale_items_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/controller_sale_collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:fitsSystemWindows="true"
                app:contentScrim="@color/toolbar_fade_in_color"
                android:background="@color/toolbar_skin"
                app:layout_scrollFlags="scroll|enterAlways">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <au.com.dealsdirect.ui.custom.SearchEditText
                        android:id="@+id/partial_toolbar_field_title_edittext"
                        style="@style/DDEditTextSearchBar"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/activity_horizontal_margin"
                        android:layout_marginRight="@dimen/activity_horizontal_margin"
                        android:clickable="true"
                        android:drawableLeft="@drawable/ic_search_gray"
                        android:drawablePadding="@dimen/margin_extra_small"
                        android:hint="@string/search_tag"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_light"
                        android:textCursorDrawable="@color/text_dark"
                        android:textSize="@dimen/text_size_body"
                        android:visibility="gone"
                        app:layout_collapseMode="parallax"
                        app:layout_collapseParallaxMultiplier="0.5"
                        app:layout_scrollFlags="scroll|enterAlways"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/Search_term_Result"
                        fontPath="@string/font_app_bold"
                        android:textStyle="bold"
                        android:background="@color/white"
                        android:textSize="@dimen/text_size_headline3"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Search Results term"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingTop="30dp"
                        android:textColor="@color/black"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:paddingBottom="20dp"
                        android:paddingTop="20dp"
                        android:gravity="center">

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginRight="10dp"
                            android:layout_marginLeft="10dp"
                            android:id="@+id/sale_item_filter_cardview">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:gravity="center"
                                android:background="@drawable/border_black"
                                android:padding="20dp">

                                <TextView
                                    android:drawableStart="@drawable/new_filter_icon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawablePadding="10dp"
                                    android:id="@+id/Filter_Text"
                                    android:text="Filter"
                                    android:textSize="@dimen/text_size_body"
                                    android:textColor="@color/black"/>

                            </RelativeLayout>

                            <ImageView
                                android:id="@+id/sale_filter_count"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginLeft="60dp"
                                android:visibility="gone"
                                android:layout_gravity="center"
                                android:background="@drawable/circle_indicator_active"
                                android:backgroundTint="@color/fluorescent_blue"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:layout_marginLeft="60dp"
                                android:layout_gravity="center"
                                android:id="@+id/Filter_Count_Text"
                                android:visibility="gone"
                                android:text="0" />

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginRight="10dp"
                            android:id="@+id/sale_item_sort_cardview">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:gravity="center"
                                android:background="@drawable/border_black"
                                android:padding="20dp">

                                <TextView
                                    android:drawableStart="@drawable/new_sort_icon"
                                    android:drawablePadding="10dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/text_size_body"
                                    android:text="Sort"
                                    android:textColor="@color/black"/>

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/sale_sort_count"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginLeft="60dp"
                                android:visibility="gone"
                                android:layout_gravity="center"
                                android:background="@drawable/circle_indicator_active"
                                android:backgroundTint="@color/fluorescent_blue"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:layout_marginLeft="60dp"
                                android:layout_gravity="center"
                                android:id="@+id/sort_count_text"
                                android:visibility="gone"
                                android:text="1" />

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chip_group"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:layout_marginBottom="10dp"
                            android:theme="@style/Theme.MaterialComponents.Light"/>

                    </HorizontalScrollView>

                    <RelativeLayout
                        android:id="@+id/toolbar_border"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/beige"
                        android:layout_alignParentBottom="true"
                        android:visibility="gone"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/leaderBoardBanner"
                        android:adjustViewBounds="true" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/controller_toolbar_brand_bubbles"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/controller_brand_bubbles_height"
                        android:visibility="gone" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/controller_sale_items_tab_height"
                        android:visibility="gone">

                        <au.com.dealsdirect.ui.custom.AdaptiveTabLayout
                            android:id="@+id/controller_search_filter_tabs"
                            style="@style/FacetFilterTabLayout"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/controller_sale_items_tab_height"
                            android:layout_gravity="bottom"
                            android:background="@color/white"
                            android:minHeight="@dimen/controller_sale_items_tab_height"
                            android:visibility="visible"
                            app:tabMaxWidth="0dp" />

                        <LinearLayout
                            android:id="@+id/controller_sale_items_search_skeleton"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/controller_sale_items_tab_height"
                            android:layout_gravity="bottom"
                            android:gravity="left"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            android:weightSum="4.5">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="@dimen/margin_medium"
                                android:layout_marginRight="@dimen/margin_medium"
                                android:layout_weight="1"
                                android:background="@drawable/bg_skeleton_fixed_height" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="@dimen/margin_medium"
                                android:layout_marginRight="@dimen/margin_medium"
                                android:layout_weight="1"
                                android:background="@drawable/bg_skeleton_fixed_height" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="@dimen/margin_medium"
                                android:layout_marginRight="@dimen/margin_medium"
                                android:layout_weight="1"
                                android:background="@drawable/bg_skeleton_fixed_height" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="@dimen/margin_medium"
                                android:layout_marginRight="@dimen/margin_medium"
                                android:layout_weight="1"
                                android:background="@drawable/bg_skeleton_fixed_height" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="@dimen/margin_medium"
                                android:layout_marginRight="@dimen/margin_medium"
                                android:layout_weight="1"
                                android:background="@drawable/bg_skeleton_fixed_height" />
                        </LinearLayout>

                    </RelativeLayout>

                </LinearLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <RelativeLayout
        android:id="@+id/adView_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
