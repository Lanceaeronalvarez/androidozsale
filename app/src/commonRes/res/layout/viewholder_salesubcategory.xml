<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/viewholder_subcategory_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/viewholder_subcategory_height"
        android:background="@color/white">

        <ImageView
            android:id="@+id/viewholder_subcategory_check"
            android:layout_width="match_parent"
            android:layout_height="@dimen/row_facet_item_height"
            android:background="@color/sale_category_selector"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/viewholder_subcategory_title"
            fontPath="@string/font_app_regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:lines="1"
            android:textColor="@color/text_medium"
            android:textSize="@dimen/text_size_caption1"
            android:layout_gravity="left|center_vertical"
            tools:ignore="MissingPrefix"
            tools:text="Category" />

    </FrameLayout>

    <View
        android:id="@+id/viewholder_subcategory_border"
        android:layout_width="match_parent"
        android:layout_height="@dimen/border_regular"
        android:layout_marginLeft="@dimen/margin_tiny"
        android:background="@color/border_regular"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/viewholder_subcategory_items_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"/>


    <View
        android:id="@+id/viewholder_subcategoryitems_border"
        android:layout_width="match_parent"
        android:layout_height="@dimen/border_regular"
        android:layout_marginLeft="@dimen/margin_tiny"
        android:background="@color/border_regular"
        android:visibility="gone" />

</LinearLayout>
