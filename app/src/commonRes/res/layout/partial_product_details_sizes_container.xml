<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/product_details_sizes_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingLeft="@dimen/margin_small"
    android:paddingRight="@dimen/margin_small"
    android:paddingBottom="@dimen/margin_small"
    android:paddingTop="@dimen/margin_small"
    android:visibility="visible">

    <RelativeLayout
        android:id="@+id/product_details_size_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/product_details_size_label_text"
            fontPath="@string/font_app_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/margin_extra_small"
            android:paddingBottom="@dimen/margin_extra_small"
            android:text="@string/choose_size"
            android:textColor="@color/text_medium"
            android:textSize="@dimen/text_size_caption1"
            android:visibility="gone"/>

        <RelativeLayout
            android:id="@+id/size_guide_link_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/product_details_size_label_text"
            android:paddingTop="@dimen/margin_extra_small"
            android:paddingBottom="@dimen/margin_extra_small">

            <ImageView
                android:id="@+id/size_guide_link_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/size_guide_icon" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_toRightOf="@+id/size_guide_link_icon">

                <TextView
                    android:id="@+id/size_guide_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/margin_small"
                    android:text="@string/size_guide"
                    android:textColor="@color/black"
                    fontPath="@string/font_app_bold"
                    android:textSize="@dimen/text_size_headline3" />

                <TextView
                    android:id="@+id/size_guide_link_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/margin_medium"
                    android:layout_toRightOf="@+id/size_guide_text"
                    android:text="@string/size_guide_link"
                    android:textColor="@color/beige"
                    fontPath="@string/font_app_bold"
                    android:textSize="@dimen/text_size_caption1" />

            </LinearLayout>

        </RelativeLayout>

    </RelativeLayout>

    <com.zhy.view.flowlayout.TagFlowLayout
        android:id="@+id/product_details_size_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/product_details_size_label"
        android:layout_marginTop="@dimen/margin_extra_small"
        app:max_select="1" />

    <TextView
        android:id="@+id/product_details_size_notice"
        fontPath="@string/font_app_semibold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/product_details_size_list"
        android:text="@string/please_select_size"
        android:textAllCaps="true"
        android:textColor="@color/red"
        android:textSize="@dimen/text_size_caption1"
        android:visibility="gone" />

</RelativeLayout>