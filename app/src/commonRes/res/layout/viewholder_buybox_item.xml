<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/margin_small">

    <TextView
        android:id="@+id/price_text"
        fontPath="@string/font_app_bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$78.00 + Shipping"
        android:textColor="@color/text_extra_dark"
        android:textSize="@dimen/text_size_caption1"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/sold_by_text"
        fontPath="@string/font_app_regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sold by Ozsale"
        android:textColor="@color/text_dark"
        android:textSize="@dimen/text_size_caption1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/price_text" />

    <Button
        android:id="@+id/select_button"
        style="@style/DDButtonStyleTransparent"
        fontPath="@string/font_app_bold"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minHeight="36dp"
        android:padding="@dimen/margin_tiny"
        android:text="Select"
        android:textSize="@dimen/text_size_body"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>