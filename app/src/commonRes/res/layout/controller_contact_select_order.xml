<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:animateLayoutChanges="true"
    android:background="@color/background_default"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <include layout="@layout/partial_toolbar_arrow" />

    <TextView
        android:id="@+id/controller_select_sale_subtitle"
        fontPath="@string/font_app_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/padding_default_half"
        android:layout_marginStart="@dimen/padding_default"
        android:layout_marginTop="@dimen/padding_default"
        android:text="@string/enter_invoice_number"
        android:textColor="@color/text_medium"
        android:textSize="@dimen/text_size_caption2" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/my_contact_select_order_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:overScrollMode="never" />

    <TextView
        android:id="@+id/controller_contact_select_order_placeholder"
        fontPath="@string/font_app_regular"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/no_orders"
        android:textColor="@color/text_medium"
        android:textSize="@dimen/text_size_body"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/controller_contact_select_order_invoice_input_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    fontPath="@string/font_app_semibold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_default"
                    android:text="@string/invoice_number_text"
                    android:maxLines="1"
                    android:textColor="@color/text_medium"
                    android:textSize="@dimen/text_size_caption1" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/controller_contact_select_order_invoice_input"
                        style="@style/DDEditTextStyleNoBorder"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text|number"
                        android:maxLines="1"
                        android:textSize="@dimen/text_size_caption1" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

        </LinearLayout>
        <Button
            android:id="@+id/controller_contact_select_order_invoice_input_button"
            style="@style/DDButtonStyle"
            android:layout_width="match_parent"
            android:layout_margin="@dimen/padding_default"
            android:layout_alignParentBottom="true"
            android:text="Submit" />
    </RelativeLayout>


</LinearLayout>



