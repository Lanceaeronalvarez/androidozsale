<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:backgroundTint="@color/white"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:ignore="MissingPrefix">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/padding_default"
        android:paddingTop="@dimen/padding_default"
        android:paddingEnd="@dimen/padding_default"
        android:paddingBottom="@dimen/padding_default_half">

        <TextView
            android:id="@+id/title"
            fontPath="@string/font_app_bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            android:gravity="center_horizontal"
            android:padding="@dimen/margin_medium"
            android:text="Welcome to My Returns!"
            android:textColor="@color/text_medium"
            android:textSize="@dimen/text_size_headline3"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView"
            fontPath="@string/font_app_regular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_large"
            android:gravity="left"
            android:text="Click the 'Request New Return' button to return your items within 14 days of receiving them.\n\nOur Customer Team will review request within 1-3 working days. Once approved, you will receive an email with your unique Return Authorisation Number (RAN) and return instructions. Please make sure your email address is correctly in My Details page. You can also track the progress of your return request below."
            android:textColor="@color/text_medium"
            android:textSize="@dimen/text_size_body"
            app:layout_constraintBottom_toTopOf="@id/partial_new_return_info_continue_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title" />

        <Button
            android:id="@+id/partial_new_return_info_continue_button"
            style="@style/DDButtonStyle"
            android:layout_width="match_parent"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/padding_default"
            android:text="Got this!"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="@dimen/padding_default" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>