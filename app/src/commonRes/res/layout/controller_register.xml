<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <include
        android:id="@+id/toolbar_title_login"
        layout="@layout/partial_toolbar_login_close" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/controller_login_legalities_container"
            android:background="@color/background_default"
            android:fillViewport="true"
            android:orientation="vertical"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/controller_register_back_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:rotation="180"
                        android:src="@drawable/ic_gray_chevron"
                        android:tint="#959595" />

                    <ImageView
                        android:id="@+id/controller_register_close_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_alignParentEnd="true"
                        android:rotation="180"
                        android:src="@drawable/ic_close"
                        android:tint="#959595" />

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_extra_large"
                    android:background="@color/white"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.35"
                        android:padding="@dimen/padding_default"
                        android:text="@string/first_name"
                        android:textColor="@color/text_medium"
                        android:textSize="@dimen/text_size_body" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/controller_register_forename_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.65"
                        app:hintEnabled="false">

                        <EditText
                            android:id="@+id/controller_register_forename_field"
                            style="@style/DDEditTextStyleNoBorder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/border_thin"
                    android:background="@color/white"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.35"
                        android:padding="@dimen/padding_default"
                        android:text="@string/last_name"
                        android:textColor="@color/text_medium"
                        android:textSize="@dimen/text_size_body" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/controller_register_surname_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.65"
                        app:hintEnabled="false">

                        <EditText
                            android:id="@+id/controller_register_surname_field"
                            style="@style/DDEditTextStyleNoBorder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/border_thin"
                    android:background="@color/white"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.35"
                        android:padding="@dimen/padding_default"
                        android:text="@string/email_hint"
                        android:textColor="@color/text_medium"
                        android:textSize="@dimen/text_size_body" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/controller_register_email_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.65"
                        app:hintEnabled="false">

                        <EditText
                            android:id="@+id/controller_register_email_field"
                            style="@style/DDEditTextStyleNoBorder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/border_thin"
                    android:background="@color/white"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.35"
                        android:padding="@dimen/padding_default"
                        android:text="@string/password"
                        android:textColor="@color/text_medium"
                        android:textSize="@dimen/text_size_body" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/controller_register_password_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.65"
                        app:hintEnabled="false"
                        app:passwordToggleDrawable="@drawable/ic_show_password_toggle"
                        app:passwordToggleEnabled="true">

                        <EditText
                            android:id="@+id/controller_register_password_field"
                            style="@style/DDEditTextStyleNoBorder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/padding_default"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_large"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <CheckBox
                            android:id="@+id/controller_register_terms_conditions_check"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-5dp"
                            android:checked="true"
                            android:text="I agree to the "
                            android:textColor="@color/filter_text_inactive"
                            android:textSize="@dimen/text_size_caption1" />

                        <TextView
                            android:id="@+id/controller_register_terms_link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Terms and Conditions"
                            android:textColor="@color/tab_bar_icon_active"
                            android:textSize="@dimen/text_size_caption1" />
                    </LinearLayout>

                    <RelativeLayout
                        android:id="@+id/controller_register_consent_switch_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginBottom="@dimen/margin_large">

                        <au.com.dealsdirect.ui.custom.toggleswitch.CustomToggleSwitch
                            android:id="@+id/controller_register_tnc_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/padding_small"
                            app:textToggleLeft="Yes"
                            app:textToggleRight="No"/>

                        <TextView
                            android:id="@+id/controller_register_tnc_text"
                            android:layout_toRightOf="@+id/controller_register_tnc_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="@dimen/padding_small"
                            android:layout_alignBottom="@+id/controller_register_tnc_toggle"
                            android:layout_alignTop="@+id/controller_register_tnc_toggle"
                            android:gravity="center_vertical"
                            android:textSize="@dimen/text_size_caption1"
                            tools:text="I agree to the Terms and Conditions"/>

                        <au.com.dealsdirect.ui.custom.toggleswitch.CustomToggleSwitch
                            android:id="@+id/controller_register_emails_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/controller_register_tnc_toggle"
                            app:textToggleLeft="Yes"
                            app:textToggleRight="No"/>

                        <TextView
                            android:id="@+id/controller_register_emails_text"
                            android:layout_toRightOf="@+id/controller_register_emails_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="@dimen/padding_small"
                            android:layout_alignBottom="@+id/controller_register_emails_toggle"
                            android:layout_alignTop="@+id/controller_register_emails_toggle"
                            android:gravity="center_vertical"
                            android:textSize="@dimen/text_size_caption1"
                            tools:text="I agree to receive promotional emails"/>

                    </RelativeLayout>

                    <Button
                        android:id="@+id/controller_register_sign_up_button"
                        style="@style/DDButtonStyle"
                        fontPath="@string/font_app_semibold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/see_todays_sale"
                        android:textSize="@dimen/text_size_headline3" />

                    <RelativeLayout
                        android:id="@+id/controller_login_fb_layout"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height_regular"
                        android:layout_marginTop="@dimen/margin_small"
                        android:background="@drawable/login_default_button"
                        android:clickable="true"
                        android:elevation="@dimen/button_elevation">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true">

                            <ImageView
                                android:id="@+id/controller_login_facebook_image_view"
                                android:layout_width="@dimen/button_drawable_width"
                                android:layout_height="@dimen/button_drawable_height"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/margin_small"
                                android:scaleType="fitCenter"
                                android:src="@drawable/facebook"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:id="@+id/controller_login_with_facebook_text"
                                fontPath="@string/font_app_semibold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/margin_small"
                                android:text="@string/sign_in_with_facebook"
                                android:textColor="@android:color/white"
                                android:textSize="@dimen/text_size_headline3" />
                        </LinearLayout>
                    </RelativeLayout>

                    <Button
                        android:id="@+id/button_visa_checkout"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/default_button_height"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_gravity="center"
                        android:background="@drawable/vco_button"
                        app:animation="true"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_small"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="@dimen/margin_tiny">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/save_80_off"
                            android:textColor="@color/text_extra_dark"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_size_body" />

                        <TextView
                            android:id="@+id/controller_register_login_text"
                            fontPath="@string/font_app_semibold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:paddingEnd="0dp"
                            android:paddingStart="@dimen/margin_extra_small"
                            android:text="@string/log_in"
                            android:textAllCaps="true"
                            android:textColor="@color/bg_button_default"
                            android:textSize="@dimen/text_size_caption1"
                            android:visibility="gone"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingEnd="0dp"
                            android:paddingStart="@dimen/margin_extra_small"
                            android:text="@string/here"
                            android:textColor="@color/text_extra_dark"
                            android:textSize="@dimen/text_size_caption1"
                            android:visibility="gone"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/designer_fashion_more"
                        android:textColor="@color/text_extra_dark"
                        android:textSize="@dimen/text_size_caption2"
                        android:layout_gravity="center"
                        android:paddingBottom="@dimen/margin_small"/>

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/controller_login_legalities_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <View style="@style/horizontalBorderView" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingTop="@dimen/padding_default_half"
                android:paddingBottom="@dimen/padding_default_half"
                android:background="@color/background_default"
                android:gravity="center">

                <TextView
                    android:id="@+id/controller_login_about_us_textview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.33"
                    android:textColor="@color/facet_item_text_selector"
                    android:text="@string/account_about_us"
                    android:gravity="center"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/controller_login_tnc_textview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.33"
                    android:textColor="@color/facet_item_text_selector"
                    android:text="@string/account_tnc"
                    android:gravity="center"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/controller_login_privacy_textview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.33"
                    android:textColor="@color/facet_item_text_selector"
                    android:text="@string/account_privacy"
                    android:gravity="center"
                    android:textSize="@dimen/text_size_body" />

            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>



