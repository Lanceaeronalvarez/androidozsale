<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/background_default"
    android:clickable="true"
    tools:ignore="missingPrefix">

    <include
        android:id="@+id/add_vouchers_toolbar"
        layout="@layout/partial_toolbar_arrow" />


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/add_vouchers_buttons"
        android:layout_below="@+id/add_vouchers_toolbar"
        android:fillViewport="true"
        android:orientation="vertical"
        android:overScrollMode="never">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/add_vouchers_buttons"
            android:layout_below="@id/add_vouchers_toolbar"
            android:orientation="vertical">

            <TextView
                fontPath="@string/font_app_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/padding_default"
                android:layout_marginTop="@dimen/padding_default"
                android:layout_marginRight="@dimen/padding_default"
                android:layout_marginBottom="@dimen/padding_default_half"
                android:text="@string/enter_promo_code_caps"
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_caption2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/border_thin"
                    android:background="@color/white"
                    android:orientation="horizontal"
                    tools:ignore="MissingPrefix">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="@dimen/padding_default"
                        android:text="@string/promo_code"
                        android:textColor="@color/row_checkout_text_light_color"
                        android:textSize="@dimen/text_size_caption1" />

                    <EditText
                        android:id="@+id/controller_edit_text_voucher"
                        style="@style/DDEditTextStyleNoBorder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:hint="@string/enter_promo_code"
                        android:maxLines="1"
                        android:tag="dynamicEditText"
                        android:textColor="@color/text_extra_dark"
                        android:textSize="@dimen/text_size_caption1" />
                </LinearLayout>


                <Button
                    android:id="@+id/controller_button_add_voucher"
                    style="@style/DDButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_margin="@dimen/padding_default"
                    android:text="@string/apply_promo_code"
                    android:textSize="@dimen/text_size_headline2" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/promo_code_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="@dimen/padding_default"
                    android:layout_marginRight="@dimen/padding_default">
                </androidx.recyclerview.widget.RecyclerView>
            </LinearLayout>

            <View
                style="@style/horizontalBorderView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/border_thick" />

            <TextView
                android:id="@+id/controller_add_voucher_select_text"
                fontPath="@string/font_app_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginBottom="@dimen/margin_extra_small"
                android:paddingStart="@dimen/padding_default"
                android:paddingEnd="@dimen/padding_default"
                android:text="@string/select_voucher"
                android:textColor="@color/text_medium" />

            <LinearLayout
                android:id="@+id/container_voucher_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/margin_small">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/controller_recycler_view_promo_vouchers"
                    style="@style/RecyclerViewPagerVouchersStyle"
                    android:nestedScrollingEnabled="false"
                    app:rvp_singlePageFling="true"
                    app:rvp_triggerOffset="0.1" />


            </LinearLayout>

            <include layout="@layout/partial_no_voucher_placeholder_layout" />


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <include
        android:id="@+id/add_vouchers_buttons"
        layout="@layout/partial_vouchers_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
