<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/price_block"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/top_text_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/price_block_top_text_height"
        android:layout_marginBottom="@dimen/margin_tiny"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/top_left_text"
            fontPath="@string/font_app_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_tiny"
            android:layout_marginRight="@dimen/margin_tiny"
            android:textColor="@color/price_block_dark_text"
            android:textSize="@dimen/price_block_top_left_text_size"
            android:textStyle="bold"
            tools:text="WAS $0" />

        <TextView
            android:id="@+id/top_right_text"
            fontPath="@string/font_app_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_tiny"
            android:layout_marginRight="@dimen/margin_tiny"
            android:background="@drawable/bg_price_block_price_drop_border"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingLeft="2dp"
            android:paddingTop="1.5dp"
            android:paddingRight="2dp"
            android:paddingBottom="1.5dp"
            android:textColor="@color/price_block_price_drop"
            android:textSize="@dimen/price_block_top_right_text_size"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="@dimen/price_block_top_right_text_size"
            app:autoSizeMinTextSize="1px"
            app:autoSizeTextType="uniform"
            tools:text="PRICE DROP 25%" />

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/price_block_height"
        android:background="@color/price_block_right_background"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/price_block_left_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/separator_image_view"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/separator_image_view"
            android:layout_width="30dp"
            android:layout_height="0dp"
            android:layout_marginLeft="-4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_price_block_center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/left_text"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/left_text"
            fontPath="@string/font_app_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|left"
            android:lineSpacingExtra="-6dp"
            android:paddingLeft="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@color/price_block_left_text"
            android:textSize="@dimen/price_block_small_middle_left_text_size"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/right_text"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="left side\ntaller" />

        <TextView
            android:id="@+id/right_text"
            fontPath="@string/font_app_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:background="@color/transparent"
            android:gravity="center_vertical|right"
            android:paddingTop="2dp"
            android:paddingRight="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/price_block_right_text"
            android:textSize="@dimen/price_block_small_middle_right_text_size"
            android:textStyle="bold"
            android:visibility="visible"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/left_text"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="right side\nreally long text" />

        <View
            android:id="@+id/price_block_border"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_price_block_border"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <RelativeLayout
        android:id="@+id/bottom_text_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/price_block_bottom_text_single_height"
        android:layout_marginTop="@dimen/margin_tiny"
        android:gravity="center">

        <TextView
            android:id="@+id/bottom_text"
            fontPath="@string/font_app_regular"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="none"
            android:gravity="center"
            android:textColor="@color/price_block_light_text"
            android:textSize="@dimen/price_block_bottom_text_text_size"
            tools:text="Suppliers RRP or ORP NZ$400.00 " />

    </RelativeLayout>

    <TextView
        android:id="@+id/free_delivery_text"
        fontPath="@string/font_app_bold"
        android:layout_width="match_parent"
        android:layout_height="@dimen/price_block_free_shipping_text_height"
        android:gravity="center"
        android:text="FREE SHIPPING"
        android:textColor="@color/price_block_dark_text"
        android:textSize="@dimen/text_size_caption3"
        android:textStyle="bold" />

</LinearLayout>