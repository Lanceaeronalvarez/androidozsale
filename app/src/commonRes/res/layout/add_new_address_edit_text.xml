<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/border_thin"
    android:background="@color/white"
    android:orientation="horizontal"
    tools:ignore="MissingPrefix">

    <TextView
        android:id="@+id/row_add_address_label"
        fontPath="@string/font_app_regular"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.35"
        android:padding="@dimen/padding_default"
        android:textColor="@color/text_medium"
        android:textSize="@dimen/text_size_body" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.65"
        android:orientation="vertical">

        <EditText
            android:id="@+id/row_add_address_value"
            style="@style/DDEditTextStyleNoBorder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_weight="0.65"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/text_extra_dark"
            android:maxLines="1"
            android:tag="dynamicEditText" />

        <TextView
            android:id="@+id/row_add_address_error_text"
            fontPath="@string/font_app_regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_default"
            android:textColor="@color/red"
            android:textSize="10dp"
            android:visibility="gone"/>

    </LinearLayout>
</LinearLayout>