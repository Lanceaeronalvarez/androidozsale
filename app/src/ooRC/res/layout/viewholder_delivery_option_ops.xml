<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="@dimen/padding_default_half">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <CheckBox
            android:id="@+id/delivery_option_check_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:button="@drawable/bg_checkbox_selector"
            android:layout_gravity="center_horizontal"
            android:clickable="false"
            android:focusable="false"
            android:gravity="top" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="9"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/ourpay_logo_width"
                android:layout_height="@dimen/ourpay_logo_height"
                android:scaleType="fitXY"
                android:src="@drawable/ic_select_checkout_big" />

            <TextView
                android:id="@+id/delivery_option_ops_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_caption2"
                tools:text="subscription for " />
            <android.support.v7.widget.RecyclerView
                android:id="@+id/delivery_option_ops_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:overScrollMode="never"
                android:visibility="gone" />
            <TextView
                android:id="@+id/delivery_option_ops_text_tc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorAccent"
                android:maxLines="2"
                android:textSize="@dimen/text_size_caption2"
                android:text="@string/more_information"/>
        </LinearLayout>
    </LinearLayout>





</LinearLayout>