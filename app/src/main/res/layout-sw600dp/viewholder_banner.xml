<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewholder_banner_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="@dimen/margin_tiny"
    android:clickable="true"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/viewholder_banner_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/viewholder_banner_info_group"
            android:layout_alignParentTop="true"
            android:scaleType="fitCenter"
            android:transitionName="image" />

        <LinearLayout
            android:id="@+id/viewholder_banner_info_group"
            android:layout_width="match_parent"
            android:layout_height="@dimen/banner_sale_info_height"
            android:layout_alignParentBottom="true"
            android:background="#ffffff"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/viewholder_banner_name"
                fontPath="@string/font_app_bold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center_horizontal|bottom"
                android:maxLines="1"
                android:paddingBottom="10dp"
                android:textAllCaps="true"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_size_caption1"
                android:textStyle="bold"
                tools:text="Atom Pro Compression" />

        </LinearLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/viewholder_banner_info_group"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/margin_extra_small"
            android:layout_marginBottom="@dimen/margin_tiny">

            <TextView
                android:id="@+id/viewholder_banner_percent_off"
                fontPath="@string/font_app_regular"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_alignParentBottom="true"
                android:layout_gravity="right"
                android:layout_marginLeft="@dimen/margin_medium"
                android:background="@drawable/bg_banners_percent_off"
                android:gravity="center"
                android:lineSpacingMultiplier="0.80"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_caption3"
                tools:text="extra\n50%\noff" />

            <ImageView
                android:id="@+id/viewholder_banner_free_delivery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_gravity="bottom"
                android:src="@drawable/ic_free_delivery" />

        </RelativeLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/viewholder_banner_discount"
        fontPath="@string/font_app_regular"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/banner_sale_info_discount_height"
        android:background="@drawable/bg_banner_discount"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/banner_sale_info_discount_bottom_offset"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:paddingLeft="@dimen/margin_extra_small"
        android:paddingRight="@dimen/margin_extra_small"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_caption1"

        tools:text="Up To 50% Off" />

</RelativeLayout>