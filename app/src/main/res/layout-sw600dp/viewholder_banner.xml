<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewholder_banner_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true"
    android:orientation="vertical"
    android:padding="@dimen/margin_tiny"
    tools:ignore="MissingPrefix">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/viewholder_banner_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/viewholder_banner_info_group"
            android:layout_alignParentTop="true"
            android:scaleType="fitCenter"
            android:transitionName="image" />

        <LinearLayout
            android:id="@+id/viewholder_banner_info_group"
            android:layout_width="match_parent"
            android:layout_height="@dimen/banner_sale_info_height"
            android:layout_alignParentBottom="true"
            android:background="#ffffff"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/viewholder_banner_name"
                fontPath="@string/font_app_bold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center_horizontal|bottom"
                android:maxLines="1"
                android:paddingBottom="10dp"
                android:textAllCaps="true"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_size_caption1"
                android:textStyle="bold"
                tools:text="Atom Pro Compression" />

        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/banner_sale_info_discount_bottom_offset"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/viewholder_banner_stickers_container3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

        </LinearLayout>

        <LinearLayout
            android:id="@+id/viewholder_banner_stickers_container2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

        </LinearLayout>

        <LinearLayout
            android:id="@+id/viewholder_banner_stickers_container1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/viewholder_banner_discount"
                fontPath="@string/font_app_regular"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/banner_sale_info_discount_height"
                android:layout_margin="1dp"
                android:background="@drawable/bg_banner_discount"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingLeft="@dimen/margin_extra_small"
                android:paddingRight="@dimen/margin_extra_small"
                android:text="STARTING FROM $2.95"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_caption1" />

            <TextView
                android:id="@+id/viewholder_banner_percent_off"
                fontPath="@string/font_app_regular"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/banner_sale_info_discount_height"
                android:layout_margin="1dp"
                android:background="@drawable/bg_banner_percent_off"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingLeft="@dimen/margin_extra_small"
                android:paddingRight="@dimen/margin_extra_small"
                android:text="EXTRA 20% OFF"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_caption1" />

            <TextView
                android:id="@+id/viewholder_banner_free_delivery"
                fontPath="@string/font_app_regular"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/banner_sale_info_discount_height"
                android:layout_margin="1dp"
                android:background="@drawable/bg_banner_free_delivery"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingLeft="@dimen/margin_extra_small"
                android:paddingRight="@dimen/margin_extra_small"
                android:text="FREE SHIPPING"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_caption1" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>