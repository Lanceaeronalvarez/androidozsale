<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <include layout="@layout/partial_toolbar_arrow" />

    <RelativeLayout
        android:id="@+id/checkout_scrollview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/checkout_scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/controller_checkout_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/partial_checkout_address" />

                <include layout="@layout/partial_checkout_payment" />

                <include layout="@layout/partial_checkout_voucher" />

                <include layout="@layout/partial_checkout_summary" />

                <include layout="@layout/partial_checkout_button" />

                <Button
                    android:id="@+id/controller_checkout_button_pay"
                    style="@style/DDButtonPayCart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_regular"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:text="@string/pay"
                    android:textSize="@dimen/text_size_headline2"
                    android:layout_marginLeft="@dimen/padding_default"
                    android:layout_marginTop="@dimen/padding_default"
                    android:layout_marginRight="@dimen/padding_default"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>
</LinearLayout>
