<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bt_white">

    <LinearLayout style="@style/bt_field_container">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|left"
            android:text="@string/bt_form_hint_card_number"
            android:textColor="@color/bt_gray_active_field_text" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_weight="2"
            android:labelFor="@+id/bt_card_form_card_number"
            app:hintEnabled="false"
            tools:ignore="RtlCompat">

            <com.stripe.android.view.CardNumberEditText
                android:id="@+id/stripe_card_form_card_number"
                style="@style/bt_card_form_field"
                android:contentDescription="@string/bt_form_hint_card_number"
                android:hint="@string/bt_form_hint_card_number"
                android:maxLength="19"
                android:inputType="number" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <View android:background="@color/bt_black_12"
        android:layout_height="1dp"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/bt_margin"/>

    <LinearLayout style="@style/bt_field_container">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|left"
            android:text="@string/bt_form_hint_cvv"
            android:textColor="@color/bt_gray_active_field_text" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/bt_text_input_layout"
            android:labelFor="@+id/bt_card_form_cvv"
            app:hintEnabled="false">

            <com.stripe.android.view.CardNumberEditText
                android:id="@+id/stripe_card_form_cvv"
                style="@style/bt_card_form_field"
                android:contentDescription="@string/bt_form_hint_cvv"
                android:inputType="number"
                android:maxLength="4"
                android:hint="@string/bt_form_hint_cvv" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <View android:background="@color/bt_black_12"
        android:layout_height="1dp"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/bt_margin"/>

    <LinearLayout
        style="@style/bt_field_container"
        tools:ignore="RtlCompat">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|left"
            android:text="@string/bt_form_hint_expiration"
            android:textColor="@color/bt_gray_active_field_text" />


        <com.google.android.material.textfield.TextInputLayout
            style="@style/bt_text_input_layout"
            android:layout_weight="0.15"
            android:labelFor="@+id/bt_card_form_expiration"
            app:hintEnabled="false">

            <au.com.dealsdirect.utils.ExpiryDateEditText
                android:id="@+id/stripe_card_form_expiration"
                style="@style/bt_card_form_field"
                android:contentDescription="@string/bt_form_hint_expiration"
                android:hint="mm/yyyy"
                android:maxLength="5"/>

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <View android:background="@color/bt_black_12"
        android:layout_height="1dp"
        android:layout_width="match_parent" />

</LinearLayout>
