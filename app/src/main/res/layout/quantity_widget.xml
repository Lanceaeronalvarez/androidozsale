<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_quantity_widget">

    <Button
        android:id="@+id/quantity_widget_minus"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="@dimen/quantity_widget_image_height"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:text="@string/minus"
        android:textColor="@color/icon_default"
        android:textSize="@dimen/text_size_headline1" />

    <ProgressBar
        android:id="@+id/quantity_widget_minus_loader"
        android:layout_width="@dimen/quantity_widget_loader_width"
        android:layout_height="@dimen/quantity_widget_loader_height"
        android:layout_gravity="center_vertical"
        android:visibility="gone" />

    <EditText
        android:id="@+id/quantity_widget_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        android:background="@android:color/transparent"
        android:textColor="@color/checkout_quanitity_color"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="2"
        android:maxLines="1"
        android:textSize="@dimen/text_size_title"
        tools:text="0" />

    <ProgressBar
        android:id="@+id/quantity_widget_plus_loader"
        android:layout_width="@dimen/quantity_widget_loader_width"
        android:layout_height="@dimen/quantity_widget_loader_height"
        android:layout_gravity="center_vertical"
        android:visibility="gone" />

    <Button
        android:id="@+id/quantity_widget_plus"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="@dimen/quantity_widget_image_height"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:text="@string/plus"
        android:textColor="@color/icon_default"
        android:textSize="@dimen/text_size_headline1" />
</LinearLayout>
