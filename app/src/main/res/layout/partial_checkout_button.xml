<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/partial_checkout_button_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/padding_default"
            android:paddingTop="@dimen/padding_default"
            android:paddingRight="@dimen/padding_default"
            android:visibility="visible">


            <RelativeLayout
                android:id="@+id/partial_checkout_button_paypal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_paypal_button"
                android:clickable="true"
                android:elevation="1.5dp"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/partial_checkout_button_paypal_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/pay_with"
                        android:textColor="#254181"
                        android:textSize="@dimen/text_size_headline1" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/paypal_logo"
                        tools:ignore="ContentDescription" />

                </LinearLayout>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/partial_checkout_button_g_pay_container"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:paddingLeft="-3dp"
                android:paddingRight="-3dp"
                android:paddingBottom="8dp"
                android:visibility="visible">

                <include
                    android:id="@+id/partial_checkout_button_g_pay"
                    layout="@layout/buy_with_googlepay_button" />
            </RelativeLayout>

            <Button
                android:id="@+id/partial_checkout_button_pay"
                style="@style/DDButtonPayCart"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="@string/pay"
                android:textSize="@dimen/text_size_headline2"
                android:visibility="visible" />

            <RelativeLayout
                android:id="@+id/partial_checkout_button_paypal_credit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:layout_marginBottom="@dimen/margin_small"
                android:background="@drawable/bg_paypal_credit_button"
                android:clickable="true"
                android:elevation="1.5dp"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/margin_small"
                        android:src="@drawable/ic_paypal_credit"
                        tools:ignore="ContentDescription" />

                </LinearLayout>

            </RelativeLayout>

            <Button
                android:id="@+id/button_visa_checkout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/default_button_height"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/margin_small"
                android:background="@drawable/vco_button"
                android:enabled="true" />

            <RelativeLayout
                android:id="@+id/partial_checkout_button_masterpass"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_masterpass_button"
                android:clickable="true"
                android:elevation="1.5dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_logo_masterpass" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_masterpass_button_side"
                    android:src="@drawable/ic_chevron_right" />

            </RelativeLayout>

        </LinearLayout>


        <View
            android:id="@+id/partial_checkout_line_above_afterpay"
            style="@style/horizontalBorderView"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/margin_small" />


        <LinearLayout
            android:id="@+id/partial_checkout_afterpay_panel_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_tiny"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:paddingLeft="@dimen/padding_default"
            android:paddingTop="@dimen/padding_default"
            android:paddingRight="@dimen/padding_default"
            android:visibility="visible">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/margin_small"
                    android:layout_marginRight="@dimen/margin_small"
                    android:layout_toLeftOf="@id/partial_checkout_afterpay_info_button"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/partial_checkout_afterpay_inlinelogo"
                        android:layout_width="@dimen/afterpay_logo_width"
                        android:layout_height="@dimen/afterpay_logo_height"
                        android:layout_gravity="left|center_vertical"
                        android:layout_weight="1"
                        android:scaleType="fitCenter"
                        android:src="@drawable/afterpay" />

                    <TextView
                        android:id="@+id/partial_checkout_afterpay_description"
                        fontPath="@string/font_raleway_regular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left|center_vertical"
                        android:layout_weight="1"
                        android:text="is available between $0.00-$1000.00"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_caption1" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/partial_checkout_afterpay_info_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/margin_small"
                    android:background="@drawable/ourpay_info" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/partial_checkout_button_afterpay"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:background="@drawable/bg_afterpay_button"
                android:clickable="true"
                android:elevation="1.5dp"
                android:padding="6dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/pay_with_afterpay" />
            </RelativeLayout>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/partial_checkout_klarna_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_tiny"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:paddingLeft="@dimen/padding_default"
            android:paddingTop="@dimen/padding_default"
            android:paddingRight="@dimen/padding_default"
            android:visibility="visible">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                android:background="@color/transparent">

                <WebView
                    android:id="@+id/partial_checkout_klarna_description"
                    fontPath="@string/font_raleway_regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|center_vertical"
                    android:layout_marginLeft="@dimen/margin_small"
                    android:layout_marginRight="@dimen/margin_small"
                    android:background="@color/transparent"
                    android:gravity="center"
                    android:textColor="@color/black"

                    tools:ignore="WebViewLayout" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/partial_checkout_button_klarna"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:background="@drawable/bg_klarna_button"
                android:clickable="true"
                android:elevation="1.5dp"
                android:padding="6dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_black_klarna_inapp_sdk" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/partial_checkout_lpay_panel_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_tiny"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:paddingLeft="@dimen/padding_default"
            android:paddingRight="@dimen/padding_default"
            android:visibility="visible">

            <RelativeLayout
                android:id="@+id/partial_checkout_button_lpay"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:background="@drawable/bg_lpay_button"
                android:clickable="true"
                android:elevation="1.5dp"
                android:padding="6dp"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/partial_checkout_button_lpay_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:padding="@dimen/lpay_button_logo_margin"
                    android:scaleType="fitCenter"
                    android:src="@drawable/lpay_logo_white" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/partial_checkout_zippay_panel_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_tiny"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:paddingLeft="@dimen/padding_default"
            android:paddingRight="@dimen/padding_default"
            android:visibility="visible">

            <RelativeLayout
                android:id="@+id/partial_checkout_button_zippay"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:background="@drawable/bg_zippay_button"
                android:clickable="true"
                android:elevation="1.5dp"
                android:padding="6dp"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/partial_checkout_button_zippay_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:padding="@dimen/lpay_button_logo_margin"
                    android:scaleType="fitCenter"
                    android:src="@drawable/zippay_logo_white" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/partial_checkout_ourpay_panel_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical" />


    </LinearLayout>
</RelativeLayout>