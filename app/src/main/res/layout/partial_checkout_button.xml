<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        android:orientation="vertical">


        <LinearLayout
            android:id="@+id/partial_checkout_button_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/padding_default"
            android:paddingTop="@dimen/padding_default"
            android:paddingRight="@dimen/padding_default"
            android:visibility="visible">

            <Button
                android:id="@+id/partial_checkout_button_pay"
                style="@style/DDButtonPayCart"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="@string/pay"
                android:textSize="20sp"
                android:visibility="gone" />

            <RelativeLayout
                android:id="@+id/partial_checkout_button_paypal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_paypal_button"
                android:clickable="true"
                android:elevation="1.5dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/partial_checkout_button_paypal_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/pay_with"
                        android:textColor="#254181"
                        android:textSize="@dimen/text_size_headline1" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/paypal_logo"
                        tools:ignore="ContentDescription" />

                </LinearLayout>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/partial_checkout_button_paypal_credit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:layout_marginBottom="@dimen/margin_small"
                android:background="@drawable/bg_paypal_credit_button"
                android:clickable="true"
                android:elevation="1.5dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/margin_small"
                        android:src="@drawable/ic_paypal_credit"
                        tools:ignore="ContentDescription" />

                </LinearLayout>

            </RelativeLayout>

            <com.visa.checkout.widget.VisaCheckoutButton
                android:id="@+id/button_visa_checkout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/default_button_height"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/margin_small"
                android:enabled="false"
                app:animation="true" />

            <RelativeLayout
                android:id="@+id/partial_checkout_button_masterpass"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_masterpass_button"
                android:clickable="true"
                android:elevation="1.5dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_logo_masterpass" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_masterpass_button_side"
                    android:src="@drawable/ic_chevron_right" />

            </RelativeLayout>

        </LinearLayout>


        <View
            android:id="@+id/partial_checkout_line_above_afterpay"
            style="@style/horizontalBorderView"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/margin_small"/>


        <LinearLayout
            android:id="@+id/partial_checkout_afterpay_panel_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_tiny"
            android:layout_marginBottom="10dp"
            android:paddingLeft="@dimen/padding_default"
            android:paddingTop="@dimen/padding_default"
            android:paddingRight="@dimen/padding_default"
            android:orientation="vertical"
            android:visibility="visible">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/margin_small"
                    android:layout_marginRight="@dimen/margin_small"
                    android:layout_toLeftOf="@id/partial_checkout_afterpay_info_button"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/partial_checkout_afterpay_inlinelogo"
                        android:layout_width="@dimen/afterpay_logo_width"
                        android:layout_height="@dimen/afterpay_logo_height"
                        android:layout_gravity="left|center_vertical"
                        android:layout_weight="1"
                        android:scaleType="fitCenter"
                        android:src="@drawable/afterpay" />

                    <TextView
                        android:id="@+id/partial_checkout_afterpay_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left|center_vertical"
                        android:layout_weight="1"
                        android:fontFamily="@string/font_raleway_regular"
                        android:text="is available between $0.00-$1000.00"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_caption1" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/partial_checkout_afterpay_info_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/margin_small"
                    android:background="@drawable/ourpay_info" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/partial_checkout_button_afterpay"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_afterpay_button"
                android:clickable="true"
                android:elevation="1.5dp"
                android:padding="6dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/pay_with_afterpay" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/partial_checkout_ourpay_panel_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:paddingLeft="@dimen/padding_default"
            android:paddingTop="@dimen/padding_default"
            android:paddingRight="@dimen/padding_default"
            android:orientation="vertical" />


    </LinearLayout>
</RelativeLayout>