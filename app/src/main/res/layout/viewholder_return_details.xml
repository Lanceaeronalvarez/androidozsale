<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewholder_return_detail_row_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    tools:ignore="MissingPrefix">
    

    <!--<View-->
    <!--android:id="@+id/new_returns_order_item_divider"-->
    <!--android:visibility="visible"-->
    <!--android:layout_width="match_parent"-->
    <!--android:layout_height="0.5dp"-->
    <!--android:background="#ededed"/>-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/viewholder_return_detail_image_view"
            android:layout_width="100dp"
            android:layout_height="150dp"
            tools:ignore="ContentDescription" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/viewholder_return_details_information_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    fontPath="@string/font_app_bold"
                    android:id="@+id/viewholder_return_details_item_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray_field_text"
                    android:textSize="@dimen/text_size_normal"
                    tools:ignore="HardcodedText"
                    tools:text="Philosophy Cotton Sleeveless Plain" />


                <RelativeLayout
                    android:id="@+id/my_returns_details_item_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp">


                    <TextView
                        android:id="@+id/viewholder_returns_details_item_count_identifier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Items:"
                        android:textColor="#b7b7b7"
                        android:textSize="@dimen/text_size_normal"
                        tools:ignore="HardcodedText" />


                    <TextView
                        android:id="@+id/viewholder_returns_details_item_count_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/viewholder_returns_details_item_count_identifier"
                        android:layout_marginLeft="4dp"
                        android:layout_toEndOf="@+id/viewholder_returns_details_item_count_identifier"
                        android:layout_toRightOf="@+id/viewholder_returns_details_item_count_identifier"

                        tools:text="1"
                        android:textColor="@color/gray_field_text"
                        android:textSize="@dimen/text_size_normal"
                        tools:ignore="HardcodedText" />

                </RelativeLayout>


                <RelativeLayout
                    android:id="@+id/viewholder_returns_details_size_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/viewholder_returns_details_size_indentifier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Size:"
                        android:textColor="#b7b7b7"
                        android:textSize="@dimen/text_size_normal"
                        tools:ignore="HardcodedText" />


                    <TextView
                        android:id="@+id/viewholder_returns_details_size_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/viewholder_returns_details_size_indentifier"
                        android:layout_marginLeft="4dp"
                        android:layout_toEndOf="@+id/viewholder_returns_details_size_indentifier"
                        android:layout_toRightOf="@+id/viewholder_returns_details_size_indentifier"
                        android:fontFamily="@string/font_app_regular"
                        tools:text="123"
                        android:textColor="@color/gray_field_text"
                        android:textSize="@dimen/text_size_normal"
                        tools:ignore="HardcodedText" />

                </RelativeLayout>


                <RelativeLayout
                    android:id="@+id/viewholder_return_details_price_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/viewholder_return_details_price_identifier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Price:"
                        android:textColor="#b7b7b7"
                        android:textSize="@dimen/text_size_normal"
                        tools:ignore="HardcodedText" />


                    <TextView

                        android:id="@+id/viewholder_returns_order_item_total_cost_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/viewholder_return_details_price_identifier"
                        android:layout_marginLeft="4dp"
                        android:layout_toEndOf="@+id/viewholder_return_details_price_identifier"
                        android:layout_toRightOf="@+id/viewholder_return_details_price_identifier"
                        tools:text="12.00"
                        android:textColor="@color/gray_field_text"
                        android:textSize="@dimen/text_size_normal"
                        tools:ignore="HardcodedText" />

                </RelativeLayout>


                <RelativeLayout
                    android:id="@+id/viewholder_returns_details_subtotal_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/viewholder_returns_details_subtotal_indentifier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subtotal:"
                        android:textColor="#b7b7b7"
                        android:textSize="@dimen/text_size_normal"
                        tools:ignore="HardcodedText" />


                    <TextView
                        android:id="@+id/viewholder_returns_details_subtotal_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/viewholder_returns_details_subtotal_indentifier"
                        android:layout_marginLeft="4dp"
                        android:layout_toEndOf="@+id/viewholder_returns_details_subtotal_indentifier"
                        android:layout_toRightOf="@+id/viewholder_returns_details_subtotal_indentifier"
                        tools:text="123"
                        android:textColor="@color/gray_field_text"
                        android:textSize="@dimen/text_size_normal"
                        tools:ignore="HardcodedText" />

                </RelativeLayout>


                <!--<RelativeLayout-->
                <!--android:id="@+id/new_returns_order_item_tracking_info"-->
                <!--android:layout_width="match_parent"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:layout_marginTop="2dp"-->
                <!--android:layout_below="@+id/new_returns_order_item_status_info">-->

                <!--<com.mysale.genie.views.custom.GenieTextView-->
                <!--app:font="@string/fontname_lato"-->
                <!--android:id="@+id/new_returns_order_item_tracking_identifier"-->
                <!--android:layout_width="wrap_content"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:textColor="#b7b7b7"-->
                <!--tools:text="Tracking:"-->
                <!--android:textSize="@dimen/my_current_return_details_identifier_text_size"-->
                <!--tools:ignore="HardcodedText"/>-->


                <!--<com.mysale.genie.views.custom.GenieTextView-->
                <!--app:font="@string/fontname_lato"-->
                <!--android:id="@+id/new_returns_order_item_tracking_value"-->
                <!--android:layout_width="wrap_content"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:textColor="#acacac"-->
                <!--tools:text=""-->
                <!--android:layout_marginLeft="2dp"-->
                <!--android:textSize="@dimen/my_current_return_details_value_text_size"-->
                <!--android:layout_toRightOf="@+id/new_returns_order_item_tracking_identifier"-->
                <!--android:layout_toEndOf="@+id/new_returns_order_item_tracking_identifier"-->
                <!--android:layout_alignTop="@+id/new_returns_order_item_tracking_identifier"-->
                <!--tools:ignore="HardcodedText"/>-->

                <!--</RelativeLayout>-->


            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>
</LinearLayout>

