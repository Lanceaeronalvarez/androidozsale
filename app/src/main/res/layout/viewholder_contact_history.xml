<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/my_contact_history_recycler_row_item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:gravity="end"
    android:padding="@dimen/activity_horizontal_margin">

    <TextView
        android:id="@+id/my_contact_history_row_message_text_view"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_message_outgoing"
        android:fontFamily="@string/font_lato_medium"
        android:padding="30dp"
        android:textColor="@color/gray_title_text" />

    <au.com.dealsdirect.ui.custom.CircularTextView
        android:id="@+id/my_contact_history_row_message_acronym"
        fontPath="@string/font_lato_heavy"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="120dp"
        android:layout_toEndOf="@id/my_contact_history_row_message_text_view"
        android:textColor="@color/white"
        tools:text="M" />

</RelativeLayout>