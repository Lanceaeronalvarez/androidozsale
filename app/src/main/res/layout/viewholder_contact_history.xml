<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/message_container_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true">

        <LinearLayout
            android:id="@+id/contact_history_item_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="@dimen/margin_extra_small"
            android:background="@drawable/bg_contact_history_message"
            android:orientation="vertical"
            android:padding="@dimen/margin_medium">

            <TextView
                android:id="@+id/contact_history_message_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxEms="15"
                android:textColor="@color/contact_history_text_selector"
                tools:text="hi my order is missing " />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contact_history_recyclerview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_tiny" />

        </LinearLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/contact_history_ticket_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/message_container_frame"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/margin_large"
        android:text="Ticket has been closed"
        android:visibility="gone" />

    <include
        layout="@layout/footer_user_satisfaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/contact_history_ticket_status"
        android:layout_centerHorizontal="true"
        android:visibility="gone" />

</RelativeLayout>