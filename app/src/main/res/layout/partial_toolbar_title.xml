<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/toolbar_skin"
    android:contentInsetEnd="0dp"
    android:contentInsetLeft="0dp"
    android:contentInsetRight="0dp"
    android:contentInsetStart="0dp"
    app:contentInsetEnd="0dp"
    app:contentInsetLeft="0dp"
    app:contentInsetRight="0dp"
    app:contentInsetStart="0dp"
    tools:ignore="MissingPrefix">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/partial_toolbar_field_title_left_option"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_toolbar_button"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pink_chevron" />

        <TextView
            android:id="@+id/partial_toolbar_field_title_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text=""
            android:layout_toStartOf="@+id/partial_toolbar_field_title_right_option"
            android:layout_toEndOf="@+id/partial_toolbar_field_title_left_option"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="@dimen/text_size_headline2"/>

        <au.com.dealsdirect.ui.custom.SearchEditText
            android:id="@+id/partial_toolbar_field_title_edittext"
            fontPath="@string/font_app_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:visibility="gone"
            android:layout_centerInParent="true"
            android:layout_toStartOf="@+id/partial_toolbar_field_title_right_option"
            android:layout_toEndOf="@+id/partial_toolbar_field_title_left_option"
            android:background="@color/transparent"
            android:hint="@string/i_am_looking_for"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_size_headline2"
            android:textColorHint="@color/tab_bar_search_hint"
            android:textCursorDrawable="@drawable/bg_field_cursor"
            tools:text="Title"/>

        <ImageButton
            android:id="@+id/partial_toolbar_field_title_right_option"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_toolbar_button"
            android:padding="10dp"
            android:src="@drawable/ic_toolbar_filter" />

    </RelativeLayout>


</android.support.v7.widget.Toolbar>