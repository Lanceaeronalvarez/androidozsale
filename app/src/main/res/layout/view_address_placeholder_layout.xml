<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/no_addresses_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:paddingLeft="@dimen/placeholder_padding"
    android:paddingRight="@dimen/placeholder_padding"
    android:visibility="visible"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/placeholder_icon_width"
            android:layout_height="@dimen/placeholder_icon_height"
            android:layout_gravity="center"
            android:src="@drawable/ic_address_placeholder" />

        <TextView
            fontPath="@string/font_app_medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/welcome_remark_title_address"
            android:textSize="@dimen/text_size_headline1" />

        <TextView
            fontPath="@string/font_app_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="@dimen/button_height_regular"
            android:paddingBottom="@dimen/button_height_regular"
            android:text="@string/welcome_remark_subtitle_address"
            android:textColor="#9f9f9f"
            android:textSize="@dimen/text_size_headline3" />

    </LinearLayout>


</RelativeLayout>
