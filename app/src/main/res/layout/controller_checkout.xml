<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <include layout="@layout/partial_toolbar_arrow" />

    <include
        layout="@layout/partial_checkout_empty"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/checkout_scrollview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/checkout_scrollview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/controller_checkout_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_extra_small"
                android:layout_marginBottom="@dimen/margin_extra_small"
                android:background="@android:color/transparent"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/controller_checkout_orders_label"
                    fontPath="@string/font_app_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:paddingLeft="@dimen/padding_default"
                    android:paddingTop="@dimen/margin_small"
                    android:paddingRight="@dimen/padding_default"
                    android:text="@string/checkout_order_label"
                    android:textAllCaps="true"
                    android:textColor="@color/text_medium"
                    android:textSize="@dimen/text_size_caption2"
                    android:visibility="invisible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/controller_checkout_recyclerview_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <include layout="@layout/partial_checkout_address" />

                <include layout="@layout/partial_checkout_delivery_options" />

                <include layout="@layout/partial_checkout_payment" />

                <include layout="@layout/partial_checkout_voucher" />

                <include layout="@layout/partial_checkout_summary" />

                <include layout="@layout/partial_checkout_age_restriction" />

                <include layout="@layout/partial_checkout_button" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>
</LinearLayout>
