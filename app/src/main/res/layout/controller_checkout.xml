<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background_color"
    android:orientation="vertical">

    <include layout="@layout/partial_toolbar_title" />

    <include
        layout="@layout/partial_checkout_empty"
        android:visibility="gone" />

    <android.support.v4.widget.NestedScrollView
        android:id="@+id/checkout_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/controller_checkout_orders_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_small"
                android:layout_weight="4"
                android:paddingLeft="@dimen/screen_padding"
                android:paddingRight="@dimen/screen_padding"
                android:paddingTop="@dimen/dimen_small"
                android:textAllCaps="true"
                android:visibility="gone"
                android:text="@string/checkout_order_label"
                android:textColor="@color/gray_title_text" />

            <au.com.dealsdirect.ui.custom.EmbeddableListView
                android:id="@+id/controller_checkout_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/gray_toolbar_border"
                android:dividerHeight="@dimen/border_thin"
                android:visibility="visible" />

        </LinearLayout>

    </android.support.v4.widget.NestedScrollView>
</LinearLayout>