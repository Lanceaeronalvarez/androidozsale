<?xml version="1.0" encoding="utf-8"?><!--<au.com.dealsdirect.widget.ElasticHorizontalDragDismissFrameLayout--><!----><!--android:layout_width="match_parent"--><!--android:layout_height="match_parent"--><!--android:fillViewport="true"--><!--tools:ignore="MissingPrefix">-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    android:fillViewport="true"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:id="@+id/controller_details_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/padding_default">

                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/first_name"
                    android:textColor="@color/text_extra_dark" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/controller_details_firstname_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/padding_default"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/controller_details_text_firstname"
                        style="@style/DDEditTextStyle"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/first_name"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:textSize="@dimen/text_size_headline3" />

                </com.google.android.material.textfield.TextInputLayout>


                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/last_name"
                    android:textColor="@color/text_extra_dark" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/controller_details_lastname_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/padding_default"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/controller_details_text_lastname"
                        style="@style/DDEditTextStyle"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/last_name"
                        android:inputType="textPersonName"
                        android:textSize="@dimen/text_size_headline3" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/date_of_birth"
                    android:textColor="@color/text_extra_dark" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/controller_details_birthday_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/padding_default"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/controller_details_text_birthday"
                        style="@style/DDEditTextStyle"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:inputType="date"
                        android:textSize="@dimen/text_size_headline3" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gender"
                    android:textColor="@color/text_extra_dark" />


                <RelativeLayout
                    style="@style/DDSpinnerTextStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/padding_default"
                    android:gravity="center_vertical">

                    <Spinner
                        android:id="@+id/controller_details_spinner_gender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#00000000"
                        android:entries="@array/genders" />

                </RelativeLayout>


                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/email_address"
                    android:textColor="@color/text_extra_dark" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailAddressWrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/padding_default"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/controller_details_text_emailaddress"
                        style="@style/DDEditTextStyle"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/email_address"
                        android:inputType="textEmailAddress"
                        android:textSize="@dimen/text_size_headline3" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/password"
                    android:textColor="@color/text_extra_dark" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordWrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/padding_default"
                    app:hintEnabled="false"
                    app:passwordToggleDrawable="@drawable/ic_show_password_toggle"
                    app:passwordToggleEnabled="true">

                    <EditText
                        android:id="@+id/controller_details_text_password"
                        style="@style/DDEditTextStyle"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/password"
                        android:inputType="textPassword"
                        android:textSize="@dimen/text_size_headline3" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/new_password"
                    android:textColor="@color/text_extra_dark" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/newPasswordWrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/padding_default"
                    app:hintEnabled="false"
                    app:passwordToggleDrawable="@drawable/ic_show_password_toggle"

                    app:passwordToggleEnabled="true">

                    <EditText
                        android:id="@+id/controller_details_text_new_password"
                        style="@style/DDEditTextStyle"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/new_password"
                        android:inputType="textPassword"
                        android:textSize="@dimen/text_size_headline3" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_password"
                    android:textColor="@color/text_extra_dark" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/controller_details_confirm_password_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/padding_default"
                    app:hintEnabled="false"
                    app:passwordToggleDrawable="@drawable/ic_show_password_toggle"
                    app:passwordToggleEnabled="true">

                    <EditText
                        android:id="@+id/controller_details_text_confirm_password"
                        style="@style/DDEditTextStyle"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/confirm_password"
                        android:inputType="textPassword"
                        android:textSize="@dimen/text_size_headline3" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mobile_number"
                    android:textColor="@color/text_extra_dark" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/controller_details_mobile_number_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:orientation="horizontal"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/controller_details_text_mobile_number"
                        style="@style/DDEditTextStyle"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/mobile_number"
                        android:inputType="phone"
                        android:textSize="@dimen/text_size_headline3" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/controller_details_sms_opt_in_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@drawable/custom_preferences_checkbox_selector"
                        android:checked="false"
                        android:visibility="visible" />

                    <TextView
                        fontPath="@string/font_app_semibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sms_marketing_opt_in"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_caption1" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <RelativeLayout
            android:id="@+id/controller_details_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_default">

            <TextView
                android:id="@+id/controller_details_promo_emails_header"
                fontPath="@string/font_app_semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:text="Please choose how many emails or unsubscribe below"
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_caption1" />

            <RadioGroup
                android:id="@+id/controller_details_promo_emails_radio_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/controller_details_promo_emails_header"
                android:layout_alignParentLeft="true">

                <include layout="@layout/controller_user_details_radio_button" />
            </RadioGroup>
        </RelativeLayout>

        <TextView
            android:id="@+id/controller_details_marketing_preferences_header"
            fontPath="@string/font_app_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/marginBottom_10"
            android:layout_marginLeft="@dimen/padding_default"
            android:layout_marginBottom="@dimen/marginBottom_10"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:text="Marketing Preferences:"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_caption1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/padding_default">

            <CheckBox
                android:id="@+id/controller_details_marketing_preferences_email_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/blue"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/marginBottom_10"
                android:text="@string/subscribe_to_email"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_caption1" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/padding_default">

            <CheckBox
                android:id="@+id/controller_details_marketing_preferences_sms_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/blue"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/marginBottom_10"
                android:text="@string/subscribe_to_sms"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_caption1" />

        </LinearLayout>

        <TextView
            android:id="@+id/controller_details_opt_in_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:text="@string/opt_in_message"
            android:textSize="@dimen/text_size_caption1"/>

        <Button
            android:id="@+id/controller_details_button"
            style="@style/DDButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/padding_default"
            android:text="@string/save_changes"
            android:visibility="gone" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout><!--</au.com.dealsdirect.widget.ElasticHorizontalDragDismissFrameLayout>-->
