<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              android:id="@+id/no_payment_method_placeholder"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:gravity="center"
              android:orientation="vertical"
              android:paddingLeft="@dimen/placeholder_padding"
              android:paddingRight="@dimen/placeholder_padding"
              tools:ignore="MissingPrefix">

    <ImageView
        android:layout_width="@dimen/placeholder_icon_width"
        android:layout_height="@dimen/placeholder_icon_height"
        android:layout_gravity="center"
        android:src="@drawable/ic_payments" />

    <TextView
        fontPath="@string/font_app_medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="welcome to my payments!"
        android:textSize="@dimen/text_size_headline1" />

    <TextView
        fontPath="@string/font_app_light"
        android:textColor="#9f9f9f"
        android:textSize="@dimen/text_size_headline3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="@dimen/button_height_regular"
        android:paddingBottom="@dimen/button_height_regular"
        android:text="you do not currently have any payment method." />

</LinearLayout>
