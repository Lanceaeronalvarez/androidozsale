<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_gravity="center"
            android:layout_width="@dimen/category_background_size"
            android:layout_height="@dimen/category_background_size">

            <ImageView
                android:id="@+id/row_category_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_category_item_inactive"/>

            <TextView
                fontPath="@string/font_lato_light"
                android:id="@+id/row_category_indicator"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="A"
                android:textSize="50sp"
                android:gravity="center"
                android:textColor="@color/gray_title_text" />
        </RelativeLayout>


        <TextView
            android:layout_below="@+id/row_category_image"
            android:id="@+id/row_category_name"
            fontPath="@string/font_lato_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:textColor="@color/gray_field_text"
            android:textSize="@dimen/text_size_large"
            tools:text="Mens"
            android:layout_marginTop="5dp"/>

    </LinearLayout>
