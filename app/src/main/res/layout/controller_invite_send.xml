<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/controller_send_invite_root"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/default_background_color"
    android:overScrollMode="never"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/partial_toolbar_arrow"
            android:visibility="gone"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    fontPath="@string/font_app_bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/invite_friends_title"
                    android:textColor="@color/gray_item_details"
                    android:textSize="@dimen/text_size_xxxlarge" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_above="@+id/controller_invite_friend_button_send_invite"
                    android:layout_below="@id/controller_invite_title_toolbar"
                    android:layout_centerInParent="true"
                    android:layout_marginTop="@dimen/dimen_small"
                    android:gravity="center_vertical|center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/controller_invite_vouchers_imageview"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/invite_friends_vouchers_image_height"
                        android:layout_marginBottom="@dimen/dimen_small"
                        android:layout_marginLeft="@dimen/activity_horizontal_margin"
                        android:layout_marginRight="@dimen/activity_horizontal_margin"
                        android:layout_marginTop="@dimen/dimen_extra_small"
                        android:focusable="true" />

                    <TextView
                        fontPath="@string/font_app_regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/screen_padding"
                        android:gravity="center"
                        android:lineSpacingExtra="@dimen/dimen_extra_small"
                        android:text="@string/invite_friend_guide"
                        android:textAlignment="center"
                        android:textSize="@dimen/text_size_medium" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/screen_padding"
                        android:layout_marginRight="@dimen/screen_padding"
                        android:orientation="horizontal">

                        <RelativeLayout
                            android:id="@+id/controller_invite_follow_us_layout"
                            style="@style/DDEditTextStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/dimen_extra_small"
                            android:layout_weight="1"
                            android:background="@drawable/bg_invite_twitter"
                            android:clickable="true"
                            android:padding="@dimen/dimen_medium">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:orientation="horizontal"
                                android:weightSum="1"
                                tools:ignore="UselessParent">

                                <ImageView
                                    android:layout_width="@dimen/invite_friends_image_width"
                                    android:layout_height="@dimen/invite_friends_image_height"
                                    android:scaleType="fitXY"
                                    android:src="@drawable/ic_twitter"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    fontPath="@string/font_app_medium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/invite_friends_padding"
                                    android:gravity="center"
                                    android:paddingLeft="@dimen/invite_friends_padding"
                                    android:paddingRight="@dimen/invite_friends_padding"
                                    android:text="@string/follow_us"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_large" />

                            </LinearLayout>
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/controller_invite_like_us_layout"
                            style="@style/DDEditTextStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dimen_extra_small"
                            android:layout_weight="1"
                            android:background="@drawable/bg_invite_facebook"
                            android:clickable="true"
                            android:padding="@dimen/dimen_medium">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:orientation="horizontal"
                                tools:ignore="UselessParent">

                                <ImageView
                                    android:layout_width="@dimen/invite_friends_image_width"
                                    android:layout_height="@dimen/invite_friends_image_height"
                                    android:scaleType="fitXY"
                                    android:src="@drawable/ic_fb"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    fontPath="@string/font_app_medium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:paddingLeft="@dimen/invite_friends_padding"
                                    android:paddingRight="@dimen/invite_friends_padding"
                                    android:singleLine="true"
                                    android:text="Like us"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_large" />

                            </LinearLayout>
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:focusableInTouchMode="true"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/screen_padding"
                    android:paddingRight="@dimen/screen_padding"
                    android:paddingTop="@dimen/screen_padding">

                    <TextView
                        fontPath="@string/font_app_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dimen_small"
                        android:text="@string/send_personal_invite_text"
                        android:textColor="@color/gray_active_field_text"
                        android:textIsSelectable="false" />


                    <EditText
                        android:id="@+id/controller_invite_personal_invitation_link_edittext"
                        style="@style/DDEditTextStyle"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|left"
                        android:hint="@string/write_a_message_here"
                        android:inputType="textMultiLine"
                        android:maxLines="4"
                        android:minLines="4"
                        android:textColor="@color/gray_active_field_text"
                        android:textSize="@dimen/text_size_xlarge" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding">

                    <TextView
                        fontPath="@string/font_app_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dimen_small"
                        android:text="Invitation link"
                        android:textColor="@color/gray_active_field_text"/>


                    <RelativeLayout
                        android:id="@+id/controller_invite_invitation_link_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_edit_text_rounded"
                        android:descendantFocusability="beforeDescendants"
                        android:focusable="false"
                        android:focusableInTouchMode="true">

                        <EditText
                            android:id="@+id/controller_invite_invitation_link_edittext"
                            fontPath="@string/font_app_medium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_edit_text_rounded"
                            android:gravity="top|left"
                            android:inputType="textMultiLine"
                            android:maxLines="2"
                            android:minLines="2"
                            android:paddingBottom="@dimen/dimen_medium"
                            android:paddingLeft="@dimen/dimen_medium"
                            android:paddingTop="@dimen/dimen_medium"
                            android:singleLine="true"
                            android:textColor="@color/gray_inactive_field_text"
                            android:textColorHint="@color/gray_inactive_field_text"
                            android:textSize="@dimen/text_size_xlarge"/>
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/controller_invite_buttons_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/screen_padding"
                        android:layout_marginLeft="@dimen/screen_padding"
                        android:layout_marginRight="@dimen/screen_padding"
                        android:layout_marginTop="@dimen/dimen_small"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <RelativeLayout
                            android:id="@+id/controller_invite_clipboard_button"
                            style="@style/DDEditTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_extra_small"
                            android:layout_weight="1"
                            android:background="@drawable/bg_invite_clipboard"
                            android:clickable="true"
                            android:padding="@dimen/dimen_medium">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:orientation="horizontal"
                                android:weightSum="1"
                                tools:ignore="UselessParent">

                                <ImageView
                                    android:layout_width="@dimen/invite_friends_image_width"
                                    android:layout_height="@dimen/invite_friends_image_height"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_weight="0.50"
                                    android:src="@drawable/ic_clipboard"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    android:id="@+id/controller_invite_clipboard_text"
                                    fontPath="@string/font_app_medium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/invite_friends_padding"
                                    android:paddingLeft="@dimen/invite_friends_padding"
                                    android:paddingRight="@dimen/invite_friends_padding"
                                    android:text="Copy link to clipboard"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_large" />

                            </LinearLayout>
                        </RelativeLayout>

                        <TextView
                            fontPath="@string/font_app_medium"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="@dimen/invite_friends_padding"
                            android:layout_marginTop="@dimen/dimen_extra_small"
                            android:gravity="center"
                            android:paddingLeft="@dimen/invite_friends_padding"
                            android:paddingRight="@dimen/invite_friends_padding"
                            android:text="or"
                            android:textColor="@color/gray_active_field_text"
                            android:textSize="@dimen/text_size_large" />

                        <RelativeLayout
                            android:id="@+id/controller_invite_facebook_button"
                            style="@style/DDEditTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_small"
                            android:layout_weight="1"
                            android:background="@drawable/bg_invite_facebook"
                            android:clickable="true"
                            android:padding="@dimen/dimen_medium">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="1"
                                tools:ignore="UselessParent">

                                <ImageView
                                    android:layout_width="@dimen/invite_friends_image_width"
                                    android:layout_height="@dimen/dimen_large"
                                    android:layout_gravity="center_vertical"
                                    android:layout_weight="0.5"
                                    android:scaleType="fitEnd"
                                    android:src="@drawable/ic_fb"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    fontPath="@string/font_app_medium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/invite_friends_padding"
                                    android:layout_weight="0.5"
                                    android:paddingLeft="@dimen/invite_friends_padding"
                                    android:paddingRight="@dimen/invite_friends_padding"
                                    android:text="Invite your friends on Facebook"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_large" />

                            </LinearLayout>
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/controller_invite_twitter_button"
                            style="@style/DDEditTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_small"
                            android:layout_weight="1"
                            android:background="@drawable/bg_invite_twitter"
                            android:clickable="true"
                            android:padding="@dimen/dimen_medium">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="1"
                                tools:ignore="UselessParent">

                                <ImageView
                                    android:layout_width="@dimen/invite_friends_image_width"
                                    android:layout_height="@dimen/dimen_large"
                                    android:layout_gravity="center_vertical"
                                    android:layout_weight="0.5"
                                    android:scaleType="fitEnd"
                                    android:src="@drawable/ic_twitter"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    fontPath="@string/font_app_medium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/invite_friends_padding"
                                    android:layout_weight="0.5"
                                    android:paddingLeft="@dimen/invite_friends_padding"
                                    android:paddingRight="@dimen/invite_friends_padding"
                                    android:text="Invite your friends on Twitter"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_large" />

                            </LinearLayout>
                        </RelativeLayout>


                        <RelativeLayout
                            android:id="@+id/controller_invite_email_button"
                            style="@style/DDEditTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_small"
                            android:layout_weight="1"
                            android:background="@drawable/bg_invite_mail"
                            android:clickable="true"
                            android:padding="@dimen/dimen_medium">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="1"
                                tools:ignore="UselessParent">

                                <ImageView
                                    android:layout_width="@dimen/invite_friends_image_width"
                                    android:layout_height="@dimen/invite_friends_image_height"
                                    android:layout_gravity="center_vertical"
                                    android:layout_weight="0.5"
                                    android:scaleType="fitEnd"
                                    android:src="@drawable/ic_email"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    fontPath="@string/font_app_medium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/invite_friends_padding"
                                    android:paddingLeft="@dimen/invite_friends_padding"
                                    android:paddingRight="@dimen/invite_friends_padding"
                                    android:text="Invite your friends on Email"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_large" />

                            </LinearLayout>
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/controller_invite_sms_button"
                            style="@style/DDEditTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_small"
                            android:layout_weight="1"
                            android:background="@drawable/bg_invite_sms"
                            android:clickable="true"
                            android:padding="@dimen/dimen_medium">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="1"
                                tools:ignore="UselessParent">

                                <ImageView
                                    android:layout_width="@dimen/invite_friends_image_width"
                                    android:layout_height="@dimen/invite_friends_image_width"
                                    android:layout_gravity="center_vertical"
                                    android:layout_weight="0.5"
                                    android:scaleType="fitEnd"
                                    android:src="@drawable/ic_message"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    fontPath="@string/font_app_medium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="@dimen/invite_friends_padding"
                                    android:gravity="center_vertical"
                                    android:paddingLeft="@dimen/invite_friends_padding"
                                    android:paddingRight="@dimen/invite_friends_padding"
                                    android:text="Invite your friends on SMS"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_large" />

                            </LinearLayout>

                        </RelativeLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</android.support.v4.widget.NestedScrollView>
