<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android">


    <include layout="@layout/partial_toolbar_arrow" />

    <android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#FFFFFF"
    android:overScrollMode="never"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/controller_send_invite_text_personal_invite_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/controller_invite_layout_title"
                    android:layout_centerInParent="true"
                    android:layout_above="@+id/controller_invite_friend_button_send_invite"
                    android:gravity="center_vertical|center_horizontal"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/controller_invite_image_vouchers"
                        android:layout_width="wrap_content"
                        android:layout_height="250dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginLeft="@dimen/activity_horizontal_margin"
                        android:layout_marginRight="@dimen/activity_horizontal_margin"
                        android:focusable="true" />

                    <TextView
                        fontPath="@string/font_lato_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/invite_friend_guide"
                        android:layout_marginBottom="10dp"
                        android:layout_marginLeft="@dimen/activity_horizontal_margin"
                        android:layout_marginRight="@dimen/activity_horizontal_margin"
                        android:textSize="@dimen/text_size_large" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/screen_padding"
                        android:layout_marginRight="@dimen/screen_padding"
                        android:orientation="horizontal">

                        <RelativeLayout
                            android:id="@+id/invite_friend_twitter_follow_us_button_layout"
                            style="@style/DDEditTextStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_invite_twitter"
                            android:layout_marginRight="5dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:padding="15dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:orientation="horizontal"
                                android:weightSum="1"
                                tools:ignore="UselessParent">

                                <ImageView
                                    android:id="@+id/twitter_icon_image_view"
                                    android:layout_width="@dimen/invite_friends_image_width"
                                    android:layout_height="@dimen/invite_friends_image_width"
                                    android:layout_weight="0.50"
                                    android:src="@drawable/ic_twitter"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    fontPath="@string/font_lato_medium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="@dimen/invite_friends_padding"
                                    android:gravity="center"
                                    android:paddingLeft="@dimen/invite_friends_padding"
                                    android:paddingRight="@dimen/invite_friends_padding"
                                    android:text="Follow us"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_large" />

                            </LinearLayout>
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/invite_friend_facebook_like_us_on_facebook_button_layout"
                            style="@style/DDEditTextStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_invite_facebook"
                            android:clickable="true"
                            android:padding="15dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:orientation="horizontal"
                                tools:ignore="UselessParent">

                                <ImageView
                                    android:id="@+id/facebook_icon_image_view"
                                    android:layout_width="@dimen/invite_friends_image_width"
                                    android:layout_height="@dimen/invite_friends_image_width"
                                    android:src="@drawable/ic_fb"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    fontPath="@string/font_lato_medium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:paddingLeft="@dimen/invite_friends_padding"
                                    android:paddingRight="@dimen/invite_friends_padding"
                                    android:singleLine="true"
                                    android:text="Like us"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_large" />

                            </LinearLayout>
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingTop="@dimen/screen_padding"
                    android:paddingLeft="@dimen/screen_padding"
                    android:paddingRight="@dimen/screen_padding"
                    android:orientation="vertical">

                    <TextView
                        fontPath="@string/font_lato_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/send_personal_invite_text"
                        android:textIsSelectable="false"
                        android:textColor="@color/gray_title_text"/>


                    <EditText
                        android:id="@+id/controller_send_invite_edit_text_personal_invitation"
                        style="@style/DDEditTextStyle"
                        fontPath="@string/font_lato_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gray_title_text"
                        android:hint="@string/write_a_message_here"
                        android:gravity="top|left"
                        android:minLines="4"
                        android:maxLines="4"
                        android:inputType="textMultiLine"
                        android:textSize="@dimen/text_size_xlarge" />


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/controller_send_invite_container_invitation_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/screen_padding"
                    android:orientation="vertical">

                    <TextView
                        fontPath="@string/font_lato_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:textColor="@color/gray_title_text"
                        android:text="Invitation link" />


                    <RelativeLayout
                        android:id="@+id/controller_send_invite_layout_select_order_option"
                        android:focusable="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:descendantFocusability="beforeDescendants"
                        android:focusableInTouchMode="true"
                        android:background="@drawable/bg_edit_text_rounded">

                        <EditText
                            android:id="@+id/controller_send_invite_edit_text_deals_direct_link"
                            fontPath="@string/font_lato_medium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_edit_text_rounded"
                            android:gravity="top|left"
                            android:minLines="2"
                            android:maxLines="2"
                            android:inputType="textMultiLine"
                            android:paddingBottom="15dp"
                            android:paddingLeft="15dp"
                            android:paddingRight="43dp"
                            android:paddingTop="15dp"
                            android:singleLine="true"
                            android:textColor="@color/gray_title_text"
                            android:textColorHint="@color/gray_title_text"
                            android:textSize="@dimen/text_size_xlarge" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/controller_send_invite_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="@dimen/screen_padding"
                        android:layout_marginRight="@dimen/screen_padding"
                        android:layout_marginLeft="@dimen/screen_padding"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <RelativeLayout
                            android:id="@+id/invite_friend_clipboard_button"
                            style="@style/DDEditTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_invite_clipboard"
                            android:layout_marginTop="5dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:padding="15dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:orientation="horizontal"
                                android:weightSum="1"
                                tools:ignore="UselessParent">

                                <ImageView
                                    android:id="@+id/invite_friend_clipboard_image"
                                    android:layout_width="@dimen/invite_friends_image_width"
                                    android:layout_height="@dimen/invite_friends_image_width"
                                    android:layout_weight="0.50"
                                    android:src="@drawable/ic_clipboard"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    fontPath="@string/font_lato_medium"
                                    android:id="@+id/invite_friend_clipboard_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="@dimen/invite_friends_padding"
                                    android:paddingLeft="@dimen/invite_friends_padding"
                                    android:paddingRight="@dimen/invite_friends_padding"
                                    android:text="Copy link to clipboard"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_large" />

                            </LinearLayout>
                        </RelativeLayout>

                        <TextView
                            fontPath="@string/font_lato_medium"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="@dimen/invite_friends_padding"
                            android:gravity="center"
                            android:layout_marginTop="5dp"
                            android:paddingLeft="@dimen/invite_friends_padding"
                            android:paddingRight="@dimen/invite_friends_padding"
                            android:text="or"
                            android:textColor="@color/gray_title_text"
                            android:textSize="@dimen/text_size_large" />

                        <RelativeLayout
                            android:id="@+id/invite_friend_facebook_button"
                            style="@style/DDEditTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_invite_facebook"
                            android:layout_marginTop="10dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:padding="15dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingLeft="38dp"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/invite_friends_image_width"
                                    android:layout_height="@dimen/invite_friends_image_width"
                                    android:layout_weight="0.50"
                                    android:src="@drawable/ic_fb"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    fontPath="@string/font_lato_medium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="@dimen/invite_friends_padding"
                                    android:layout_weight="1"
                                    android:paddingLeft="@dimen/invite_friends_padding"
                                    android:paddingRight="@dimen/invite_friends_padding"
                                    android:text="Invite your friends on Facebook"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_large" />

                            </LinearLayout>
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/invite_friend_twitter_button"
                            style="@style/DDEditTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_invite_twitter"
                            android:layout_marginTop="10dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:padding="15dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingLeft="38dp"
                                android:weightSum="1"
                                tools:ignore="UselessParent">

                                <ImageView
                                    android:layout_width="@dimen/invite_friends_image_width"
                                    android:layout_height="@dimen/invite_friends_image_width"
                                    android:layout_weight="0.50"
                                    android:src="@drawable/ic_twitter"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    fontPath="@string/font_lato_medium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="@dimen/invite_friends_padding"
                                    android:paddingLeft="@dimen/invite_friends_padding"
                                    android:paddingRight="@dimen/invite_friends_padding"
                                    android:text="Invite your friends on Twitter"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_large" />

                            </LinearLayout>
                        </RelativeLayout>


                        <RelativeLayout
                            android:id="@+id/invite_friends_email_button"
                            style="@style/DDEditTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_invite_mail"
                            android:layout_marginTop="10dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:padding="15dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingLeft="38dp"
                                android:weightSum="1"
                                tools:ignore="UselessParent">

                                <ImageView
                                    android:layout_width="@dimen/invite_friends_image_width"
                                    android:layout_height="@dimen/invite_friends_image_width"
                                    android:layout_weight="0.50"
                                    android:src="@drawable/ic_email"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    fontPath="@string/font_lato_medium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="@dimen/invite_friends_padding"
                                    android:paddingLeft="@dimen/invite_friends_padding"
                                    android:paddingRight="@dimen/invite_friends_padding"
                                    android:text="Invite your friends on Email"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_large" />

                            </LinearLayout>
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/invite_friends_sms_button"
                            style="@style/DDEditTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_invite_sms"
                            android:layout_marginTop="10dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:padding="15dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingLeft="38dp"
                                android:weightSum="1"
                                tools:ignore="UselessParent">

                                <ImageView
                                    android:layout_width="@dimen/invite_friends_image_width"
                                    android:layout_height="@dimen/invite_friends_image_width"
                                    android:layout_weight="0.50"
                                    android:src="@drawable/ic_message"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    fontPath="@string/font_lato_medium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="@dimen/invite_friends_padding"
                                    android:paddingLeft="@dimen/invite_friends_padding"
                                    android:paddingRight="@dimen/invite_friends_padding"
                                    android:text="Invite your friends on SMS"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_large" />

                            </LinearLayout>
                        </RelativeLayout>

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</android.support.v4.widget.NestedScrollView>
</LinearLayout>