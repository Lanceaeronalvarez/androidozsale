<?xml version="1.0" encoding="utf-8"?>


<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.bluelinelabs.conductor.ChangeHandlerFrameLayout
            android:id="@+id/controller_home_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/controller_home_bottom_nav"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

        <com.bluelinelabs.conductor.ChangeHandlerFrameLayout
            android:id="@+id/controller_accounts_frame"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/controller_home_bottom_nav"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

        <com.bluelinelabs.conductor.ChangeHandlerFrameLayout
            android:id="@+id/controller_ourpay_frame"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/controller_home_bottom_nav"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

        <com.bluelinelabs.conductor.ChangeHandlerFrameLayout
            android:id="@+id/controller_paymentschedule_frame"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/controller_home_bottom_nav"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

        <com.bluelinelabs.conductor.ChangeHandlerFrameLayout
            android:id="@+id/controller_checkout_frame"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/controller_home_bottom_nav"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

        <com.aurelhubert.ahbottomnavigation.AHBottomNavigation
            android:id="@+id/controller_home_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentBottom="true" />

        <ImageView
            android:id="@+id/product_details_add_to_cart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_gravity="center"
            android:visibility="gone" />

    </RelativeLayout>

</RelativeLayout>
