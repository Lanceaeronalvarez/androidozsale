<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingBottom="5dp"
    android:paddingTop="5dp">

    <au.com.dealsdirect.ui.custom.toggleswitch.OurPayToggleSwitch
        android:id="@+id/ourpay_toggle_switch_tc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_caption1"
        app:textToggleLeft="Yes"
        app:textToggleRight="No" />

    <TextView
        android:id="@+id/ourpay_text_tc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_small"
        android:textSize="@dimen/text_size_caption1"
        android:text="I agree to Ourpay's terms and conditions" />

</LinearLayout>