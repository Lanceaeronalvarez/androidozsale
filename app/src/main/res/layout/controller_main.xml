<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <au.com.dealsdirect.ui.controller.main.MainCustomViewPager
        android:id="@+id/home_viewpager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/controller_home_bottom_nav_layout"
        android:layout_alignParentStart="true" />

    <RelativeLayout
        android:id="@+id/controller_main_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/beige"
        android:layout_above="@+id/controller_nav_indicator"/>

    <LinearLayout
        android:id="@+id/controller_nav_indicator"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_above="@+id/controller_home_bottom_nav_layout"
        android:background="@color/white"
        android:visibility="visible">

        <View
            android:id="@+id/indicator_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/nav_dark_blue"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:visibility="invisible"/>

        <View
            android:id="@+id/indicator_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/nav_dark_blue"
            android:layout_weight="1"
            android:visibility="invisible"/>

        <View
            android:id="@+id/indicator_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/nav_dark_blue"
            android:layout_weight="1"/>

        <View
            android:id="@+id/indicator_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/nav_dark_blue"
            android:layout_weight="1"
            android:visibility="invisible"/>

        <View
            android:id="@+id/indicator_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/nav_dark_blue"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:visibility="invisible"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/controller_home_bottom_nav_layout"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true">

        <com.aurelhubert.ahbottomnavigation.AHBottomNavigation
            android:id="@+id/controller_home_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_nav_height"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:background="@color/white"/>

        <ImageView
            android:id="@+id/controller_home_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:elevation="8dp"
            android:outlineSpotShadowColor="@color/white"
            android:outlineAmbientShadowColor="@color/white"
            android:background="@color/white"
            android:src="@drawable/ic_center_nav_bar"
            android:layout_marginBottom="2dp"/>

    </FrameLayout>

    <com.bluelinelabs.conductor.ChangeHandlerFrameLayout
        android:id="@+id/popup_host_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</RelativeLayout>
