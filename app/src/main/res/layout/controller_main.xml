<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <au.com.dealsdirect.ui.controller.main.MainCustomViewPager
        android:id="@+id/home_viewpager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/controller_home_bottom_nav"
        android:layout_alignParentStart="true" />

    <com.aurelhubert.ahbottomnavigation.AHBottomNavigation
        android:id="@+id/controller_home_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:background="@color/bg_tab_bar" />

    <com.bluelinelabs.conductor.ChangeHandlerFrameLayout
        android:id="@+id/popup_host_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</RelativeLayout>
