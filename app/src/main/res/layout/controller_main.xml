<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <au.com.dealsdirect.ui.controller.main.MainCustomViewPager
        android:id="@+id/home_viewpager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/controller_main_line"
        android:layout_alignParentStart="true"/>

    <View
        android:id="@+id/controller_main_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/controller_nav_container"
        android:background="@color/beige" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controller_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:paddingLeft="@dimen/margin_extra_small"
        android:paddingRight="@dimen/margin_extra_small">

        <RelativeLayout
            android:id="@+id/controller_nav_indicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/controller_home_bottom_nav_layout"
            app:layout_constraintLeft_toLeftOf="@+id/controller_home_bottom_nav_layout"
            app:layout_constraintRight_toRightOf="@+id/controller_home_bottom_nav_layout"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:visibility="visible">

                <View
                    android:id="@+id/indicator_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/nav_dark_blue"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/indicator_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/nav_dark_blue"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/indicator_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/nav_dark_blue" />

                <View
                    android:id="@+id/indicator_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/nav_dark_blue"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/indicator_5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/nav_dark_blue"
                    android:visibility="invisible" />

            </LinearLayout>

            <View
                android:id="@+id/indicator_slidng"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@color/nav_dark_blue"
                android:visibility="invisible" />

        </RelativeLayout>

        <FrameLayout
            android:id="@+id/controller_home_bottom_nav_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/controller_home_bottom_guideline"
            app:layout_constraintRight_toRightOf="@id/controller_home_bottom_guideline">

            <com.aurelhubert.ahbottomnavigation.AHBottomNavigation
                android:id="@+id/controller_home_bottom_nav"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/bottom_nav_height" />

            <ImageView
                android:id="@+id/controller_home_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginBottom="2dp"
                android:background="@color/white"
                android:elevation="8dp"
                android:outlineAmbientShadowColor="@color/white"
                android:outlineSpotShadowColor="@color/white"
                android:src="@drawable/ic_center_nav_bar"
                android:visibility="gone"/>

        </FrameLayout>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/controller_home_bottom_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.bluelinelabs.conductor.ChangeHandlerFrameLayout
        android:id="@+id/popup_host_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</RelativeLayout>
