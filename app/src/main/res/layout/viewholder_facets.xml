<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/row_facets_image_container"
            android:layout_width="@dimen/category_background_size"
            android:layout_height="@dimen/category_background_size"
            android:background="@drawable/bg_facet_selector">

            <ImageView
                android:id="@+id/row_facets_image"
                android:layout_width="@dimen/category_image_size"
                android:layout_height="@dimen/category_image_size"
                android:layout_centerInParent="true"/>

        </RelativeLayout>


        <TextView
            android:id="@+id/row_indicator_active_text"
            fontPath="@string/font_app_medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorAccent"
            android:layout_gravity="right"
            android:layout_marginTop="-10dp"
            android:textSize="@dimen/text_size_xxxlarge"
            android:visibility="visible"
            android:text="•"/>

        <TextView
            android:id="@+id/row_facets_name"
            fontPath="@string/font_app_regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="-10dp"
            android:gravity="center"
            android:textColor="@color/gray_field_text"
            android:textSize="@dimen/text_size_medium"
            tools:text="Category"/>


    </LinearLayout>

</RelativeLayout>
