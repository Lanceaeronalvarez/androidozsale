<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true"
    android:orientation="vertical">

    <include
        android:id="@+id/view_contacts_toolbar_layout"
        layout="@layout/partial_toolbar_arrow" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/confirm_your_phone_number"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/an_sms_with_your_code_has_been_sent_to_this_number"
            android:textColor="@color/ourpay_gray"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ProgressBar
                android:id="@+id/ourpay_progress_extension"
                android:layout_width="50dp"
                android:layout_height="43dp"
                android:layout_marginTop="15dp"
                android:background="#FFE7E7E7"
                android:padding="10dp"/>

            <EditText
                android:id="@+id/ourpay_edittext_extension"
                android:layout_width="50dp"
                android:layout_height="43dp"
                android:layout_marginTop="15dp"
                android:background="#FFE7E7E7"
                android:enabled="false"
                android:gravity="center"
                android:visibility="invisible"/>

            <EditText
                android:id="@+id/ourpay_edittext_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/ourpay_edittext_selector"
                android:focusableInTouchMode="true"
                android:inputType="phone"
                android:paddingBottom="10dp"
                android:paddingLeft="70dp"
                android:paddingRight="10dp"
                android:paddingTop="10dp"/>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/ourpay_text_phone_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_gravity="right"
                android:paddingTop="5dp"
                android:text="@string/invalid_phone_number"
                android:textColor="@color/red"
                android:textSize="12sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/ourpay_text_resend_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:paddingTop="5dp"
                android:text="@string/resend_code"
                android:textColor="@color/navy"
                android:textSize="12sp"/>

        </RelativeLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enter_your_code_below"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold"/>


        <EditText
            android:id="@+id/ourpay_edittext_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            style="@style/DDEditTextStyle"
            android:background="@drawable/ourpay_edittext_selector"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:maxLength="6"
            android:hint="xxxx"
            android:inputType="phone"
            android:padding="10dp"/>

        <TextView
            android:id="@+id/ourpay_text_code_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingTop="5dp"
            android:text="@string/invalid_code"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:visibility="gone"/>


        <Button
            android:id="@+id/ourpay_button_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/DDButtonStyle"
            android:layout_marginTop="10dp"
            android:text="@string/confirm"
            />

    </LinearLayout>
</LinearLayout>