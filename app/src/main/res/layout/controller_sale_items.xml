<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background_color"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/controller_search_popular_subheader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@string/font_app_bold"
            android:gravity="left"
            android:padding="10dp"
            android:text="@string/popular_products"
            android:textColor="@color/sale_items_highlight"
            android:visibility="gone" />

        <android.support.v7.widget.RecyclerView
            android:id="@+id/controller_sale_items_grid_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/controller_search_popular_subheader"
            android:background="#FFFFFF"
            android:paddingLeft="5dp"
            android:paddingRight="5dp" />


        <RelativeLayout
            android:id="@+id/controller_sale_items_opaque_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/search_gray_opaque"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/controller_sale_items_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/font_app_bold"
                android:text="@string/sorry_today_we_can_t_find_anything_by_your_request"
                android:gravity="center"
                android:textColor="@color/cart_order_price_text_color"
                android:textSize="@dimen/text_size_large" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/dimen_extra_small"
                android:fontFamily="@string/font_app_bold"
                android:gravity="center"
                android:text="@string/meanwhile_why_not_search_for_something_else"
                android:textColor="@color/gray_description_text"
                android:textSize="@dimen/text_size_large" />

        </LinearLayout>

    </RelativeLayout>

</LinearLayout>
