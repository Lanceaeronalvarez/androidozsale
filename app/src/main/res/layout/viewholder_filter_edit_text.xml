<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp">
    <au.com.dealsdirect.ui.custom.ChipsEditText
        android:id="@+id/search_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:clickable="true"
        android:gravity="center_vertical"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:inputType="text"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:hint="Search Filter"
        android:maxLines="1"
        android:textColor="@android:color/white"
        android:textColorHint="#CCFFFFFF"
        android:textCursorDrawable="@drawable/bg_field_cursor"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginTop="5dp"
        android:textSize="@dimen/text_size_xxlarge"/>
    <TextView
        android:id="@+id/search_text_view_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:inputType="text"
        android:text="Search Filter"
        android:layout_margin="5dp"
        android:textColor="@color/gray_field_text"
        android:textSize="@dimen/text_size_xxlarge"
        />
</FrameLayout>