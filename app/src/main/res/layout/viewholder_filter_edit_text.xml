<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp">
    <au.com.dealsdirect.ui.custom.ChipsEditText
        android:id="@+id/search_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:focusableInTouchMode="true"
        android:hint="@string/search_filter_hint"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:inputType="text"
        android:padding="10dp"
        android:maxLines="1"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_extra_light"
        android:textCursorDrawable="@drawable/bg_field_cursor"
        android:textSize="@dimen/text_size_headline3" />
</FrameLayout>
