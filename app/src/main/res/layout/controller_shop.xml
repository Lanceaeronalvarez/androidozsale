<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:nestedScrollingEnabled="false">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_skin"
        android:layout_marginBottom="15dp">

        <include android:id="@+id/controller_shop_toolbar"
                 layout="@layout/partial_toolbar_logo" />

        <android.support.v7.widget.RecyclerView
            android:id="@+id/controller_shop_banner_recycler"
            android:layout_below="@+id/controller_shop_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#e9e9e9">

        </android.support.v7.widget.RecyclerView>

    </RelativeLayout>


</android.support.design.widget.CoordinatorLayout>
