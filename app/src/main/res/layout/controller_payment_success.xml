<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    android:orientation="vertical"
    android:overScrollMode="never"
    android:paddingLeft="@dimen/padding_default"
    android:paddingRight="@dimen/padding_default"
    android:paddingTop="@dimen/padding_default"
    android:scrollbars="none"
    tools:ignore="MissingPrefix">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/payment_success_bottom_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <TextView
                fontPath="@string/font_app_bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/your_payment_has_been_successful"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/text_size_headline2" />

            <TextView
                android:id="@+id/payment_success_estimated_delivery_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginEnd="@dimen/margin_small"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_marginTop="@dimen/margin_small"
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_body"
                tools:text="01/01/2018"/>


            <LinearLayout
                android:id="@+id/payment_ourpay_success_detail_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/your_order_number_is"
                    android:textColor="@color/text_medium"
                    android:textSize="@dimen/text_size_headline3" />


                <TextView
                    android:id="@+id/payment_success_order_number"
                    fontPath="@string/font_app_bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_small"
                    android:gravity="center"
                    android:textColor="@color/payment_success_text_order_name"
                    android:textSize="45sp"
                    tools:text="301231331" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:gravity="center"
                    android:text="@string/thank_you_for_shopping"
                    android:textSize="@dimen/text_size_body" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/payment_success_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/margin_small">

        <Button
            android:id="@+id/partial_continue_shopping_button"
            style="@style/DDButtonStyle"
            android:layout_width="match_parent"
            android:text="@string/continue_shopping"/>

        <LinearLayout
            android:id="@+id/ourpay_panel_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_extra_small"
            android:orientation="vertical" />

    </LinearLayout>
</RelativeLayout>
