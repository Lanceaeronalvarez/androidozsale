<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:animateLayoutChanges="true"
                android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/controller_view_contact_history_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/activity_horizontal_margin"
        android:paddingTop="10dp"
        android:paddingRight="@dimen/activity_vertical_margin"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <ImageView
            android:visibility="invisible"
            android:layout_width="16dp"
            android:layout_height="80dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/controller_view_contact_history_header_title"
                android:fontFamily="@string/font_lato_medium"
                android:text="Yellow Off Shoulder Dress"
                android:textColor="#0cc3c7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


            <TextView
                android:id="@+id/contact_history_header_time_stamp"
                android:fontFamily="@string/font_lato_medium"
                android:visibility="gone"
                android:textColor="#b4b4b4"
                android:text="03:10 PM"
                android:textSize="12sp"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/contact_history_header_invoice_indicator"
                android:layout_below="@+id/controller_view_contact_history_header_title"
                android:fontFamily="@string/font_lato_medium"
                android:textColor="#b3b3b3"
                android:text="Invoice #:"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/contact_history_header_invoice_value"
                android:layout_below="@+id/controller_view_contact_history_header_title"
                android:layout_toEndOf="@+id/contact_history_header_invoice_indicator"
                android:layout_toRightOf="@+id/contact_history_header_invoice_indicator"
                android:fontFamily="@string/font_lato_medium"
                android:textSize="15sp"
                android:text="204001123"
                android:layout_marginLeft="10dp"
                android:textColor="@color/dark_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </RelativeLayout>
    </LinearLayout>

    <View
        android:layout_below="@+id/controller_view_contact_history_header"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#eaeaea"/>

    <android.support.v7.widget.RecyclerView
        android:id="@+id/contact_history_recycler_view"
        android:layout_below="@+id/controller_view_contact_history_header"
        android:overScrollMode="never"
        android:layout_marginTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    </android.support.v7.widget.RecyclerView>

</RelativeLayout>
