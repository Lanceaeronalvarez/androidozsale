<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    android:orientation="vertical">

    <include
        android:id="@+id/view_contacts_toolbar"
        layout="@layout/partial_toolbar_arrow" />

    <RelativeLayout
        android:id="@+id/controller_add_contact_subject_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/view_contacts_toolbar"
        android:padding="16dp">

        <TextView
            android:id="@+id/controller_view_contact_history_header_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puma Designer Collaboration"
            android:textColor="#7e7e7e"
            android:textSize="@dimen/text_size_headline2" />

        <TextView
            android:id="@+id/contact_history_header_time_stamp"
            fontPath="@string/font_app_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="06:57pm"
            android:textColor="#b3b3b3"
            android:textSize="@dimen/text_size_body"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/controller_view_contact_history_header_sale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/controller_view_contact_history_header_subject"
            android:text="hi my order has not yet arrived"
            android:textColor="#a4a4a4"
            android:textSize="@dimen/text_size_headline3" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/controller_add_contact_message_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/contacts_edittext_height"
        android:layout_alignParentBottom="true"
        android:background="@color/background_default"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/controller_view_contacts_history_message_field"
            style="@style/Widget.AppCompat.Spinner.Underlined"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_add_contact_message"
            android:hint="@string/write_a_message"
            android:textColorHint="@color/text_medium"
            android:padding="10dp"
            android:textColor="@color/contact_us_text_black_color"/>

        <ImageButton
            android:id="@+id/controller_view_contacts_history_reply_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@null"
            android:src="@drawable/ic_contact_us_send" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/controller_add_contact_subject_container"
        android:background="@color/border_regular" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/controller_add_contact_message_container"
        android:background="@color/border_regular" />

    <TextView
        android:id="@+id/contact_history_list_time_stamp"
        fontPath="@string/font_app_semibold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/controller_add_contact_subject_container"
        android:layout_centerHorizontal="true"
        android:padding="20dp"
        android:text="06:57pm"
        android:textColor="#b3b3b3"
        android:textSize="@dimen/text_size_body"
        tools:ignore="MissingPrefix" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contact_history_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/controller_add_contact_message_container"
        android:layout_below="@id/contact_history_list_time_stamp"
        android:overScrollMode="never" />

</RelativeLayout>

