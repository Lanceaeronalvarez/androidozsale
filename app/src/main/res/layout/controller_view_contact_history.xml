<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include
        android:id="@+id/view_contacts_toolbar"
        layout="@layout/partial_toolbar_arrow" />

    <RelativeLayout
        android:id="@+id/controller_add_contact_subject_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/view_contacts_toolbar"
        android:padding="16dp">

        <TextView
            android:id="@+id/controller_view_contact_history_header_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puma Designer Collaboration"
            android:textColor="#7e7e7e"
            android:textSize="@dimen/text_size_xxlarge" />

        <TextView
            android:id="@+id/contact_history_header_time_stamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="06:57pm"
            android:textColor="#b3b3b3"
            android:textSize="@dimen/text_size_large" />

        <TextView
            android:id="@+id/controller_view_contact_history_header_sale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/controller_view_contact_history_header_subject"
            android:text="hi my order has not yet arrived"
            android:textColor="#a4a4a4"
            android:textSize="@dimen/text_size_xlarge" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/controller_add_contact_message_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:layout_alignParentBottom="true"
        android:background="@color/gray_background"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/controller_view_contacts_history_message_field"
            style="@style/Widget.AppCompat.Spinner.Underlined"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_add_contact_message"
            android:hint="@string/write_a_message"
            android:padding="10dp" />

        <ImageButton
            android:id="@+id/controller_view_contacts_history_reply_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@null"
            android:src="@drawable/ic_contact_us_send" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/controller_add_contact_subject_container"
        android:background="@color/gray_border" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/controller_add_contact_message_container"
        android:background="@color/gray_border" />

    <android.support.v7.widget.RecyclerView
        android:id="@+id/contact_history_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/controller_add_contact_message_container"
        android:layout_below="@id/controller_add_contact_subject_container"
        android:overScrollMode="never"
        android:paddingBottom="10dp"
        android:paddingTop="10dp" />

</RelativeLayout>

