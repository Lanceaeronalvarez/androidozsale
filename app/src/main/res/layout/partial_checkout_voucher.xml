<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/partial_checkout_voucher_container_layout"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/padding_default"
        android:paddingRight="@dimen/padding_default"
        android:paddingTop="@dimen/margin_small">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:text="@string/voucher"
            android:textColor="@color/text_light" />

        <TextView
            android:id="@+id/partial_checkout_voucher_change"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/change"
            android:textColor="@color/text_medium"
            android:textSize="@dimen/text_size_headline3"
            android:visibility="gone" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/partial_checkout_voucher_new_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_large"
        android:layout_marginTop="@dimen/margin_small"
        android:background="@drawable/bg_edit_text_plain"
        android:clickable="true"
        android:padding="@dimen/padding_default">

        <EditText
            android:id="@+id/partial_checkout_voucher_edittext"
            style="@style/DDEditTextStyleNoBorder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/enter_promo_code"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/row_checkout_text_light_color"
            android:textColorHint="@color/row_checkout_text_light_color"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_new_voucher"
            android:textColor="@color/text_medium"
            android:textSize="@dimen/text_size_headline3" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:src="@drawable/ic_gray_chevron" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/partial_checkout_voucher_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/row_background_color"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/padding_default">

            <ImageView
                android:layout_width="@dimen/margin_extra_large"
                android:layout_height="@dimen/margin_extra_large"
                android:paddingBottom="@dimen/margin_extra_small"
                android:paddingLeft="@dimen/margin_extra_small"
                android:paddingRight="@dimen/margin_extra_small"
                android:src="@drawable/ic_my_vouchers" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="@dimen/margin_small"
                android:paddingStart="@dimen/margin_small">

                <TextView
                    android:id="@+id/partial_checkout_voucher_value_text_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_medium"
                    android:textSize="@dimen/text_size_headline2"
		            android:visibility="gone"
                    tools:text="$5 voucher" />

                <TextView
                    android:id="@+id/partial_checkout_voucher_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_medium"
                    tools:text="voucher will expire on 12/25/16" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
