<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/view_holder_my_current_returns_row_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_view_states"
    android:orientation="vertical"
    android:padding="@dimen/padding_default"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:id="@+id/my_order_information_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/my_current_returns_header_text_view"
            fontPath="@string/font_app_bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_extra_small"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="Invoice 123456"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_size_caption1"
            tools:ignore="HardcodedText" />


        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:src="@drawable/ic_gray_chevron"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/my_current_return_item_option"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:background="#00000000"
        android:gravity="center"
        android:paddingLeft="@dimen/margin_medium"
        android:paddingTop="@dimen/margin_medium"
        android:paddingBottom="@dimen/margin_small"
        android:src="@drawable/ic_orders_ellipsis" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/current_return_images"
        android:layout_width="match_parent"
        android:layout_height="@dimen/order_image_height"
        android:layout_marginTop="@dimen/margin_small" />

    <include
        android:id="@+id/component_return_tracking"
        layout="@layout/component_return_tracking"
        android:visibility="visible" />

</LinearLayout>

