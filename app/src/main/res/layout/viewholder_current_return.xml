<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/view_holder_my_current_returns_row_container"
    android:layout_margin="5dp"
    android:layout_width="match_parent"
    android:layout_height="450dp"
    android:background="@drawable/bg_card_view_states">

    <RelativeLayout
        android:id="@+id/viewholder_current_return_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp">

        <RelativeLayout
            android:id="@+id/my_order_information_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp">

            <TextView
                android:id="@+id/current_return_request_number_text_identifier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Request #:"
                android:textColor="#6c6b6b"
                android:textSize="@dimen/text_size_large"
                android:fontFamily="@string/font_lato_bold"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/current_return_request_number_text_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginStart="5dp"
                android:layout_toEndOf="@+id/current_return_request_number_text_identifier"
                android:layout_toRightOf="@id/current_return_request_number_text_identifier"
                android:text="204400890"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/text_size_large"
                android:fontFamily="@string/font_lato_bold"
                tools:ignore="HardcodedText"/>


            <TextView
                android:id="@+id/my_current_returns_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/current_return_request_number_text_identifier"
                android:layout_marginTop="20dp"
                android:text="Philosophy Cotton Sleeveless Plain"
                android:textColor="#878787"
                android:textSize="@dimen/text_size_medium"
                android:fontFamily="@string/font_lato_bold"
                tools:ignore="HardcodedText"/>

        </RelativeLayout>


        <View
            android:id="@+id/return_header_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/my_order_information_header"
            android:background="@color/gray_border">

        </View>


        <android.support.v7.widget.RecyclerView
            android:id="@+id/current_return_items_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/return_header_divider"
            android:clickable="true"
            android:isScrollContainer="false"
            android:nestedScrollingEnabled="false"
            android:orientation="vertical"
            android:padding="10dp">

        </android.support.v7.widget.RecyclerView>


        <RelativeLayout
            android:id="@+id/my_current_return_information_text_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/current_return_items_recyclerview"
            android:layout_marginTop="4dp">


            <RelativeLayout
                android:id="@+id/my_current_return_item_date_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp">


                <TextView
                    android:id="@+id/my_current_returns_product_request_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Request Date:"
                    android:textColor="#5c5c5c"
                    android:textSize="@dimen/text_size_medium"
                    android:fontFamily="@string/font_lato_medium"
                    tools:ignore="HardcodedText"/>


                <TextView
                    android:id="@+id/my_order_product_delivery_from_date_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginLeft="2dp"
                    android:text="12/08/16"
                    android:textColor="#1b1b1b"
                    android:textSize="@dimen/text_size_medium"
                    android:fontFamily="@string/font_lato_medium"
                    tools:ignore="HardcodedText"/>

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/my_current_return_item_date_info"
                android:background="@color/gray_border">

            </View>

            <RelativeLayout
                android:id="@+id/my_current_return_item_is_approved_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/my_current_return_item_date_info"
                android:layout_marginTop="2dp"
                android:padding="10dp">

                <TextView
                    android:id="@+id/my_current_returns_product_is_approved_identifier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Approved:"
                    android:textColor="#5c5c5c"
                    android:textSize="@dimen/text_size_medium"
                    android:fontFamily="@string/font_lato_medium"
                    tools:ignore="HardcodedText"/>


                <TextView
                    android:id="@+id/my_current_returns_product_is_approved_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginLeft="2dp"
                    android:text="---"
                    android:textColor="#1b1b1b"
                    android:textSize="@dimen/text_size_medium"
                    android:fontFamily="@string/font_lato_bold"
                    tools:ignore="HardcodedText"/>

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/my_current_return_item_is_approved_info"
                android:background="@color/gray_border">

            </View>

            <RelativeLayout
                android:id="@+id/my_current_return_item_status_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/my_current_return_item_is_approved_info"
                android:padding="10dp"
                android:layout_alignParentEnd="true">

                <TextView
                    android:id="@+id/my_current_return_item_status_identifier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status:"
                    android:textColor="#5c5c5c"
                    android:textSize="@dimen/text_size_medium"
                    android:fontFamily="@string/font_lato_medium"
                    tools:ignore="HardcodedText"/>


                <TextView
                    android:id="@+id/my_current_return_item_status_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginLeft="2dp"
                    android:text="---"
                    android:textColor="#1b1b1b"
                    android:textSize="@dimen/text_size_medium"
                    android:fontFamily="@string/font_lato_black"
                    tools:ignore="HardcodedText"/>

            </RelativeLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/my_current_return_item_status_info"
                android:background="@color/gray_border">

            </View>


            <RelativeLayout
                android:id="@+id/my_current_return_item_RAN_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/my_current_return_item_status_info"
                android:padding="10dp">

                <TextView
                    android:id="@+id/my_current_return_item_RAN_identifier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAN:"
                    android:textColor="#5c5c5c"
                    android:textSize="@dimen/text_size_medium"
                    android:fontFamily="@string/font_lato_black"
                    tools:ignore="HardcodedText"/>


                <TextView
                    android:id="@+id/my_current_return_item_RAN_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginLeft="2dp"
                    android:text="Pending"
                    android:textColor="#1b1b1b"
                    android:textSize="@dimen/text_size_medium"
                    android:fontFamily="@string/font_lato_bold"
                    tools:ignore="HardcodedText"/>

            </RelativeLayout>


        </RelativeLayout>
    </RelativeLayout>


    <!--</LinearLayout>-->

</android.support.v7.widget.CardView>

