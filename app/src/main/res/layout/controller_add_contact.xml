<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include
        android:id="@+id/view_contacts_toolbar"
        layout="@layout/partial_toolbar_arrow" />

    <LinearLayout
        android:id="@+id/controller_add_contact_subject_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/view_contacts_toolbar"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/controller_add_contact_subject_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="16dp"
                android:text="@string/subject"
                android:textColor="@color/contact_us_text_selector"
                android:textSize="@dimen/text_size_large" />

            <TextView
                android:id="@+id/controller_add_contact_subject_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:textColor="#616161" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/controller_add_contact_order_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="16dp"
                android:text="@string/sale"
                android:textColor="@color/contact_us_text_selector"
                android:textSize="@dimen/text_size_large" />

            <TextView
                android:id="@+id/controller_add_contact_order_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:textColor="#616161" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_border" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/controller_add_contact_message_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:layout_alignParentBottom="true"
        android:background="@color/gray_background"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/controller_add_contact_message_field"
            style="@style/Widget.AppCompat.Spinner.Underlined"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_add_contact_message"
            android:hint="@string/write_a_message"
            android:padding="10dp" />

        <ImageButton
            android:id="@+id/controller_add_contact_message_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@null"
            android:src="@drawable/ic_contact_us_send" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/controller_add_contact_message_container"
        android:background="@color/gray_border" />

    <FrameLayout
        android:id="@+id/controller_add_contact_selector_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/controller_add_contact_message_container"
        android:layout_below="@id/controller_add_contact_subject_container" />

</RelativeLayout>
