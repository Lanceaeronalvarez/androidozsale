<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/view_contacts_toolbar"
        layout="@layout/partial_toolbar_arrow" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_margin="@dimen/activity_horizontal_margin">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Subject"
                android:textSize="@dimen/text_size_large"
                android:textColor="#616161"/>



            <TextView
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:clickable="true"
                android:id="@+id/controller_add_contact_subject_text"
                android:background="@drawable/bg_add_contact_spinner"
                android:padding="10dp"
                android:layout_marginTop="10dp"
                android:textColor="#616161"/>

        </LinearLayout>


        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sale"
                android:textSize="@dimen/text_size_large"
                android:textColor="#616161"/>



            <TextView
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:id="@+id/controller_add_contact_order_text"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_add_contact_spinner"
                android:padding="10dp"
                android:clickable="true"
                android:textColor="#616161"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Message"
                android:textSize="@dimen/text_size_large"
                android:textColor="#616161"/>

            <EditText
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:id="@+id/controller_add_contact_message_field"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/bg_add_contact_message"
                android:padding="10dp"
                android:gravity="top"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


    </LinearLayout>

</LinearLayout>
