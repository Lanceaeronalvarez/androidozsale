<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/padding_default"
    tools:ignore="MissingPrefix">

    <ImageView
        android:id="@+id/item_checkout_image"
        android:layout_width="@dimen/row_checkout_image_width"
        android:layout_height="@dimen/row_checkout_image_height"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/margin_small"
        android:paddingStart="@dimen/margin_small">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_checkout_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="@color/row_checkout_text_light_color"
                android:textSize="@dimen/text_size_body"
                tools:text="Philosophy (Runway) Cotton Sleeveless Plain" />

            <TextView
                fontPath="@string/font_app_semibold"
                android:id="@+id/item_checkout_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/cart_text_order_price"
                android:textSize="@dimen/text_size_headline2"
                tools:text="$19.00" />

            <TextView
                android:id="@+id/item_subtotal_price"
                fontPath="@string/font_app_semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/item_checkout_price"
                android:layout_alignLeft="@id/item_checkout_price"
                android:textColor="@color/row_checkout_text_dark_color"
                android:textSize="@dimen/text_size_body"
                android:visibility="gone"
                tools:text="$19.00" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/margin_small">

            <TextView
                android:id="@+id/item_checkout_color_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color"
                 />

            <TextView
                android:id="@+id/item_checkout_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Pink" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_checkout_size_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/size" />

            <TextView
                android:id="@+id/item_checkout_size_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="AU 14" />
        </LinearLayout>

        <au.com.dealsdirect.ui.custom.PersonalisationLayout
            android:id="@+id/item_checkout_personalisation_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!--Insert Quantity Indicator here-->

        <au.com.dealsdirect.ui.custom.ProductQuantityLayout
            android:id="@+id/item_checkout_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_extra_small" />

    </LinearLayout>

</LinearLayout>
