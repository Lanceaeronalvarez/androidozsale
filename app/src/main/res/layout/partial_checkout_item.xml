<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/item_checkout_image"
        android:layout_width="100dp"
        android:layout_height="130dp"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingStart="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_checkout_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="#717171"
                android:textSize="16sp"
                
                tools:text="@string/test_product_name" />

            <TextView
                android:id="@+id/item_checkout_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="#454545"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="$19.00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/item_checkout_color_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color"
                 />

            <TextView
                android:id="@+id/item_checkout_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                
                tools:text="Pink" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_checkout_size_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/size" />

            <TextView
                android:id="@+id/item_checkout_size_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="AU 14" />
        </LinearLayout>

        <!--Insert Quantity Indicator here-->

        <com.mysale.genie.views.custom.ProductQuantityLayout
            android:id="@+id/item_checkout_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp" />

    </LinearLayout>

</LinearLayout>