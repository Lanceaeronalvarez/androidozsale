<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewholder_top_brands_item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/top_brands_list_background"
    android:clickable="true"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <TextView
        android:id="@+id/viewholder_top_brands_item_name"
        fontPath="@string/font_app_semibold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/margin_large"
        android:paddingTop="@dimen/margin_extra_small"
        android:paddingRight="@dimen/margin_large"
        android:paddingBottom="@dimen/margin_extra_small"
        android:textColor="@color/top_brands_list_text"
        android:textSize="@dimen/text_size_headline3"
        tools:text="Atom Pro Compression" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@id/viewholder_top_brands_item_name"
        android:background="@color/top_brands_list_separator"
        android:layout_marginLeft="@dimen/margin_large"
        android:layout_marginRight="@dimen/margin_large"
        android:layout_marginBottom="@dimen/margin_small"/>

</RelativeLayout>