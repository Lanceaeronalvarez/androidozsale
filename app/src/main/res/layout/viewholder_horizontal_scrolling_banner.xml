<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewholder_horizontal_scrolling_banner_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#00000000"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <RelativeLayout
        android:id="@+id/viewholder_banner_header_text_container"
        android:layout_width="match_parent"
        android:background="#00000000"
        android:layout_height="@dimen/horizontal_banner_header_title_height"
        android:gravity="center_horizontal|bottom"
        android:visibility="gone">
        <TextView
            android:id="@+id/viewholder_banner_header_text"
            fontPath="@string/font_app_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#00000000"
            android:text="Header"
            android:paddingBottom="@dimen/margin_small"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />
    </RelativeLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/viewholder_horizontal_scrolling_banner_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:background="@color/white">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/viewholder_horizontal_scrolling_banner_indicator"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/horizontal_banner_circle_indicator_height"
            android:layout_centerInParent="true"
            android:isScrollContainer="true"
            android:overScrollMode="never" />

    </RelativeLayout>

</LinearLayout>