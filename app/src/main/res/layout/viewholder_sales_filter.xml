<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clickable="true"
    tools:ignore="MissingPrefix"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/sale_filter_tile">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="horizontal"
            android:paddingTop="@dimen/margin_small"
            android:paddingBottom="@dimen/margin_small"
            android:paddingRight="@dimen/margin_small">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/row_filter_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:checked="false"
                android:button="@drawable/custom_checkbox_selector"
                android:paddingRight="@dimen/margin_small"
                android:layout_marginLeft="@dimen/margin_small" />

            <TextView
                android:id="@+id/row_category_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:text="" />

            <TextView
                fontPath="@string/font_app_bold"
                android:id="@+id/parent_category_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:text="" />


            <TextView
                android:id="@+id/filter_product_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/black"
                android:visibility="gone"
                android:text="" />

            <ImageView
                android:id="@+id/row_filter_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:background="@drawable/ic_check"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/row_filter_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/beige"
                android:src="@drawable/ic_chevron_right"
                android:scaleType="fitCenter"
                android:visibility="visible"
                app:tint="@color/beige" />

        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height=".5dp"
            android:background="@color/beige"/>

    </LinearLayout>

</RelativeLayout>
