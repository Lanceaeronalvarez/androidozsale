<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomSheetLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    app:behavior_hideable="true"
    app:behavior_peekHeight="0dp"
    app:layout_behavior="@string/bottom_sheet_behavior">

    <ImageView
        android:id="@+id/account_deletion_confirmation_logo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        android:src="@drawable/logo_colored"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/account_deletion_confirmation_text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        app:layout_constraintBottom_toTopOf="@+id/account_deletion_confirmation_confirm_button"
        app:layout_constraintHeight_max="400dp"
        app:layout_constraintTop_toBottomOf="@+id/account_deletion_confirmation_logo">

        <TextView
            android:id="@+id/account_deletion_confirmation_text"
            fontPath="@string/font_app_semibold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/margin_small"
            android:paddingBottom="@dimen/margin_small"
            android:lineSpacingExtra="@dimen/margin_tiny"
            android:text="@string/account_deletion_confirmation_text"
            android:textColor="@color/text_medium"
            android:textSize="@dimen/text_size_body" />
    </ScrollView>

    <Button
        android:id="@+id/account_deletion_confirmation_confirm_button"
        style="@style/DDButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/padding_default"
        android:layout_marginRight="@dimen/padding_default"
        android:layout_marginTop="@dimen/padding_default"
        android:text="Delete my account"
        android:textSize="@dimen/text_size_headline2"
        app:layout_constraintBottom_toBottomOf="@+id/account_deletion_confirmation_cancel_button"
        app:layout_constraintTop_toBottomOf="@+id/account_deletion_confirmation_text_container" />

    <Button
        android:id="@+id/account_deletion_confirmation_cancel_button"
        style="@style/DDButtonStyleTransparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_default"
        android:text="Cancel"
        android:textSize="@dimen/text_size_headline2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/account_deletion_confirmation_confirm_button" />

    <ImageButton
        android:id="@+id/account_deletion_confirmation_close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:background="@color/transparent"
        android:paddingTop="8dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:src="@drawable/bg_encircled_x_button" />
</androidx.constraintlayout.widget.ConstraintLayout>
