<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android"
                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                   android:layout_width="match_parent"
                                   android:layout_height="?attr/actionBarSize"
                                   xmlns:tools="http://schemas.android.com/tools"
                                   android:background="@color/toolbar_skin"
                                   android:contentInsetEnd="0dp"
                                   android:contentInsetLeft="0dp"
                                   android:contentInsetRight="0dp"
                                   android:contentInsetStart="0dp"
                                   app:contentInsetEnd="0dp"
                                   app:contentInsetLeft="0dp"
                                   app:contentInsetRight="0dp"
                                   app:contentInsetStart="0dp"
                                   app:layout_scrollFlags="scroll|enterAlways">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <ImageButton
                android:id="@+id/partial_toolbar_hamburger"
                android:layout_width="@dimen/partial_toolbar_button_width"
                android:layout_height="@dimen/partial_toolbar_button_height"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_toolbar_button"
                android:padding="@dimen/partial_toolbar_button_padding"
                android:src="@drawable/ic_gray_chevron_left" />

            <TextView
                android:id="@+id/partial_toolbar_logo_title_view"
                fontPath="@string/font_app_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_headline2"
                tools:text="Title"
                android:visibility="gone"
                tools:ignore="MissingPrefix"/>

            <ImageView
                android:id="@+id/partial_toolbar_logo"
                android:layout_width="@dimen/partial_toolbar_logo_width"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:src="@drawable/logo_white" />

            <ImageButton
                android:id="@+id/partial_toolbar_search_icon"
                android:layout_width="@dimen/partial_toolbar_button_width"
                android:layout_height="@dimen/partial_toolbar_button_height"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_toolbar_button"
                android:padding="@dimen/margin_extra_small"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search" />

        </RelativeLayout>

    </LinearLayout>

</android.support.v7.widget.Toolbar>
