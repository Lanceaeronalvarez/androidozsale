    <!--android:text="shop now"-->
    <!--android:textSize="20sp"-->
    <!--android:gravity="center"-->
    <!--android:layout_margin="@dimen/activity_horizontal_margin"-->
    <!--android:layout_alignParentBottom="true"/>-->

</RelativeLayout>
