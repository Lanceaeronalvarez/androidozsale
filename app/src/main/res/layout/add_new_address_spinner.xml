<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/border_thin"
    android:background="@color/white"
    android:orientation="horizontal"
    tools:ignore="MissingPrefix">

    <TextView
        android:id="@+id/row_add_address_label"
        fontPath="@string/font_app_semibold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.35"
        android:padding="@dimen/padding_default"
        android:textColor="@color/text_medium"
        android:textSize="@dimen/text_size_caption1" />

    <androidx.appcompat.widget.AppCompatSpinner
        android:id="@+id/row_add_address_spinner"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:layout_weight="0.65"
        android:background="@drawable/bg_edit_text_plain"
        android:maxLines="1" />
</LinearLayout>