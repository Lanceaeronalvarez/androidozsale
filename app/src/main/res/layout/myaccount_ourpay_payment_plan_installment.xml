<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/myAccountOurpayPaymentPlanInstallmentLeftLine"
        android:layout_width="0dp"
        android:layout_height="@dimen/ourpay_line_width"
        android:background="@android:color/darker_gray"
        app:layout_constraintBottom_toBottomOf="@+id/myAccountOurpayPaymentPlanInstallmentPog"
        app:layout_constraintEnd_toStartOf="@+id/myAccountOurpayPaymentPlanInstallmentPog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/myAccountOurpayPaymentPlanInstallmentPog" />

    <View
        android:id="@+id/myAccountOurpayPaymentPlanInstallmentRightLine"
        android:layout_width="0dp"
        android:layout_height="@dimen/ourpay_line_width"
        android:background="@android:color/darker_gray"
        app:layout_constraintBottom_toBottomOf="@+id/myAccountOurpayPaymentPlanInstallmentPog"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/myAccountOurpayPaymentPlanInstallmentPog"
        app:layout_constraintTop_toTopOf="@+id/myAccountOurpayPaymentPlanInstallmentPog" />

    <TextView
        android:id="@+id/myAccountOurpayPaymentPlanInstallmentDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ourpay_installment_detail_vertical_gap"
        android:text="Jun 5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/myAccountOurpayPaymentPlanInstallmentPog" />

    <TextView
        android:id="@+id/myAccountOurpayPaymentPlanInstallmentValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$40.00"
        android:textSize="@dimen/text_size_caption1"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/myAccountOurpayPaymentPlanInstallmentDate" />

    <FrameLayout
        android:id="@+id/myAccountOurpayPaymentPlanInstallmentPog"
        android:layout_width="@dimen/ourpay_installment_pog_diameter"
        android:layout_height="@dimen/ourpay_installment_pog_diameter"
        android:layout_marginTop="@dimen/ourpay_installment_top_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/myAccountOurpayPaymentPlanInstallmentNumber"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_myaccount_ourpay_installment_circle"
            android:gravity="center"
            android:text="1"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/myAccountOurpayPaymentPlanInstallmentSuccessful"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_myaccount_ourpay_installment_success_circle"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_myaccount_ourpay_successful" />

        <ImageView
            android:id="@+id/myAccountOurpayPaymentPlanInstallmentFailure"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_myaccount_ourpay_installment_failure_circle"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_myaccount_ourpay_failed" />
    </FrameLayout>

</android.support.constraint.ConstraintLayout>