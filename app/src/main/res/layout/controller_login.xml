<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background_color"
    android:fillViewport="true"
    android:orientation="vertical"
    android:overScrollMode="never"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar_title_login"
            layout="@layout/partial_toolbar_arrow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="@dimen/default_padding">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/controller_login_close_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dimen_extra_large"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="@dimen/dimen_extra_small"
                    android:rotation="180"
                    android:src="@drawable/ic_close"
                    android:tint="@color/controller_login_close_tint_color" />

            </RelativeLayout>

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/dimen_extra_large"
                android:layout_marginTop="@dimen/dimen_extra_large"
                android:src="@drawable/logo_colored" />

            <TextView
                fontPath="@string/font_app_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/email_address"
                android:textColor="@color/dark_text"
                android:textSize="@dimen/text_size_medium" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/controller_login_email_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_medium"
                android:layout_marginTop="@dimen/dimen_small"
                app:hintEnabled="false">

                <EditText
                    android:id="@+id/controller_login_email_edittext"
                    style="@style/DDEditTextStyle"
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/email_hint"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />

            </android.support.design.widget.TextInputLayout>

            <TextView
                fontPath="@string/font_app_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_extra_small"
                android:text="@string/password"
                android:textColor="@color/dark_text"
                android:textSize="@dimen/text_size_medium" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/controller_login_password_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_large"
                android:layout_marginTop="@dimen/dimen_small"
                app:hintEnabled="false"
                app:passwordToggleDrawable="@drawable/ic_show_password_toggle"
                app:passwordToggleEnabled="true">

            <EditText
                android:id="@+id/controller_login_password_edittext"
                style="@style/DDEditTextStyle"
                fontPath="@string/font_app_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/password_hint"
                android:inputType="textPassword"/>

            </android.support.design.widget.TextInputLayout>

        <Button
            android:id="@+id/login_button"
            style="@style/DDButtonStyle"
            fontPath="@string/font_app_semibold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/log_in"
            android:textSize="@dimen/text_size_xlarge"/>

            <RelativeLayout
                android:id="@+id/controller_login_fb_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/default_button_height"
                android:layout_marginTop="@dimen/dimen_small"
                android:background="@drawable/login_default_button"
                android:clickable="true"
                android:elevation="2.5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/controller_login_facebook_image_view"
                        android:layout_width="@dimen/dimen_large"
                        android:layout_height="@dimen/dimen_large"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dimen_small"
                        android:scaleType="fitCenter"
                        android:src="@drawable/facebook"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/controller_login_with_facebook_text"
                        fontPath="@string/font_app_semibold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dimen_small"
                        android:text="@string/login_with_facebook"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/text_size_xlarge" />
                </LinearLayout>
            </RelativeLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_medium"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/dimen_small">

                    <TextView
                        fontPath="@string/font_app_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/not_a_member_yet_text"
                        android:textColor="@color/dark_text"
                        android:textSize="@dimen/text_size_medium" />

                    <TextView
                        android:id="@+id/controller_login_signup_text"
                        fontPath="@string/font_app_semibold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/dimen_extra_small"
                        android:text="@string/sign_up"
                        android:textAllCaps="true"
                        android:textColor="@color/bg_button_default"
                        android:textSize="@dimen/text_size_medium" />

                    <TextView
                        fontPath="@string/font_app_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/dimen_extra_small"
                        android:text="@string/now"
                        android:textColor="@color/dark_text"
                        android:textSize="@dimen/text_size_medium" />

                </LinearLayout>


                <TextView
                    android:id="@+id/controller_login_forgot_password_text"
                    fontPath="@string/font_app_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/dimen_medium"
                    android:text="@string/forgot_password"
                    android:textColor="@color/bg_button_default"
                    android:textSize="@dimen/text_size_medium" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</android.support.v4.widget.NestedScrollView>
