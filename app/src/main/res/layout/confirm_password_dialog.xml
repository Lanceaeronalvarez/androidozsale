<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_16"
        android:orientation="vertical">

        <TextView
            fontPath="@string/font_app_bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_small"
            android:text="Enter your password to confirm changes"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_caption1" />

        <EditText
            android:id="@+id/confirm_password_edit_text"
            style="@style/DDEditTextStyleNoBorder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/margin_small"
            android:background="@drawable/border_black_rounded"
            android:hint="Enter your password"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/confirm_password_error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_small"
            android:text=""
            android:textColor="@color/red"
            android:visibility="gone" />

        <TextView
            android:id="@+id/forgot_password_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_small"
            android:text="@string/forgot_password_underline"
            android:textColor="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/close_text"
                fontPath="@string/font_app_bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_small"
                android:layout_weight="1"
                android:background="@drawable/border_black_rounded"
                android:padding="@dimen/margin_small"
                android:text="@string/cancel"
                android:textAlignment="center"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/confirm_changes_text"
                fontPath="@string/font_app_bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_small"
                android:layout_weight="1"
                android:background="@drawable/bg_black_rounded"
                android:padding="@dimen/margin_small"
                android:text="Confirm Changes"
                android:textAlignment="center"
                android:textColor="@color/white" />
        </LinearLayout>


    </LinearLayout>
</RelativeLayout>