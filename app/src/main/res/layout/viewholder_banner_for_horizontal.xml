<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewholder_banner_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true"
    android:orientation="vertical"
    android:paddingLeft="@dimen/horizontal_banner_spacing"
    android:paddingRight="@dimen/horizontal_banner_spacing"
    android:paddingBottom="@dimen/horizontal_banner_bottom_padding"
    tools:ignore="MissingPrefix">

    <ImageView
        android:id="@+id/viewholder_banner_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:transitionName="image" />

</RelativeLayout>