<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp"
    android:layout_marginTop="10dp"
    app:cardElevation="0dp"
    tools:ignore="MissingPrefix">

    <RelativeLayout
        android:id="@+id/sale_item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sale_item"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/cell_product_image_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/cell_product_image"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cell_image_height" />

            <TextView
                android:id="@+id/sale_item_sold_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:background="@color/gray_generic_icon"
                android:paddingBottom="8dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:text="@string/sold_out"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_large"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/sale_item_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cell_product_image_container"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:lines="1"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/gray_item_details"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sale_item_name"
            fontPath="@string/font_lato_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/sale_item_brand"
            android:ellipsize="end"
            android:gravity="center"
            android:lines="1"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:textColor="#616161"
            android:textSize="@dimen/text_size_medium"
            tools:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/sale_item_name"
            android:layout_marginBottom="19dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sale_item_price"
                fontPath="@string/font_lato_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:lines="1"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/text_size_xxxlarge"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sale_item_old_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/gray_description_text"
                android:textSize="@dimen/text_size_medium" />

        </LinearLayout>

    </RelativeLayout>

</android.support.v7.widget.CardView>
