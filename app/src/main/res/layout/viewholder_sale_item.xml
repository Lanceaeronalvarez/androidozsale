<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardElevation="0dp"
    tools:ignore="MissingPrefix">

    <RelativeLayout
        android:id="@+id/sale_item_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cell_height"
        android:background="@drawable/bg_sale_item"
        android:orientation="vertical">


        <ImageView
            android:id="@+id/cell_product_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cell_image_height"/>

        <View
            android:id="@+id/sale_item_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_below="@+id/cell_product_image"
            android:background="@color/gray_border"/>

        <TextView
            android:id="@+id/sale_item_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_margin="10dp"
            android:layout_below="@+id/sale_item_divider"
            android:gravity="center"
            android:text=""
            android:textColor="#068ab1"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/sale_item_name"
            fontPath="@string/font_lato_medium"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:ellipsize="end"
            android:layout_below="@+id/sale_item_brand"
            android:gravity="center"
            android:maxLines="2"
            android:padding="5dp"
            android:textColor="#000000"
            android:textSize="@dimen/text_size_medium"
            tools:text=""/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_below="@+id/sale_item_name"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sale_item_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/text_size_xxxlarge"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/sale_item_old_price"
                android:singleLine="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="5dp"
                android:text=""
                android:textColor="@color/gray_description_text"
                android:textSize="@dimen/text_size_medium"/>
        </LinearLayout>

    </RelativeLayout>

</android.support.v7.widget.CardView>
