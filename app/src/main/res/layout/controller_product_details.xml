<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_card_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    tools:ignore="MissingPrefix">

    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/main_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <RelativeLayout
                android:id="@+id/uppercard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="10dp">

                <!--<ImageView-->
                <!--android:id="@+id/gradientDrawable"-->
                <!--android:layout_width="match_parent"-->
                <!--android:background="@drawable/gradient"-->
                <!--android:layout_height="50dp"/>-->

                <FrameLayout
                    android:id="@+id/image_container"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/product_details_image_layout_height"
                    android:paddingBottom="10dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:id="@+id/item_card_image"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <com.lsjwzh.widget.recyclerviewpager.MyRecyclerViewPager
                        android:id="@+id/productImageRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:padding="5dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        app:layout_behavior="@string/appbar_scrolling_view_behavior"
                        app:rvp_singlePageFling="true"
                        app:rvp_triggerOffset="0.05" />

                    <android.support.v7.widget.RecyclerView
                        android:id="@+id/otherImagesRecyclerView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center"
                        android:isScrollContainer="true"
                        android:overScrollMode="never"
                        android:paddingBottom="16dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:visibility="gone" />

                </FrameLayout>

                <com.mysale.genie.views.custom.WishlistLayout
                    android:id="@+id/wishlist_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@id/image_container"
                    android:layout_alignParentRight="true"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/wishlist_frame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/image_container"
                    android:visibility="gone"
                    app:layout_anchor="@id/image_container"
                    app:layout_anchorGravity="bottom|right|end">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_gravity="center"
                        android:background="#23000000" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right"
                        android:layout_marginRight="3dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/share_fab"
                            android:layout_width="50dp"
                            android:layout_height="50dp" />

                        <ImageView
                            android:id="@+id/wishlist_fab"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginBottom="5dp"
                            android:layout_marginRight="10dp"
                            android:clickable="true" />
                    </LinearLayout>
                </FrameLayout>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/name_price_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:layout_marginLeft="@dimen/activity_horizontal_margin"
                    android:layout_marginRight="@dimen/activity_horizontal_margin">

                    <LinearLayout
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/productName"
                            fontPath="@string/font_lato_black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left"
                            android:ellipsize="end"
                            android:paddingLeft="0dp"
                            android:paddingRight="5dp"
                            android:text=""
                            android:textSize="@dimen/text_size_xlarge" />

                        <TextView
                            android:id="@+id/productCategory"
                            fontPath="@string/font_lato_black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/gray_title_text"
                            android:textSize="@dimen/text_size_small" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/productPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right"
                            android:maxLines="1"
                            android:text=""
                            android:textSize="@dimen/text_size_xlarge"
                            fontPath="@string/font_lato_bold" />

                        <TextView
                            android:id="@+id/productPreviousPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/gray_title_text"
                            android:textSize="@dimen/text_size_small"
                            fontPath="@string/font_lato_black" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottom_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/sizes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_alignParentTop="true"
                        android:layout_gravity="center"
                        android:background="#23000000" />

                    <RelativeLayout
                        android:id="@+id/sizeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:paddingTop="10dp"
                            android:text="sizes"
                            android:textColor="@color/gray_field_label"
                            android:textSize="@dimen/text_size_medium"
                            fontPath="@string/font_lato_bold" />

                        <ImageView
                            android:id="@+id/question_mark"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_alignParentRight="true"
                            android:visibility="invisible" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_toLeftOf="@id/question_mark"
                            android:paddingRight="5dp"
                            android:text="size guide"
                            android:textSize="@dimen/text_size_medium"
                            android:visibility="invisible"
                            fontPath="Lato" />

                    </RelativeLayout>

                    <com.zhy.view.flowlayout.TagFlowLayout
                        android:id="@+id/sizeList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/sizeLabel"
                        android:layout_marginBottom="10dp"
                        android:layout_marginTop="5dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        app:max_select="1" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_alignParentBottom="true"
                        android:layout_gravity="center"
                        android:background="#23000000" />

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/features"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <WebView
                        android:id="@+id/feature_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="10dp"
                        tools:ignore="WebViewLayout" />

                </LinearLayout>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_gravity="center"
                    android:background="#23000000" />

                <LinearLayout
                    android:id="@+id/estimated_delivery_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="estimated delivery"
                        android:textColor="@color/gray_field_label"
                        android:textSize="@dimen/text_size_medium"
                        fontPath="@string/font_lato_bold" />

                    <TextView
                        android:id="@+id/estimatedDeliveryText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/gray_field_text"
                        android:textSize="@dimen/text_size_small"
                        fontPath="@string/font_lato_bold" />

                    <TextView
                        android:id="@+id/estimatedDeliveryDescText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/gray_field_text"
                        android:textSize="@dimen/text_size_medium"
                        fontPath="@string/font_lato_black" />

                </LinearLayout>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_gravity="center"
                    android:background="#23000000"
                    android:visibility="gone" />

                <!--pickup points container-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="available for"
                        android:textColor="@color/gray_field_text"
                        android:textSize="@dimen/text_size_medium"
                        fontPath="@string/font_lato_bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginLeft="5dp"
                                android:text="home or office delivery"
                                android:textColor="@color/gray_field_text"
                                android:textSize="@dimen/text_size_medium"
                                fontPath="@string/font_lato_bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/activity_horizontal_margin">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginLeft="5dp"
                                android:text="pick up point"
                                android:textColor="@color/gray_field_text"
                                android:textSize="@dimen/text_size_medium"
                                fontPath="@string/font_lato_bold" />

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_gravity="center"
                    android:background="#23000000" />

                <LinearLayout
                    android:id="@+id/about_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="about"
                        android:textColor="@color/gray_field_text"
                        android:textSize="@dimen/text_size_medium"
                        fontPath="@string/font_lato_bold" />

                    <WebView
                        android:id="@+id/productAboutText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        tools:ignore="WebViewLayout" />

                </LinearLayout>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_gravity="center"
                    android:background="#23000000" />

                <LinearLayout
                    android:id="@+id/returnPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="return policy"
                        android:textColor="@color/gray_field_text"
                        android:textSize="@dimen/text_size_medium"
                        fontPath="@string/font_lato_bold" />

                    <TextView
                        android:id="@+id/productReturnPolicy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/return_policy"
                        android:textSize="@dimen/text_size_small"
                        fontPath="@string/font_lato_black" />
                </LinearLayout>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_gravity="center"
                    android:background="#23000000" />

                <LinearLayout
                    android:id="@+id/shipping_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="shipping"
                        android:textColor="@color/gray_field_text"
                        android:textSize="@dimen/text_size_medium"
                        fontPath="@string/font_lato_bold" />

                    <WebView
                        android:id="@+id/product_shipping"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        tools:ignore="WebViewLayout"  />
                </LinearLayout>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_gravity="center"
                    android:background="#23000000" />

                <LinearLayout
                    android:id="@+id/aboutPricing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="pricing"
                        android:textColor="@color/gray_field_text"
                        android:textSize="@dimen/text_size_medium"
                        fontPath="@string/font_lato_bold" />


                    <WebView
                        android:id="@+id/product_about_pricing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        tools:ignore="WebViewLayout" />


                    <!--<com.example.customviewlib.GenieTextView-->
                    <!--android:id="@+id/productAboutPricing"-->
                    <!--android:layout_marginTop="10dp"-->
                    <!--android:layout_width="match_parent"-->
                    <!--android:layout_height="wrap_content"-->
                    <!--fontPath="@string/font_lato"-->
                    <!--android:textSize="@dimen/text_size_small" />-->
                </LinearLayout>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_gravity="center"
                    android:background="#23000000" />

                <LinearLayout
                    android:id="@+id/relatedItemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="related items"
                        android:textSize="@dimen/text_size_small"
                        fontPath="@string/font_lato_bold" />

                    <android.support.v7.widget.RecyclerView
                        android:id="@+id/relatedItemsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:paddingRight="10dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_gravity="center"
                    android:background="#23000000" />

                <LinearLayout
                    android:id="@+id/customersAlsoBoughtContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="customers also bought"
                        android:textSize="@dimen/text_size_small"
                        fontPath="@string/font_lato_bold" />

                    <android.support.v7.widget.RecyclerView
                        android:id="@+id/customersAlsoBoughtRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:paddingRight="10dp" />
                </LinearLayout>


                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_gravity="center"
                    android:background="#23000000"
                    android:visibility="gone" />

                <RelativeLayout
                    android:id="@+id/reviewsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="reviews"
                        android:textSize="@dimen/text_size_medium"
                        fontPath="@string/font_lato_bold" />

                    <android.support.design.widget.FloatingActionButton
                        android:id="@+id/edit_review_fab"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="5dp"
                        android:layout_marginTop="5dp"
                        android:clickable="true"
                        android:scaleType="fitXY"
                        app:backgroundTint="#ffffff" />

                    <android.support.v7.widget.RecyclerView
                        android:id="@+id/reviewsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_below="@id/edit_review_fab" />

                    <TextView
                        android:id="@+id/see_more_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/reviewsRecyclerView"
                        android:text="see more"
                        android:textSize="@dimen/text_size_medium"
                        fontPath="@string/font_lato_bold" />
                </RelativeLayout>

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <TextView
        android:id="@+id/discountLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingBottom="14dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="14dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="invisible"
        fontPath="@string/font_lato_black" />

</FrameLayout>