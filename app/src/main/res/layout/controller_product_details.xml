<?xml version="1.0" encoding="utf-8"?>
<au.com.dealsdirect.ui.controller.saleitemdetails.SaleItemDetailsView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/product_details_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MissingPrefix">

    <View
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:transitionName="detailsSharedBackground" />

    <RelativeLayout
        android:id="@+id/product_details_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <android.support.design.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true">

            <android.support.v4.widget.NestedScrollView
                android:id="@+id/controller_sale_item_detail_scrollview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/item_card_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <RelativeLayout
                            android:id="@+id/container"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/white"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <LinearLayout
                                android:id="@+id/main_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:orientation="vertical"
                                android:paddingBottom="@dimen/default_button_height">

                                <RelativeLayout
                                    android:id="@+id/uppercard"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:clipChildren="false"
                                    android:clipToPadding="false"
                                    android:elevation="10dp">

                                    <!--<ImageView-->
                                    <!--android:id="@+id/gradientDrawable"-->
                                    <!--android:layout_width="match_parent"-->
                                    <!--android:background="@drawable/gradient"-->
                                    <!--android:layout_height="50dp"/>-->


                                    <FrameLayout
                                        android:id="@+id/image_container"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:clipChildren="false"
                                        android:clipToPadding="false">

                                        <RelativeLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="55dp"
                                            android:transitionName="cardbackground">


                                            <ImageView
                                                android:id="@+id/product_details_shared_image"
                                                android:layout_width="match_parent"
                                                android:layout_height="300dp"
                                                android:layout_alignParentTop="true"
                                                android:layout_gravity="center"
                                                android:layout_margin="10dp"
                                                android:padding="5dp"
                                                android:visibility="visible" />


                                            <com.lsjwzh.widget.recyclerviewpager.RecyclerViewPager
                                                android:id="@+id/productImageRecyclerView"
                                                android:layout_width="match_parent"
                                                android:layout_height="300dp"
                                                android:layout_alignTop="@+id/product_details_shared_image"
                                                android:layout_gravity="center"
                                                android:clipChildren="false"
                                                android:clipToPadding="false"
                                                android:layout_margin="10dp"
                                                android:padding="5dp"
                                                android:visibility="invisible"
                                                app:rvp_singlePageFling="true"
                                                app:rvp_triggerOffset="0.05" />


                                            <ImageView
                                                android:id="@+id/left_arrow_image"
                                                android:layout_width="50dp"
                                                android:layout_height="40dp"
                                                android:layout_alignParentLeft="true"
                                                android:layout_centerVertical="true"
                                                android:src="@drawable/ic_left_arrow"
                                                android:visibility="visible" />

                                            <ImageView
                                                android:id="@+id/right_arrow_image"
                                                android:layout_width="50dp"
                                                android:layout_height="40dp"
                                                android:layout_alignParentRight="true"
                                                android:layout_centerVertical="true"
                                                android:src="@drawable/ic_right_arrow"
                                                android:visibility="visible" />


                                        </RelativeLayout>

                                    </FrameLayout>

                                    <!--<com.mysale.genie.views.custom.WishlistLayout-->
                                    <!--android:id="@+id/wishlist_layout"-->
                                    <!--android:layout_width="wrap_content"-->
                                    <!--android:layout_height="wrap_content"-->
                                    <!--android:layout_alignBottom="@id/image_container"-->
                                    <!--android:layout_alignParentRight="true"-->
                                    <!--android:clipChildren="false"-->
                                    <!--android:clipToPadding="false"-->
                                    <!--android:visibility="gone" />-->

                                    <!--<FrameLayout-->
                                        <!--android:id="@+id/wishlist_frame"-->
                                        <!--android:layout_width="match_parent"-->
                                        <!--android:layout_height="wrap_content"-->
                                        <!--android:layout_below="@id/image_container"-->
                                        <!--android:visibility="gone"-->
                                        <!--app:layout_anchor="@id/image_container"-->
                                        <!--app:layout_anchorGravity="bottom|right|end">-->

                                        <!--<ImageView-->
                                            <!--android:layout_width="match_parent"-->
                                            <!--android:layout_height="1px"-->
                                            <!--android:layout_gravity="center"-->
                                            <!--android:background="#23000000" />-->

                                        <!--<LinearLayout-->
                                            <!--android:layout_width="wrap_content"-->
                                            <!--android:layout_height="wrap_content"-->
                                            <!--android:layout_gravity="right"-->
                                            <!--android:layout_marginRight="3dp"-->
                                            <!--android:orientation="horizontal">-->

                                            <!--<ImageView-->
                                                <!--android:id="@+id/share_fab"-->
                                                <!--android:layout_width="50dp"-->
                                                <!--android:layout_height="50dp" />-->

                                            <!--<ImageView-->
                                                <!--android:id="@+id/wishlist_fab"-->
                                                <!--android:layout_width="50dp"-->
                                                <!--android:layout_height="50dp"-->
                                                <!--android:layout_marginBottom="5dp"-->
                                                <!--android:layout_marginRight="10dp"-->
                                                <!--android:clickable="true" />-->
                                        <!--</LinearLayout>-->
                                    <!--</FrameLayout>-->
                                    <LinearLayout
                                        android:id="@+id/name_price_category"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@id/image_container"
                                        android:layout_marginTop="-30dp"
                                        android:background="#67ffffff"
                                        android:orientation="vertical">

                                        <LinearLayout
                                            android:id="@+id/controller_product_details_title_description"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="@dimen/activity_vertical_margin"
                                            android:layout_marginLeft="10dp"
                                            android:layout_marginRight="10dp"
                                            android:layout_marginTop="@dimen/activity_vertical_margin">

                                            <LinearLayout
                                                android:layout_width="0px"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="2"
                                                android:orientation="vertical">

                                                <TextView
                                                    android:id="@+id/productName"
                                                    fontPath="@string/font_lato_semibold"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="start"
                                                    android:ellipsize="end"
                                                    android:text=""
                                                    android:textColor="@color/gray_item_details"
                                                    android:textSize="@dimen/text_size_xxxlarge" />

                                                <TextView
                                                    android:id="@+id/productBrand"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text=""
                                                    android:textColor="@color/gray_title_text"
                                                    android:textSize="@dimen/text_size_medium" />

                                            </LinearLayout>
                                        </LinearLayout>
                                    </LinearLayout>
                                </RelativeLayout>

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1px"
                                    android:layout_alignParentTop="true"
                                    android:layout_gravity="center"
                                    android:background="#23000000" />

                                <LinearLayout
                                    android:id="@+id/bottom_card"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:paddingBottom="20dp"
                                    android:visibility="gone">

                                    <RelativeLayout
                                        android:id="@+id/sizes"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:visibility="gone">

                                        <RelativeLayout
                                            android:id="@+id/sizeLabel"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content">

                                            <TextView
                                                fontPath="@string/font_lato_bold"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:paddingLeft="10dp"
                                                android:paddingRight="10dp"
                                                android:text="@string/choose_your_size"
                                                android:textColor="@color/gray_item_details"
                                                android:textSize="@dimen/text_size_large" />

                                            <ImageView
                                                android:id="@+id/question_mark"
                                                android:layout_width="15dp"
                                                android:layout_height="15dp"
                                                android:layout_alignParentRight="true"
                                                android:visibility="invisible" />

                                            <TextView
                                                fontPath="@string/font_lato_black"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_centerVertical="true"
                                                android:layout_toLeftOf="@id/question_mark"
                                                android:paddingRight="5dp"
                                                android:text="size guide"
                                                android:textSize="@dimen/text_size_medium"
                                                android:visibility="invisible" />

                                        </RelativeLayout>

                                        <com.zhy.view.flowlayout.TagFlowLayout
                                            android:id="@+id/sizeList"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_below="@+id/sizeLabel"
                                            android:layout_marginBottom="10dp"
                                            android:layout_marginTop="5dp"
                                            android:paddingLeft="10dp"
                                            android:paddingRight="10dp"
                                            app:max_select="1" />

                                        <ImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="1px"
                                            android:layout_alignParentBottom="true"
                                            android:layout_gravity="center"
                                            android:background="#23000000" />

                                    </RelativeLayout>

                                    <LinearLayout
                                        android:id="@+id/product_description_container"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:orientation="vertical">

                                        <WebView
                                            android:id="@+id/product_description_text"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent" />

                                    </LinearLayout>

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="1px"
                                        android:layout_gravity="center"
                                        android:background="#23000000" />

                                    <LinearLayout
                                        android:id="@+id/shipping_desc_container"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:orientation="vertical">

                                        <WebView
                                            android:id="@+id/shipping_desc_text"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="5dp"
                                            android:layout_marginTop="5dp" />

                                    </LinearLayout>

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="1px"
                                        android:layout_gravity="center"
                                        android:background="#23000000"
                                        android:visibility="gone" />

                                    <!--pickup points container-->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="@dimen/activity_horizontal_margin"
                                        android:orientation="vertical"
                                        android:visibility="gone">

                                        <TextView
                                            fontPath="@string/font_lato_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="available for"
                                            android:textColor="@color/gray_field_text"
                                            android:textSize="@dimen/text_size_medium" />

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="10dp"
                                            android:orientation="horizontal">

                                            <LinearLayout
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:orientation="horizontal">

                                                <ImageView
                                                    android:layout_width="30dp"
                                                    android:layout_height="30dp" />

                                                <TextView
                                                    fontPath="@string/font_lato_bold"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="center"
                                                    android:layout_marginLeft="5dp"
                                                    android:text="home or office delivery"
                                                    android:textColor="@color/gray_field_text"
                                                    android:textSize="@dimen/text_size_medium" />

                                            </LinearLayout>

                                            <LinearLayout
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginLeft="@dimen/activity_horizontal_margin">

                                                <ImageView
                                                    android:layout_width="30dp"
                                                    android:layout_height="30dp" />

                                                <TextView
                                                    fontPath="@string/font_lato_bold"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="center"
                                                    android:layout_marginLeft="5dp"
                                                    android:text="pick up point"
                                                    android:textColor="@color/gray_field_text"
                                                    android:textSize="@dimen/text_size_medium" />

                                            </LinearLayout>
                                        </LinearLayout>

                                    </LinearLayout>

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="1px"
                                        android:layout_gravity="center"
                                        android:background="#23000000" />

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="1px"
                                        android:layout_gravity="center"
                                        android:background="#23000000" />

                                    <LinearLayout
                                        android:id="@+id/aboutPricing"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_margin="10dp"
                                        android:orientation="vertical"
                                        android:visibility="gone">

                                        <TextView
                                            fontPath="@string/font_lato_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="@string/pricing"
                                            android:textColor="@color/gray_item_details"
                                            android:textSize="@dimen/text_size_large" />


                                        <WebView
                                            android:id="@+id/product_about_pricing"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="5dp" />


                                        <!--<com.example.customviewlib.GenieTextView-->
                                        <!--android:id="@+id/productAboutPricing"-->
                                        <!--android:layout_marginTop="10dp"-->
                                        <!--android:layout_width="match_parent"-->
                                        <!--android:layout_height="wrap_content"-->
                                        <!--fontPath="@string/font_lato"-->
                                        <!--android:textSize="@dimen/text_size_small" />-->
                                    </LinearLayout>

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="1px"
                                        android:layout_gravity="center"
                                        android:background="#23000000"
                                        android:visibility="gone" />

                                    <LinearLayout
                                        android:id="@+id/relatedItemsContainer"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="10dp"
                                        android:orientation="vertical"
                                        android:visibility="gone">

                                        <TextView
                                            fontPath="@string/font_lato_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="related items"
                                            android:textSize="@dimen/text_size_small" />

                                        <android.support.v7.widget.RecyclerView
                                            android:id="@+id/relatedItemsRecyclerView"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="15dp"
                                            android:paddingRight="10dp" />
                                    </LinearLayout>

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="1px"
                                        android:layout_gravity="center"
                                        android:background="#23000000"
                                        android:visibility="gone" />

                                    <LinearLayout
                                        android:id="@+id/customersAlsoBoughtContainer"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="10dp"
                                        android:orientation="vertical"
                                        android:visibility="gone">

                                        <TextView
                                            fontPath="@string/font_lato_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="customers also bought"
                                            android:textSize="@dimen/text_size_small" />

                                        <android.support.v7.widget.RecyclerView
                                            android:id="@+id/customersAlsoBoughtRecyclerView"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="15dp"
                                            android:paddingRight="10dp" />
                                    </LinearLayout>


                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="1px"
                                        android:layout_gravity="center"
                                        android:background="#23000000"
                                        android:visibility="gone" />

                                    <RelativeLayout
                                        android:id="@+id/reviewsContainer"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="10dp"
                                        android:visibility="gone">

                                        <TextView
                                            fontPath="@string/font_lato_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="reviews"
                                            android:textSize="@dimen/text_size_medium" />

                                        <android.support.design.widget.FloatingActionButton
                                            android:id="@+id/edit_review_fab"
                                            android:layout_width="40dp"
                                            android:layout_height="40dp"
                                            android:layout_alignParentRight="true"
                                            android:layout_marginRight="5dp"
                                            android:layout_marginTop="5dp"
                                            android:clickable="true"
                                            android:scaleType="fitXY"
                                            app:backgroundTint="#ffffff" />

                                        <android.support.v7.widget.RecyclerView
                                            android:id="@+id/reviewsRecyclerView"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentLeft="true"
                                            android:layout_below="@id/edit_review_fab" />

                                        <TextView
                                            android:id="@+id/see_more_text"
                                            fontPath="@string/font_lato_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_below="@id/reviewsRecyclerView"
                                            android:text="see more"
                                            android:textSize="@dimen/text_size_medium" />
                                    </RelativeLayout>

                                </LinearLayout>

                            </LinearLayout>

                        </RelativeLayout>

                        <TextView
                            android:id="@+id/discountLabel"
                            fontPath="@string/font_lato_black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:paddingBottom="14dp"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:paddingTop="14dp"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:visibility="invisible"
                            tools:ignore="MissingPrefix" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginTop="10dp"
                            android:layout_gravity="right"
                            android:layout_marginRight="-5dp"
                            android:paddingRight="10dp"
                            android:clickable="false"
                            android:focusable="false"
                            android:paddingLeft="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:background="@drawable/bg_sale_details_price_background"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/productPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:maxLines="1"
                                android:text=""
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_xxxxlarge" />

                            <TextView
                                android:id="@+id/productPreviousPrice"
                                fontPath="@string/font_lato_light"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:maxLines="1"
                                android:text=""
                                android:textColor="#FBFBFB"
                                android:textSize="@dimen/text_size_large" />

                        </LinearLayout>

                    </FrameLayout>
                </LinearLayout>

            </android.support.v4.widget.NestedScrollView>

            <Button
                android:id="@+id/product_details_add_to_basket"
                style="@style/DDButtonStyle"
                fontPath="@string/font_lato_medium"
                android:layout_width="match_parent"
                android:layout_gravity="bottom"
                android:layout_margin="@dimen/activity_horizontal_margin"
                android:text="@string/add_to_basket" />

        </android.support.design.widget.CoordinatorLayout>

    </RelativeLayout>
</au.com.dealsdirect.ui.controller.saleitemdetails.SaleItemDetailsView>
