<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/dialog_icon_picker_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textColor="@color/colorAccent"
        android:textSize="@dimen/text_size_headline2" />

    <android.support.v7.widget.RecyclerView
        android:id="@+id/dialog_icon_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/dialog_icon_picker_header"
        android:overScrollMode="never" />

    <Button
        android:id="@+id/dialog_icon_picker_negative"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_below="@+id/dialog_icon_recycler"
        android:background="@null"
        android:text="@string/cancel" />

</RelativeLayout>