<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:contentInsetStart="0dp"
    android:contentInsetLeft="0dp"
    android:contentInsetEnd="0dp"
    android:contentInsetRight="0dp"
    app:contentInsetEnd="0dp"
    app:contentInsetLeft="0dp"
    app:contentInsetRight="0dp"
    app:contentInsetStart="0dp"
    android:background="@color/white"
    tools:ignore="MissingPrefix"
    android:id="@+id/partial_logo_toolbar">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <ImageButton
                android:id="@+id/partial_toolbar_checkout"
                android:layout_width="@dimen/partial_toolbar_button_width"
                android:layout_height="@dimen/partial_toolbar_button_height"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:background="@drawable/bg_toolbar_button"
                android:src="@drawable/ic_new_checkout"
                android:textSize="@dimen/text_size_caption1"
                app:tint="@color/black" />

            <RelativeLayout
                android:id="@+id/partial_toolbar_badge"
                android:layout_marginLeft="25dp"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:background="@drawable/circle_indicator_active"
                android:backgroundTint="@color/fluorescent_blue"
                android:visibility="gone">

                <TextView
                    android:id="@+id/partial_toolbar_badge_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_centerInParent="true"
                    android:textColor="@color/black"
                    android:textSize="10dp"/>

            </RelativeLayout>

        </RelativeLayout>

        <ImageView
            android:id="@+id/partial_toolbar_logo"
            android:layout_width="@dimen/partial_toolbar_logo_width"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:scaleType="centerInside"
            android:src="@drawable/logo_colored" />

        <ImageButton
            android:id="@+id/partial_toolbar_search"
            android:layout_width="@dimen/partial_toolbar_button_width"
            android:layout_height="@dimen/partial_toolbar_button_height"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_toolbar_button"
            android:paddingTop="8dp"
            android:paddingBottom="2dp"
            android:scaleType="fitCenter"
            android:textSize="@dimen/text_size_caption1"
            android:src="@drawable/ic_search"
            app:tint="@color/black" />

    </RelativeLayout>

</androidx.appcompat.widget.Toolbar>
