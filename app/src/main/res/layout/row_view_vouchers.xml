<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/view_voucher_card_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:ignore="MissngPrefix">

    <LinearLayout
        android:id="@+id/row_layout_vouchers"
        android:layout_width="@dimen/voucher_container_width"
        android:layout_height="@dimen/voucher_container_height"
        android:layout_centerInParent="true"
        android:gravity="center_vertical"
        android:layout_margin="8dp"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="@dimen/activity_horizontal_margin"
        tools:ignore="UselessParent">

        <TextView
            android:id="@+id/row_text_vouchers_item_cost_value"
            android:fontFamily="@string/font_lato_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_xxxxlarge"
            android:textStyle="bold"
            android:textColor="@color/white"
            tools:text="$10" />

        <TextView
            android:fontFamily="@string/font_lato_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_xxlarge"
            android:textColor="@color/white"
            android:text="value" />

        <TextView
            android:id="@+id/row_text_vouchers_item_desc"
            android:fontFamily="@string/font_lato_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_small"
            tools:text="voucher good for use until," />

        <TextView
            android:id="@+id/row_text_vouchers_item_expires_on_value"
            android:fontFamily="@string/font_lato_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_small"
            tools:text="January 15" />

    </LinearLayout>
</RelativeLayout>