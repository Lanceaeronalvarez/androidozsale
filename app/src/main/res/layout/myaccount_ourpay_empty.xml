<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ourpay_header_height_for_empty_view">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/myaccount_ourpay_header_bg" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_myaccount_ourpay_logo" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/linearLayout2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ourpay_empty_view_content_margin"
                android:layout_marginTop="@dimen/ourpay_empty_view_content_margin"
                android:layout_marginEnd="@dimen/ourpay_empty_view_content_margin"
                android:layout_marginBottom="@dimen/ourpay_empty_view_content_margin"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/infoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/ourpay_empty_view_text"
                    android:textAlignment="center"
                    android:textSize="@dimen/text_size_caption1" />

                <Button
                    android:id="@+id/myAccountsOurpayInfoButton"
                    android:layout_width="@dimen/ourpay_empty_view_button_width"
                    android:layout_height="@dimen/ourpay_empty_view_button_height"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/ourpay_empty_view_button_gap"
                    android:background="@drawable/bg_myaccount_ourpay_info_button"
                    android:text="Information Page"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_caption1"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/myAccountsOurpayTermsAndConditionsButton"
                    android:layout_width="@dimen/ourpay_empty_view_button_width"
                    android:layout_height="@dimen/ourpay_empty_view_button_height"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_myaccount_ourpay_tas_button"
                    android:text="Terms and Conditions"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_caption1"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>