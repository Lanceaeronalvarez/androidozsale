<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/no_contacts_placeholder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_contact_us_placeholder" />

    <TextView
        fontPath="@string/font_lato_semibold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="welcome to contact us!"
        android:textSize="@dimen/text_size_xxxlarge" />

    <TextView
        fontPath="@string/font_lato_semibold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/default_button_height"
        android:layout_marginTop="10dp"
        android:paddingBottom="@dimen/default_button_height"
        android:text="you do not currently have any messages."
        android:textColor="#D0D0D0"
        android:textSize="@dimen/text_size_xxlarge" />

</LinearLayout>
