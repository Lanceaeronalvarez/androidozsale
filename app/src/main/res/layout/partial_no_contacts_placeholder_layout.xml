<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/no_contacts_placeholder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerInParent="true"
    android:orientation="vertical"
    android:paddingLeft="@dimen/place_holder_padding"
    android:paddingRight="@dimen/place_holder_padding"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/placeholder_icon_size"
            android:layout_height="@dimen/placeholder_icon_size"
            android:layout_gravity="center"
            android:src="@drawable/ic_contact_us_placeholder" />

        <TextView
            fontPath="@string/font_app_medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="welcome to contact us!"
            android:textSize="@dimen/text_size_xxxlarge" />

        <TextView
            fontPath="@string/font_app_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginBottom="@dimen/default_button_height"
            android:layout_marginTop="10dp"
            android:paddingBottom="@dimen/default_button_height"
            android:text="you do not currently have any messages"
            android:textColor="#9f9f9f"
            android:textSize="@dimen/text_size_xlarge" />
    </LinearLayout>

</RelativeLayout>
