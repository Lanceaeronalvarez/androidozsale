<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/no_contacts_placeholder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerInParent="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="@dimen/placeholder_padding"
    android:paddingRight="@dimen/placeholder_padding"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/placeholder_icon_width"
            android:layout_height="@dimen/placeholder_icon_height"
            android:layout_gravity="center"
            android:visibility="@integer/no_items_placeholder_icon_visibility"
            android:src="@drawable/ic_contact_us_placeholder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="@dimen/text_size_headline1"
            android:textColor="@color/text_extra_dark"
            android:text="@string/welcome_remark_title_contact_us"/>

        <TextView
            fontPath="@string/font_app_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="@dimen/padding_default"
            android:text="@string/welcome_remark_subtitle_contact_us"
            android:textColor="@color/text_medium"
            android:textSize="@dimen/text_size_headline3" />
    </LinearLayout>

</RelativeLayout>
