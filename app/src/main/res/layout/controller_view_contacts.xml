<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include
        android:id="@+id/view_contacts_toolbar_layout"
        layout="@layout/partial_toolbar_arrow" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <android.support.v7.widget.RecyclerView
            android:id="@+id/contacts_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:visibility="gone" />

        <Button
            android:id="@+id/controller_view_contacts_add_button"
            style="@style/DDButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/default_button_height"
            android:layout_alignParentBottom="true"
            android:layout_margin="@dimen/activity_horizontal_margin"
            android:clickable="true"
            android:text="@string/write_us_a_message"
            android:visibility="gone" />

        <include
            layout="@layout/partial_no_contacts_placeholder_layout"
            android:visibility="gone" />

    </RelativeLayout>

</LinearLayout>