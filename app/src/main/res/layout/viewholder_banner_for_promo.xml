<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewholder_banner_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <ImageView
        android:id="@+id/viewholder_banner_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/viewholder_banner_info_group"
        android:transitionName="image" />

    <LinearLayout
        android:id="@+id/viewholder_banner_info_group"
        android:layout_width="match_parent"
        android:layout_height="@dimen/banner_sale_info_height"
        android:background="#ffffff"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/viewholder_banner_name"
            fontPath="@string/font_app_bold"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="10dp"
            android:textAllCaps="true"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_size_caption1"
            android:textStyle="bold"
            tools:text="Atom Pro Compression" />

    </LinearLayout>

    <TextView
        android:id="@+id/viewholder_banner_discount"
        fontPath="@string/font_app_regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_banner_discount"
        android:gravity="center"
        android:paddingLeft="@dimen/margin_small"
        android:paddingTop="@dimen/margin_tiny"
        android:paddingRight="@dimen/margin_small"
        android:paddingBottom="@dimen/margin_tiny"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_caption1"
        app:layout_constraintBottom_toTopOf="@id/viewholder_banner_info_group"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/viewholder_banner_info_group"
        tools:text="Up To 50% Off" />

</androidx.constraintlayout.widget.ConstraintLayout>