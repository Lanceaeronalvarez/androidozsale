<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:id="@+id/my_contact_select_subject_recycler_row_layout"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:background="@drawable/bg_account_item"
              android:paddingTop="20dp"
              android:paddingLeft="20dp"
              android:paddingRight="20dp"
              android:paddingBottom="20dp"
              android:layout_marginBottom="20dp">

    <RelativeLayout
        android:id="@+id/contact_subject_checker_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/contact_subject_row_item_name"
            android:fontFamily="@string/font_lato_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="ergo"
            android:textColor="#616161"/>

        <ImageView
            android:id="@+id/contact_subject_row_item_check_image_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/contact_subject_row_item_name"
            android:layout_alignBottom="@+id/contact_subject_row_item_name"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:alpha="0"
            android:scaleX="0"
            android:scaleY="0"/>


    </RelativeLayout>
</LinearLayout>