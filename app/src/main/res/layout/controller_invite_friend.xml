<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:ignore="MissingPrefix">

    <include android:id="@+id/controller_invite_layout_title"
        layout="@layout/partial_toolbar_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/controller_invite_layout_title"
        android:layout_centerInParent="true"
        android:layout_above="@+id/controller_invite_friend_button_send_invite"
        android:gravity="center_vertical|center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/controller_invite_image_vouchers"
            android:layout_width="wrap_content"
            android:layout_height="250dp"
            android:layout_marginLeft="@dimen/activity_horizontal_margin"
            android:layout_marginRight="@dimen/activity_horizontal_margin" />

        <TextView
            fontPath="@string/font_lato_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/invite_friend_guide"
            android:layout_margin="@dimen/activity_horizontal_margin"
            android:lineSpacingExtra="5dp"
            android:textSize="@dimen/text_size_large" />

    </LinearLayout>


    <Button
        android:id="@+id/controller_invite_friend_button_send_invite"
        style="@style/DDButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/default_button_height"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:text="send an invite"
        android:textSize="@dimen/text_size_xxlarge" />

</RelativeLayout>
