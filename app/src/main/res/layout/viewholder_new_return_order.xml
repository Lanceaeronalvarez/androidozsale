<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              tools:ignore="HardcodedText,MissingPrefix">

    <RelativeLayout
        android:id="@+id/new_return_item_set_detail_container"
        android:clickable="true"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:layout_marginTop="20dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/new_return_set_detail_item_image"
                android:layout_width="70dp"
                android:layout_height="100dp"
                android:scaleType="fitStart"
                android:padding="5dp"/>

            <RelativeLayout
                android:id="@+id/new_return_item_detail_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp">

                <TextView
                    android:fontFamily="@string/font_lato_regular"
                    android:id="@+id/new_return_request_item_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingRight="30dp"
                    android:textColor="#878787"
                    android:text="Philosophy Cotton Sleeveless Plain"
                    android:textSize="@dimen/text_size_large"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:orientation="vertical"
                    android:layout_below="@+id/new_return_request_item_name">

                    <!--<com.mysale.genie.views.custom.GenieTextView-->
                    <!--app:font="@string/fontname_lato_bold"-->
                    <!--android:id="@+id/set_detail_dollar_sign"-->
                    <!--android:layout_width="wrap_content"-->
                    <!--android:layout_height="wrap_content"-->
                    <!--android:textSize="@dimen/new_return_request_set_detail_item_total_cost"-->
                    <!--android:textColor="#FF785F"-->
                    <!--android:text="$"/>-->

                    <TextView
                        android:fontFamily="@string/font_lato_regular"
                        android:id="@+id/new_return_request_item_total_cost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FF785F"
                        android:text="89.00"
                        android:textSize="@dimen/text_size_medium"
                        tools:ignore="HardcodedText"/>

                    <RelativeLayout
                        android:id="@+id/new_returns_order_item_total_cost_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_below="@+id/new_return_request_item_total_cost">

                        <TextView
                            android:fontFamily="@string/font_lato_regular"
                            android:id="@+id/new_returns_order_item_count_identifier"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#b7b7b7"
                            android:text="Item Count:"
                            android:textSize="@dimen/text_size_large"
                            tools:ignore="HardcodedText"/>

                        <TextView
                            android:fontFamily="@string/font_lato_regular"
                            android:id="@+id/new_returns_order_item_count_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#9e9e9e"
                            android:text="0"
                            android:layout_marginLeft="2dp"
                            android:textSize="@dimen/text_size_large"
                            android:layout_toRightOf="@+id/new_returns_order_item_count_identifier"
                            android:layout_toEndOf="@+id/new_returns_order_item_count_identifier"
                            android:layout_alignTop="@+id/new_returns_order_item_count_identifier"
                            tools:ignore="HardcodedText"/>

                    </RelativeLayout>


                    <RelativeLayout
                        android:id="@+id/new_returns_order_item_id_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_marginTop="2dp"
                        android:layout_below="@+id/new_returns_order_item_total_cost_detail">

                        <TextView
                            android:fontFamily="@string/font_lato_regular"
                            android:id="@+id/new_returns_order_item_id_identifier"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:textColor="#b7b7b7"
                            android:text="Item id:"
                            tools:ignore="HardcodedText"/>


                        <TextView
                            android:fontFamily="@string/font_lato_regular"
                            android:id="@+id/new_returns_order_item_id_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#acacac"
                            android:text="0"
                            android:layout_marginLeft="2dp"
                            android:textSize="@dimen/text_size_large"
                            android:layout_toRightOf="@+id/new_returns_order_item_id_identifier"
                            android:layout_toEndOf="@+id/new_returns_order_item_id_identifier"
                            android:layout_alignTop="@+id/new_returns_order_item_id_identifier"
                            tools:ignore="HardcodedText"/>

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/new_returns_order_item_size_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_below="@+id/new_returns_order_item_id_detail">

                        <TextView
                            android:fontFamily="@string/font_lato_regular"
                            android:id="@+id/new_returns_order_item_size_identifier"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#b7b7b7"
                            android:text="Size:"
                            android:textSize="@dimen/text_size_large"
                            tools:ignore="HardcodedText"/>

                        <TextView
                            android:fontFamily="@string/font_lato_regular"
                            android:id="@+id/new_returns_order_size_return_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#acacac"
                            android:text="$12.00"
                            android:layout_marginLeft="2dp"
                            android:textSize="@dimen/text_size_large"
                            android:layout_toRightOf="@+id/new_returns_order_item_size_identifier"
                            android:layout_toEndOf="@+id/new_returns_order_item_size_identifier"
                            android:layout_alignTop="@+id/new_returns_order_item_size_identifier"
                            tools:ignore="HardcodedText"/>

                    </RelativeLayout>


                    <au.com.dealsdirect.ui.custom.ProductQuantityLayout
                        android:id="@+id/new_returns_select_order_item_quantaty_selector"
                        android:gravity="center"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">
                    </au.com.dealsdirect.ui.custom.ProductQuantityLayout>

                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>

    <View
        android:id="@+id/my_returns_set_detail_item_divider"
        android:layout_width="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_height="0.5dp"
        android:background="#d9d9d9"/>

</LinearLayout>