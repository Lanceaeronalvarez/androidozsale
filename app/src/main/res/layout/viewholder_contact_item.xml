<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/my_contact_us_recycler_row_item_layout"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="20dp"
    android:clickable="true"
    android:background="@drawable/bg_account_item">

    <LinearLayout
        android:id="@+id/my_contact_item_container_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="5dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">


        <RelativeLayout
            android:id="@+id/my_contact_us_row_layout"
            android:layout_width="match_parent"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/my_contact_us_row_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/my_contact_us_row_title_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Puma Designer Collaboration"
                    android:textColor="#7e7e7e"/>

                <TextView
                    android:id="@+id/my_contact_us_row_item_time_stamp_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:textSize="12sp"
                    android:text="06:57pm"
                    android:textColor="#b3b3b3"/>
            </RelativeLayout>


            <TextView
                android:id="@+id/my_contact_us_row_description_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text=""
                android:textColor="#a4a4a4"
                android:layout_below="@+id/my_contact_us_row_header"/>

        </RelativeLayout>
    </LinearLayout>

    <View
        android:id="@+id/my_contact_us_fragment_row_item_divider"
        android:layout_marginLeft="20dp"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#e9e9e9"/>

</LinearLayout>