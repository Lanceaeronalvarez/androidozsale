<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:id="@+id/root_base_toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        app:behavior_hideable="true"
        android:orientation="vertical"
        app:layout_behavior="com.mysale.genie.views.custom.CoordinatorLayoutAsBottomSheetBehavior">

        <include layout="@layout/base_toolbar" />

        <android.support.v4.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:orientation="vertical"
            android:layout_below="@+id/swipeable_base_toolbar"
            android:overScrollMode="never"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/controller_base_content_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <include layout="@layout/partial_no_network_layout" />
            </FrameLayout>


        </android.support.v4.widget.NestedScrollView>


    </LinearLayout>
</android.support.design.widget.CoordinatorLayout>