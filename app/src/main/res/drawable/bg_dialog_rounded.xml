<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="2dp"
        android:left="3dp">
        <shape>
            <gradient android:angle="90"
                android:startColor="#d2d2d2"
                android:centerColor="#a6a6a6"
                android:endColor="#d2d2d2"
                android:type="linear"/>
            <corners android:radius="10dp" />
            <padding
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/bg_dialog_default" />
        </shape>
    </item>
</layer-list>