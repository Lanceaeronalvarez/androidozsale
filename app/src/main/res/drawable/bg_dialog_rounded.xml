<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="5dp"
        android:left="5dp">
        <shape>
            <gradient android:startColor="#E2E2E2" android:endColor="#BABABA" />
            <stroke
                android:width="1dp"
                android:color="#BABABA" />
            <corners android:radius="10dp" />
            <padding
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/bg_dialog_default" />
        </shape>
    </item>
</layer-list>