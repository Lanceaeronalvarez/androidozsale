<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/bg_button_ripple">
    <item>
        <selector>

            <item android:state_enabled="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/edit_text_corner_radius"/>
                    <solid android:color="@color/bg_button_pay_default"/>
                </shape>
            </item>

            <item android:state_enabled="true" android:state_pressed="true">

                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/edit_text_corner_radius"/>
                    <solid android:color="@color/bg_button_pay_pressed"/>
                </shape>
            </item>

            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/edit_text_corner_radius"/>
                    <solid android:color="@color/bg_button_pay_disabled"/>
                </shape>
            </item>


        </selector>
    </item>
</ripple>

