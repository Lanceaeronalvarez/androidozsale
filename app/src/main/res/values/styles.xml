<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/colorAccent</item>
        <item name="android:colorEdgeEffect">@color/recyclerview_overscroll</item>
    </style>

    <!--Floating activity theme -->
    <style name="App_Theme_Translucent" parent="AppTheme">

        <item name="android:windowNoTitle">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="DatePickerTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorPrimaryDark">@color/colorAccent</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="horizontalBorderView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/border_thin</item>
        <item name="android:background">@color/border_regular</item>
    </style>

    <style name="verticalBorderView" parent="horizontalBorderView">
        <item name="android:layout_width">@dimen/border_thin</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="parentLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/background_default</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="DDButtonStyle">
        <item name="android:layout_height">@dimen/button_height_regular</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_button_rounded</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">@dimen/margin_small</item>
        <item name="android:textSize">@dimen/text_size_headline2</item>
    </style>

    <style name="DDButtonStyleTransparent">
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@drawable/bg_button_rounded_transparent</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DDButtonStyleExtraRoundedTransparent">
        <item name="android:height">@dimen/button_extra_rounded_height</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@drawable/bg_button_extra_rounded_transparent</item>
        <item name="android:textAllCaps">false</item>
    </style>


    <style name="DDJoinNowButtonStyle" parent="DDButtonStyle">
        <item name="android:background">@drawable/bg_button_join_now</item>
    </style>

    <style name="DDButtonPayCart" parent="DDButtonStyle">
        <item name="android:background">@drawable/bg_button_pay</item>
    </style>

    <style name="DDTutorialButtonStyle">
        <item name="android:layout_height">@dimen/button_height_regular</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_tutorial_button_rounded</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">15dp</item>
        <item name="android:textSize">@dimen/text_size_headline3</item>
    </style>

    <style name="DDEditTextStyle">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:layout_height">@dimen/edit_text_height</item>
        <item name="android:textColor">@color/text_extra_dark</item>
        <item name="android:padding">15dp</item>
        <item name="android:background">@drawable/bg_edit_text_rounded</item>
        <item name="android:textColorHint">@color/text_extra_light</item>
    </style>

    <style name="TextViewStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:lines">1</item>
        <item name="android:textColor">@color/category_text_selector</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>
    <style name="DDSpinnerTextStyle">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:height">@dimen/edit_text_height</item>
        <item name="android:textColor">@color/text_light</item>
        <item name="android:background">@drawable/bg_drop_down_rounded</item>
        <item name="android:textColorHint">@color/text_medium</item>
    </style>

    <style name="AppearDialog" parent="Base.Theme.AppCompat.Light.Dialog" >
        <item name="android:background">#00000000</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:footerDividersEnabled">false</item>
        <item name="android:headerDividersEnabled">false</item>
        <item name="android:windowEnterAnimation">@anim/fadein</item>
        <item name="android:windowExitAnimation">@anim/fadeout</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">false</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="CancelOrderDialog" parent="Base.Theme.AppCompat.Light.Dialog" >
        <item name="android:background">@color/white</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:footerDividersEnabled">false</item>
        <item name="android:headerDividersEnabled">false</item>
        <item name="android:windowEnterAnimation">@anim/fadein</item>
        <item name="android:windowExitAnimation">@anim/fadeout</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">false</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="MyCustomTabLayout" parent="Widget.Design.TabLayout">
        <item name="tabIndicatorColor">@color/colorAccent</item>
        <item name="tabBackground">?android:attr/selectableItemBackground</item>
        <item name="tabSelectedTextColor">?android:textColorPrimary</item>
        <item name="tabTextAppearance">@android:style/TextAppearance.Widget.TabWidget</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Search bar visibility -->
    <bool name="shop_searchbar_visibility">true</bool>

    <!-- Tool bar visibility -->
    <bool name="shop_toolbar_visibility">true</bool>
    <bool name="saleItems_toolbar_visibility">true</bool>
    <bool name="sample_toolbar_visibility">true</bool>
    <bool name="contacts_toolbar_visibility">true</bool>
    <bool name="address_toolbar_visibility">true</bool>
    <bool name="details_toolbar_visibility">true</bool>
    <bool name="languages_toolbar_visibility">true</bool>
    <bool name="countries_toolbar_visibility">true</bool>
    <bool name="orders_toolbar_visibility">true</bool>
    <bool name="vouchers_toolbar_visibility">true</bool>
    <bool name="returns_toolbar_visibility">true</bool>
    <bool name="payselect_toolbar_visibility">true</bool>
    <bool name="invite_toolbar_visibility">true</bool>
    <bool name="legalities_toolbar_visibility">true</bool>
    <bool name="webview_toolbar_visibility">true</bool>
    <bool name="login_toolbar_visibility">false</bool>


    <!-- Tool bar accessory visibility -->
    <bool name="contacts_toolbar_addmessage_visibility">true</bool>

    <style name="RecyclerViewPagerVouchersStyle" >
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingLeft">@dimen/voucher_padding</item>
        <item name="android:paddingRight">@dimen/voucher_padding</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="DDEditTextSearchBar" parent="DDEditTextStyle" >
        <item name="android:background">@drawable/bg_edit_text_plain</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:height">@dimen/edit_text_height</item>
        <item name="android:textColor">@color/text_medium</item>
        <item name="android:padding">@dimen/margin_small</item>
    </style>


    <style name="DDEditTextStyleNoBorder" parent="DDEditTextStyle">
        <item name="android:background">@drawable/bg_edit_text_plain</item>
    </style>

    <integer name="sale_items_threshold">4</integer>

    <bool name="is_account_invite_visible">false</bool>
    <bool name="is_account_contact_visible">false</bool>

    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/status_bar_splash</item>
    </style>

    <style name="MyAccountsOurpayTabLayout" parent="Widget.Design.TabLayout">
        <item name="tabBackground">@color/white</item>
        <item name="tabMaxWidth">0dp</item>
        <item name="tabIndicatorColor">@color/ourpay_circle_state_color_active</item>
        <item name="tabIndicatorHeight">4dp</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
        <item name="tabTextColor">@color/text_dark</item>
        <item name="tabSelectedTextColor">@color/ourpay_circle_state_color_active</item>
        <item name="tabTextAppearance">@style/MyAccountsOurpayTabTextAppearance</item>
    </style>

    <style name="MyAccountsOurpayTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">@string/font_app_regular</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:singleLine">true</item>
    </style>


    <!--Bottom sheet-->
    <style name="BottomSheet" parent="@style/Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet_dialog</item>
    </style>

    <style name="TransparentBottomSheet" parent="@style/Widget.Design.BottomSheet.Modal">
        <item name="android:background">@color/transparent</item>
    </style>

    <style name="BaseBottomSheetDialog" parent="@style/Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/BottomSheet</item>
    </style>

    <style name="TransparentBackgroundBottomSheetDialog" parent="@style/Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/TransparentBottomSheet</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="BaseBottomSheetDialog" />
    <style name="BottomSheetDialogTransparentBackgroundTheme" parent="TransparentBackgroundBottomSheetDialog" />

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />


    <style name="expiration_date_dialog_sheet" parent="@android:style/Theme.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowAnimationStyle">@style/expiration_date_dialog_sheet_animation</item>
    </style>

    <style name="expiration_date_dialog_sheet_animation">
        <item name="android:windowEnterAnimation">@anim/expiration_date_dialog_open</item>
        <item name="android:windowExitAnimation">@anim/expiration_date_dialog_close</item>
    </style>

    <style name="expiration_date_dialog_label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:paddingTop">@dimen/expiration_date_sheet_label_padding_top</item>
        <item name="android:paddingBottom">@dimen/expiration_date_sheet_label_padding_bottom</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/expiration_date_dialog_label</item>
    </style>

    <style name="expiration_date_dialog_grid_view">
        <item name="android:layout_marginLeft">@dimen/expiration_date_sheet_left_right_margin</item>
        <item name="android:layout_marginStart" tools:targetApi="jelly_bean_mr1">@dimen/expiration_date_sheet_left_right_margin</item>
        <item name="android:layout_marginRight">@dimen/expiration_date_sheet_left_right_margin</item>
        <item name="android:layout_marginEnd" tools:targetApi="jelly_bean_mr1">@dimen/expiration_date_sheet_left_right_margin</item>
        <item name="android:layout_marginBottom">@dimen/expiration_date_sheet_top_bottom_margin</item>
        <item name="android:listSelector">@android:color/transparent</item>
        <item name="android:choiceMode">singleChoice</item>
        <item name="android:numColumns">auto_fit</item>
        <item name="android:columnWidth">72dp</item>
    </style>

    <style name="expiration_date_dialog_year_grid_view" parent="expiration_date_dialog_grid_view">
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingEnd" tools:targetApi="jelly_bean_mr1">8dp</item>
        <item name="android:paddingStart" tools:targetApi="jelly_bean_mr1">0dp</item>
        <item name="android:scrollbarSize">3dp</item>
        <item name="android:scrollbarStyle">outsideOverlay</item>
        <item name="android:fadeScrollbars">false</item>
        <item name="android:scrollbarAlwaysDrawVerticalTrack">true</item>
    </style>

    <style name="expiration_date_dialog_light" parent="expiration_date_dialog_sheet">
        <item name="expiration_date_sheet_background">@color/expiration_date_sheet_background_light</item>
        <item name="expiration_date_dialog_label">@color/black_54</item>
        <item name="expiration_date_dialog_divider">@color/black_12</item>
        <item name="expiration_date_scrollbar_thumb_vertical">@color/black_54</item>
        <item name="expiration_date_scrollbar_track_vertical">@color/black_12</item>
    </style>

    <style name="expiration_date_dialog_dark" parent="expiration_date_dialog_sheet">
        <item name="expiration_date_sheet_background">@color/expiration_date_sheet_background_dark</item>
        <item name="expiration_date_dialog_label">@color/white_54</item>
        <item name="expiration_date_dialog_divider">@color/white_12</item>
        <item name="expiration_date_scrollbar_thumb_vertical">@color/white_54</item>
        <item name="expiration_date_scrollbar_track_vertical">@color/white_12</item>
    </style>

</resources>
