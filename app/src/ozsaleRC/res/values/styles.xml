<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="parentLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/gray_background</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="DDEditTextPlainStyle">
        <item name="android:padding">@dimen/text_padding</item>
    </style>

    <style name="DDEditTextStyle" parent="DDEditTextPlainStyle">
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:height">@dimen/edit_text_height</item>
        <item name="android:textColor">@color/gray_active_field_text</item>
        <item name="android:padding">15dp</item>
        <item name="android:background">@drawable/bg_edit_text_rounded</item>
        <item name="android:textColorHint">@color/gray_inactive_field_text</item>
    </style>

    <style name="DDButtonStyle">
        <item name="android:layout_height">@dimen/default_button_height</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">5dp</item>
        <item name="android:textSize">@dimen/text_size_xxlarge</item>
    </style>

    <style name="DDButtonAddCart" parent="DDButtonStyle">
        <item name="android:background">@drawable/bg_button_rounded</item>
    </style>

    <style name="DDButtonJoinNow" parent="DDButtonStyle">
        <item name="android:background">@drawable/bg_button_join_now</item>
    </style>

</resources>