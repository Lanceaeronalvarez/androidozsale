<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="horizontalBorderView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/border_thin</item>
        <item name="android:background">@color/border_regular</item>
    </style>

    <style name="verticalBorderView" parent="horizontalBorderView">
        <item name="android:layout_width">@dimen/border_thin</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="parentLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/background_default</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="DDEditTextPlainStyle">
        <item name="android:padding">@dimen/edit_text_padding</item>
    </style>

    <style name="DDEditTextStyle" parent="DDEditTextPlainStyle">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:height">@dimen/edit_text_height</item>
        <item name="android:textColor">@color/text_extra_dark</item>
        <item name="android:padding">15dp</item>
        <item name="android:textColorHint">@color/text_extra_light</item>
    </style>

    <style name="DDEditTextStyleNoBorder" parent="DDEditTextStyle">
        <item name="android:background">@drawable/bg_edit_text_plain</item>
    </style>

    <style name="DDEditTextStyleBorder" parent="DDEditTextStyle" >
        <item name="android:background">@drawable/bg_edit_text_rounded</item>
    </style>

    <style name="DDEditTextSearchBar" parent="DDEditTextStyle" >
        <item name="android:background">@drawable/bg_edit_text_rounded</item>
    </style>

    <style name="DDButtonStyle">
        <item name="android:layout_height">@dimen/button_height_regular</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_default_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">5dp</item>
        <item name="android:textSize">@dimen/text_size_headline2</item>
        <item name="fontPath">@string/font_app_semibold</item>
    </style>

    <style name="DDButtonAddCart" parent="DDButtonStyle">
        <item name="android:background">@drawable/bg_button_rounded</item>
    </style>

    <style name="DDButtonJoinNow" parent="DDButtonStyle">
        <item name="android:background">@drawable/bg_button_join_now</item>
    </style>

    <!-- Toolbar visibility -->
    <bool name="login_toolbar_visibility">true</bool>
    <bool name="contacts_toolbar_addmessage_visibility">false</bool>

</resources>
