<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
        android:color="@color/bg_chips_ripple">
    <item>
        <selector>

            <item android:state_checked="true" android:state_enabled="true">

                <shape android:shape="rectangle">
                    <solid android:color="@color/bg_chips_default"/>
                    <stroke android:width="@dimen/border_thin" android:color="@color/black"/>
                </shape>
            </item>

            <item android:state_checked="false" android:state_enabled="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/bg_chips_default"/>
                    <stroke android:width="@dimen/border_thin" android:color="@color/gray_field_text"/>
                </shape>
            </item>

        </selector>
    </item>
</ripple>
