<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/bg_button_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <stroke android:color="@color/border_gray" android:width="@dimen/border_extra_thin"/>
                    <solid android:color="@color/border_gray"/>
                </shape>
            </item>
            <item android:state_selected="false">
                <shape android:shape="rectangle">
                    <stroke android:color="@color/colorSecondary" android:width="@dimen/border_extra_thin"/>
                    <solid android:color="@color/transparent"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>