<?xml version="1.0" encoding="utf-8"?>
<au.com.dealsdirect.widget.ElasticDragDismissFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/product_details_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    tools:ignore="MissingPrefix">

    <RelativeLayout
        android:id="@+id/product_details_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <android.support.design.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true">

            <android.support.v4.widget.NestedScrollView
                android:id="@+id/controller_sale_item_detail_scrollview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/item_card_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <RelativeLayout
                            android:id="@+id/container"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <LinearLayout
                                android:id="@+id/main_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:orientation="vertical">

                                <RelativeLayout
                                    android:id="@+id/vh_uppercard"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@color/white"
                                    android:clipChildren="false"
                                    android:clipToPadding="false">

                                    <FrameLayout
                                        android:id="@+id/image_container"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:clipChildren="false"
                                        android:clipToPadding="false"
                                        android:paddingBottom="50dp">

                                        <RelativeLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="370dp"
                                            android:clipChildren="false"
                                            android:clipToPadding="false"
                                            android:transitionName="cardbackground">

                                            <ImageView
                                                android:id="@+id/product_details_shared_image"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:layout_alignParentTop="true"
                                                android:layout_gravity="center"
                                                android:layout_marginBottom="@dimen/margin_small"
                                                android:layout_marginTop="@dimen/margin_small"
                                                android:paddingBottom="@dimen/margin_extra_small"
                                                android:paddingTop="@dimen/margin_extra_small" />


                                            <com.lsjwzh.widget.recyclerviewpager.RecyclerViewPager
                                                android:id="@+id/productImageRecyclerView"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:layout_gravity="center"
                                                android:layout_marginBottom="@dimen/margin_small"
                                                android:layout_marginTop="@dimen/margin_small"
                                                android:clipChildren="false"
                                                android:clipToPadding="false"
                                                android:overScrollMode="always"
                                                android:paddingBottom="@dimen/margin_extra_small"
                                                android:paddingTop="@dimen/margin_extra_small"
                                                app:rvp_singlePageFling="true"
                                                app:rvp_triggerOffset="0.05" />

                                            <android.support.v7.widget.RecyclerView
                                                android:id="@+id/otherImagesRecyclerView"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_alignParentBottom="true"
                                                android:layout_centerHorizontal="true"
                                                android:isScrollContainer="true"
                                                android:overScrollMode="never"
                                                android:paddingBottom="50dp" />

                                            <ImageView
                                                android:id="@+id/arrow_left"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_alignLeft="@id/product_details_shared_image"
                                                android:layout_alignTop="@id/product_details_shared_image"
                                                android:layout_marginLeft="@dimen/margin_small"
                                                android:layout_marginTop="@dimen/activity_vertical_margin"
                                                android:elevation="@dimen/button_elevation"
                                                android:paddingBottom="@dimen/margin_large"
                                                android:paddingRight="@dimen/margin_large"
                                                android:src="@drawable/ic_item_details_back_arrow" />

                                        </RelativeLayout>

                                    </FrameLayout>

                                    <LinearLayout
                                        android:id="@+id/product_details_name_price_container"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_alignBottom="@id/image_container"
                                        android:background="#67ffffff"
                                        android:orientation="vertical">

                                        <LinearLayout
                                            android:id="@+id/controller_product_details_title_description"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="@dimen/activity_vertical_margin"
                                            android:layout_marginLeft="@dimen/margin_small"
                                            android:layout_marginRight="@dimen/margin_small"
                                            android:layout_marginTop="@dimen/activity_vertical_margin">

                                            <LinearLayout
                                                android:layout_width="0px"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="2"
                                                android:orientation="vertical">

                                                <TextView
                                                    android:id="@+id/productBrand"
                                                    fontPath="@string/font_app_semibold"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="start"
                                                    android:ellipsize="end"
                                                    android:text=""
                                                    android:textColor="@color/text_extra_dark"
                                                    android:textSize="@dimen/text_size_headline1" />

                                                <TextView
                                                    android:id="@+id/productName"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text=""
                                                    android:textColor="@color/text_light"
                                                    android:textSize="@dimen/text_size_caption1" />

                                            </LinearLayout>

                                            <LinearLayout
                                                android:layout_width="0px"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:orientation="vertical">

                                                <TextView
                                                    android:id="@+id/productPrice"
                                                    fontPath="@string/font_app_bold"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="end"
                                                    android:maxLines="1"
                                                    android:text=""
                                                    android:textColor="@color/product_details_text_product_price"
                                                    android:textSize="@dimen/text_size_title" />

                                                <TextView
                                                    android:id="@+id/productPreviousPrice"
                                                    fontPath="@string/font_app_light"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="end"
                                                    android:maxLines="1"
                                                    android:text=""
                                                    android:textColor="@color/product_details_text_product_sale_price"
                                                    android:textSize="@dimen/text_size_body" />

                                            </LinearLayout>
                                        </LinearLayout>

                                    </LinearLayout>
                                </RelativeLayout>

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1px"
                                    android:layout_alignParentTop="true"
                                    android:layout_gravity="center"
                                    android:background="#23000000" />

                                <LinearLayout
                                    android:id="@+id/partial_item_details_ourpay_panel_holder"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="@dimen/margin_small"
                                    android:orientation="vertical"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/bottom_card"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:paddingBottom="@dimen/product_details_bottom_padding"
                                    android:visibility="visible">

                                    <RelativeLayout
                                        android:id="@+id/product_details_sizes_container"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:background="@color/white"
                                        android:visibility="gone">

                                        <RelativeLayout
                                            android:id="@+id/sizeLabel"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content">

                                            <TextView
                                                fontPath="@string/font_app_bold"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:paddingLeft="@dimen/margin_small"
                                                android:paddingRight="@dimen/margin_small"
                                                android:text="@string/choose_your_size"
                                                android:textColor="@color/text_extra_dark"
                                                android:textSize="@dimen/text_size_body" />

                                            <ImageView
                                                android:id="@+id/question_mark"
                                                android:layout_width="15dp"
                                                android:layout_height="15dp"
                                                android:layout_alignParentRight="true"
                                                android:visibility="invisible" />

                                            <TextView
                                                fontPath="@string/font_app_black"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_centerVertical="true"
                                                android:layout_toLeftOf="@id/question_mark"
                                                android:paddingRight="@dimen/margin_extra_small"
                                                android:text="size guide"
                                                android:textSize="@dimen/text_size_caption1"
                                                android:visibility="invisible" />

                                        </RelativeLayout>

                                        <com.zhy.view.flowlayout.TagFlowLayout
                                            android:id="@+id/product_details_size_list"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_below="@+id/sizeLabel"
                                            android:layout_marginBottom="@dimen/margin_small"
                                            android:layout_marginTop="@dimen/margin_extra_small"
                                            android:paddingLeft="@dimen/margin_small"
                                            android:paddingRight="@dimen/margin_small"
                                            app:max_select="1" />

                                    </RelativeLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@color/white"
                                        android:paddingBottom="@dimen/margin_extra_small"
                                        android:paddingTop="@dimen/margin_extra_small">

                                        <Button
                                            android:id="@+id/product_details_add_to_basket"
                                            style="@style/DDButtonAddCart"
                                            fontPath="@string/font_app_medium"
                                            android:layout_width="match_parent"
                                            android:layout_gravity="bottom"
                                            android:layout_marginLeft="@dimen/margin_extra_small"
                                            android:layout_marginRight="@dimen/margin_extra_small"
                                            android:enabled="false"
                                            android:text="@string/add_to_cart"
                                            android:visibility="visible" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/product_details_shipping_desc_container"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:background="@color/white"
                                        android:orientation="vertical"
                                        android:visibility="gone">

                                        <TextView
                                            fontPath="@string/font_app_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_margin="@dimen/margin_extra_small"
                                            android:text="@string/estimated_delivery"
                                            android:textColor="@color/text_extra_dark"
                                            android:textSize="@dimen/text_size_body" />

                                        <WebView
                                            android:id="@+id/product_details_shipping_desc_webview"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content" />

                                        <ImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="1px"
                                            android:layout_gravity="center"
                                            android:background="#23000000" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/product_details_return_policy_container"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:background="@color/white"
                                        android:orientation="vertical"
                                        android:visibility="gone">

                                        <TextView
                                            fontPath="@string/font_app_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_margin="@dimen/margin_extra_small"
                                            android:text="@string/return_policy"
                                            android:textColor="@color/text_extra_dark"
                                            android:textSize="@dimen/text_size_body" />

                                        <WebView
                                            android:id="@+id/product_details_return_policy_text"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/margin_extra_small"
                                            android:textSize="@dimen/text_size_caption1" />

                                        <ImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="1px"
                                            android:layout_gravity="center"
                                            android:background="#23000000" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/product_description_container"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:background="@color/white"
                                        android:orientation="vertical">

                                        <WebView
                                            android:id="@+id/product_description_text"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent" />

                                        <ImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="1px"
                                            android:layout_gravity="center"
                                            android:background="#23000000" />

                                    </LinearLayout>

                                    <!--pickup points container-->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="@dimen/activity_horizontal_margin"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:background="@color/white"
                                        android:orientation="vertical"
                                        android:visibility="gone">

                                        <TextView
                                            fontPath="@string/font_app_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="available for"
                                            android:textColor="@color/text_medium"
                                            android:textSize="@dimen/text_size_caption1" />

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/margin_small"
                                            android:orientation="horizontal">

                                            <LinearLayout
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:orientation="horizontal">

                                                <ImageView
                                                    android:layout_width="30dp"
                                                    android:layout_height="30dp" />

                                                <TextView
                                                    fontPath="@string/font_app_bold"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="center"
                                                    android:layout_marginLeft="@dimen/margin_extra_small"
                                                    android:text="home or office delivery"
                                                    android:textColor="@color/text_medium"
                                                    android:textSize="@dimen/text_size_caption1" />

                                            </LinearLayout>

                                            <LinearLayout
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginLeft="@dimen/activity_horizontal_margin">

                                                <ImageView
                                                    android:layout_width="30dp"
                                                    android:layout_height="30dp" />

                                                <TextView
                                                    fontPath="@string/font_app_bold"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="center"
                                                    android:layout_marginLeft="@dimen/margin_extra_small"
                                                    android:text="pick up point"
                                                    android:textColor="@color/text_medium"
                                                    android:textSize="@dimen/text_size_caption1" />

                                            </LinearLayout>
                                        </LinearLayout>

                                        <ImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="1px"
                                            android:layout_gravity="center"
                                            android:background="#23000000" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/product_about_container"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:background="@color/white"
                                        android:orientation="vertical"
                                        android:visibility="gone">

                                        <TextView
                                            fontPath="@string/font_app_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_margin="@dimen/margin_extra_small"
                                            android:text="@string/about"
                                            android:textColor="@color/text_extra_dark"
                                            android:textSize="@dimen/text_size_body" />

                                        <WebView
                                            android:id="@+id/product_about"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/margin_extra_small" />

                                        <ImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="1px"
                                            android:layout_gravity="center"
                                            android:background="#23000000" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/about_pricing_container"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:background="@color/white"
                                        android:orientation="vertical"
                                        android:visibility="gone">

                                        <TextView
                                            fontPath="@string/font_app_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_margin="@dimen/margin_extra_small"
                                            android:text="@string/pricing"
                                            android:textColor="@color/text_extra_dark"
                                            android:textSize="@dimen/text_size_body" />

                                        <WebView
                                            android:id="@+id/product_about_pricing_text"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/margin_extra_small" />

                                        <!--<com.example.customviewlib.GenieTextView-->
                                        <!--android:id="@+id/productAboutPricing"-->
                                        <!--android:layout_marginTop="@dimen/margin_small"-->
                                        <!--android:layout_width="match_parent"-->
                                        <!--android:layout_height="wrap_content"-->
                                        <!--fontPath="@string/font_lato"-->
                                        <!--android:textSize="@dimen/text_size_small" />-->
                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/relatedItemsContainer"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="@dimen/margin_small"
                                        android:background="@color/white"
                                        android:orientation="vertical"
                                        android:visibility="gone">

                                        <TextView
                                            fontPath="@string/font_app_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="related items"
                                            android:textSize="@dimen/text_size_caption2" />

                                        <android.support.v7.widget.RecyclerView
                                            android:id="@+id/relatedItemsRecyclerView"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="15dp"
                                            android:paddingRight="@dimen/margin_small" />
                                    </LinearLayout>

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="1px"
                                        android:layout_gravity="center"
                                        android:background="#23000000"
                                        android:visibility="gone" />

                                    <LinearLayout
                                        android:id="@+id/customersAlsoBoughtContainer"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="@dimen/margin_small"
                                        android:background="@color/white"
                                        android:orientation="vertical"
                                        android:visibility="gone">

                                        <TextView
                                            fontPath="@string/font_app_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="customers also bought"
                                            android:textSize="@dimen/text_size_caption2" />

                                        <android.support.v7.widget.RecyclerView
                                            android:id="@+id/customersAlsoBoughtRecyclerView"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="15dp"
                                            android:paddingRight="@dimen/margin_small" />
                                    </LinearLayout>

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="1px"
                                        android:layout_gravity="center"
                                        android:background="#23000000"
                                        android:visibility="gone" />

                                    <RelativeLayout
                                        android:id="@+id/reviewsContainer"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="@dimen/margin_small"
                                        android:background="@color/white"
                                        android:visibility="gone">

                                        <TextView
                                            fontPath="@string/font_app_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="reviews"
                                            android:textSize="@dimen/text_size_caption1" />

                                        <android.support.design.widget.FloatingActionButton
                                            android:id="@+id/edit_review_fab"
                                            android:layout_width="40dp"
                                            android:layout_height="40dp"
                                            android:layout_alignParentRight="true"
                                            android:layout_marginRight="@dimen/margin_extra_small"
                                            android:layout_marginTop="@dimen/margin_extra_small"
                                            android:clickable="true"
                                            android:scaleType="fitXY"
                                            app:backgroundTint="#ffffff" />

                                        <android.support.v7.widget.RecyclerView
                                            android:id="@+id/reviewsRecyclerView"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentLeft="true"
                                            android:layout_below="@id/edit_review_fab" />

                                        <TextView
                                            android:id="@+id/see_more_text"
                                            fontPath="@string/font_app_bold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_below="@id/reviewsRecyclerView"
                                            android:text="see more"
                                            android:textSize="@dimen/text_size_caption1" />
                                    </RelativeLayout>

                                </LinearLayout>

                            </LinearLayout>

                        </RelativeLayout>

                    </FrameLayout>

                </LinearLayout>

            </android.support.v4.widget.NestedScrollView>

            <ImageView
                android:id="@+id/product_details_button_overlay"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_regular"
                android:layout_gravity="bottom"
                android:background="@color/product_details_button_overlay"
                android:visibility="gone" />


        </android.support.design.widget.CoordinatorLayout>

    </RelativeLayout>

</au.com.dealsdirect.widget.ElasticDragDismissFrameLayout>
