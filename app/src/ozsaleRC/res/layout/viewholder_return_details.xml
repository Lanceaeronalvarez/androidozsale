<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:id="@+id/viewholder_return_detail_row_container"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              tools:ignore="MissingPrefix">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/margin_small"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/viewholder_return_detail_image_view"
            android:layout_width="@dimen/return_details_image_width"
            android:layout_height="@dimen/return_details_image_height"
            tools:ignore="ContentDescription"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/viewholder_return_details_information_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_small"
                android:layout_marginTop="@dimen/margin_small"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="100"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/viewholder_return_details_item_name"
                        fontPath="@string/font_app_bold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentStart="true"
                        android:layout_weight="70"
                        android:textColor="@color/colorAccent"
                        android:textSize="@dimen/text_size_body"
                        tools:ignore="HardcodedText"
                        tools:text="Philosophy Cotton Sleeveless Plain"/>


                </LinearLayout>


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <RelativeLayout
                        android:id="@+id/my_returns_details_item_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_extra_small">


                        <TextView
                            android:id="@+id/viewholder_returns_details_item_count_identifier"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quantity:"
                            android:textColor="@color/text_light"
                            android:textSize="@dimen/text_size_body"
                            tools:ignore="HardcodedText"/>


                        <TextView
                            android:id="@+id/viewholder_returns_details_item_count_value"
                            fontPath="@string/font_app_regular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignTop="@+id/viewholder_returns_details_item_count_identifier"
                            android:layout_marginLeft="@dimen/margin_small"
                            android:layout_toEndOf="@+id/viewholder_returns_details_item_count_identifier"
                            android:textColor="@color/colorAccent"
                            android:textSize="@dimen/text_size_body"
                            tools:ignore="HardcodedText"
                            tools:text=""/>


                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/viewholder_return_details_price_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_tiny">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/viewholder_return_details_price_identifier"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Price:"
                                android:textColor="@color/text_light"
                                android:textSize="@dimen/text_size_body"
                                tools:ignore="HardcodedText"/>


                            <TextView
                                android:id="@+id/viewholder_returns_order_item_total_cost_value"
                                fontPath="@string/font_app_regular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/margin_small"
                                android:textColor="@color/colorAccent"
                                android:textSize="@dimen/text_size_body"
                                tools:ignore="HardcodedText"
                                tools:text=""/>

                        </LinearLayout>


                    </RelativeLayout>

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/viewholder_returns_details_size_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_tiny">

                    <TextView
                        android:id="@+id/viewholder_returns_details_size_indentifier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Size:"
                        android:textColor="@color/text_light"
                        android:textSize="@dimen/text_size_body"
                        tools:ignore="HardcodedText"/>


                    <TextView
                        android:id="@+id/viewholder_returns_details_size_value"
                        fontPath="@string/font_app_regular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/viewholder_returns_details_size_indentifier"
                        android:layout_marginLeft="@dimen/margin_small"
                        android:layout_toEndOf="@+id/viewholder_returns_details_size_indentifier"
                        android:layout_toRightOf="@+id/viewholder_returns_details_size_indentifier"
                        android:fontFamily="@string/font_app_regular"
                        android:textColor="@color/colorAccent"
                        android:textSize="@dimen/text_size_body"
                        tools:ignore="HardcodedText"
                        tools:text=""/>


                    <RelativeLayout
                        android:id="@+id/viewholder_returns_details_subtotal_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true">

                        <TextView
                            android:id="@+id/viewholder_returns_details_subtotal_indentifier"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:text="Subtotal:"
                            android:textColor="@color/text_light"
                            android:textSize="@dimen/text_size_body"
                            tools:ignore="HardcodedText"/>


                        <TextView
                            android:id="@+id/viewholder_returns_details_subtotal_value"
                            fontPath="@string/font_app_regular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/margin_small"
                            android:layout_toEndOf="@+id/viewholder_returns_details_subtotal_indentifier"
                            android:textColor="@color/colorAccent"
                            android:textSize="@dimen/text_size_body"
                            tools:ignore="HardcodedText"
                            tools:text=""/>

                    </RelativeLayout>

                </RelativeLayout>


            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>
</LinearLayout>

