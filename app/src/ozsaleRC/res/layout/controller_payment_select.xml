<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    tools:ignore="MissingPrefix">

    <RelativeLayout
        android:id="@+id/controller_payment_content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <TextView
            android:id="@+id/controller_payment_description_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_large"
            android:layout_marginLeft="@dimen/activity_horizontal_margin"
            android:layout_marginRight="@dimen/activity_horizontal_margin"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:text="@string/my_payment_method"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_size_headline3" />


        <android.support.v7.widget.RecyclerView
            android:id="@+id/payment_select_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/controller_payment_description_text"
            android:background="@color/transparent" />

        <Button
            android:id="@+id/controller_payment_button"
            style="@style/DDButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_margin="@dimen/padding_default"
            android:text="@string/add_new_payment_method" />
    </RelativeLayout>


    <include
        layout="@layout/partial_no_payment_method_placeholder_layout"
        android:visibility="gone" />
</RelativeLayout>
