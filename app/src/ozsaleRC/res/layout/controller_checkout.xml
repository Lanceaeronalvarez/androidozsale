<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background_color"
    android:orientation="vertical">

    <include layout="@layout/partial_toolbar_arrow" />

    <include
        layout="@layout/partial_checkout_empty"
        android:visibility="gone" />

    <android.support.v4.widget.NestedScrollView
        android:id="@+id/checkout_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/dimen_extra_small"
            android:layout_marginBottom="@dimen/dimen_extra_small">

            <TextView
                android:id="@+id/controller_checkout_orders_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_small"
                android:layout_weight="4"
                android:paddingLeft="@dimen/padding_default"
                android:paddingRight="@dimen/padding_default"
                android:paddingTop="@dimen/dimen_small"
                android:textAllCaps="true"
                android:visibility="gone"
                android:text="@string/checkout_order_label"
                android:textColor="@color/gray_title_text" />

            <android.support.v7.widget.RecyclerView
                android:id="@+id/controller_checkout_recyclerview_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include layout="@layout/partial_checkout_address" />

            <include layout="@layout/partial_checkout_payment" />

            <include layout="@layout/partial_checkout_voucher" />

            <include layout="@layout/partial_checkout_summary" />

            <include layout="@layout/partial_checkout_button" />

        </LinearLayout>

    </android.support.v4.widget.NestedScrollView>
</LinearLayout>