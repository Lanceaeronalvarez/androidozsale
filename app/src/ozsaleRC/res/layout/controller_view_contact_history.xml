<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <include
        android:id="@+id/view_contacts_toolbar"
        layout="@layout/partial_toolbar_arrow" />


    <LinearLayout
        android:id="@+id/controller_add_contact_subject_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clickable="true"
        android:layout_below="@id/view_contacts_toolbar"
        android:background="@drawable/bg_account_item"
        android:padding="@dimen/padding_default">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1.5"
            android:layout_marginEnd="@dimen/padding_default"
            android:text="@string/sale"
            android:textColor="@color/text_medium"
            android:textSize="@dimen/text_size_body" />

        <TextView
            fontPath="@string/font_app_bold"
            android:id="@+id/controller_view_contact_history_header_sale"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="8.5"
            android:ellipsize="end"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_size_body"
            tools:text="1231291 Cashmere Luxe"/>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/controller_add_contact_message_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/contacts_edittext_height"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:orientation="horizontal"
        android:elevation="5dp"
        android:padding="@dimen/padding_default_half">

        <EditText
            android:id="@+id/controller_view_contacts_history_message_field"
            style="@style/DDEditTextStyle"
            android:layout_width="0dp"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/margin_small"
            android:layout_weight="1"
            android:background="@drawable/bg_add_contact_message"
            android:hint="@string/write_a_message" />

        <ImageButton
            android:id="@+id/controller_view_contacts_history_reply_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@null"
            android:src="@drawable/ic_contact_us_send" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/controller_add_contact_subject_container"
        android:background="@color/border_regular" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/controller_add_contact_message_container"
        android:background="@color/border_regular" />


    <android.support.v7.widget.RecyclerView
        android:id="@+id/contact_history_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/controller_add_contact_message_container"
        android:layout_below="@id/controller_add_contact_subject_container"
        android:padding="5dp"
        android:overScrollMode="never" />

</RelativeLayout>

