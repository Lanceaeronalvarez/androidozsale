<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/viewholder_subcategory_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/viewholder_subcategory_height"
        android:layout_marginEnd="@dimen/margin_small"
        android:layout_marginStart="@dimen/margin_extra_small"
        android:background="@color/white">

        <TextView
            android:id="@+id/viewholder_subcategory_title"
            fontPath="@string/font_app_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_size_headline3"
            android:textStyle="bold"
            tools:ignore="MissingPrefix"
            tools:text="Category" />

        <ImageView
            android:id="@+id/viewholder_subcategory_check"
            android:layout_width="@dimen/row_facet_check_icon_width"
            android:layout_height="@dimen/row_facet_check_icon_height"
            android:layout_gravity="right|center_vertical"
            android:src="@drawable/ic_check"
            android:visibility="gone" />

    </FrameLayout>

    <android.support.v7.widget.RecyclerView
        android:id="@+id/viewholder_subcategory_items_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/viewholder_filter_subcategory_indent"
        android:overScrollMode="never" />

</LinearLayout>
