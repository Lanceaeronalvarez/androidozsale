<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <android.support.v7.widget.RecyclerView
            android:id="@+id/controller_current_returns_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="@dimen/margin_small"
            android:visibility="gone"
            app:rvp_flingFactor="0.15"
            app:rvp_singlePageFling="true"
            app:rvp_triggerOffset="0.25" />

        <include
            layout="@layout/partial_no_returns_placeholder_layout"
            android:visibility="gone" />

        <Button
            android:id="@+id/controller_current_returns_request_button"
            style="@style/DDButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_invite_clipboard"
            android:textSize="@dimen/text_size_headline1"
            android:layout_alignParentBottom="true"
            android:text="@string/request_new_return"
            android:layout_margin="@dimen/padding_default"
            android:visibility="gone"/>
    </RelativeLayout>

</LinearLayout>