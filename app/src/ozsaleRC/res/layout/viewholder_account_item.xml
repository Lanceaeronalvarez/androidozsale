<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:clickable="true">
    
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/padding_default"
        android:paddingEnd="@dimen/padding_default"
        android:paddingTop="@dimen/padding_default_half"
        android:paddingBottom="@dimen/padding_default_half">

    <TextView
        android:id="@+id/row_account_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:lines="1"
        tools:text="Mens"
        android:textColor="@color/category_text_selector"
        android:textSize="@dimen/text_size_body"
        android:layout_toLeftOf="@+id/row_account_arrow_right"
        android:layout_alignParentLeft="true"
        tools:ignore="MissingPrefix" />

    <ImageView
        android:id="@+id/row_account_arrow_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_gray_chevron"
        android:layout_alignParentEnd="true"/>
    </RelativeLayout>

    <View
        android:layout_marginStart="@dimen/padding_default"
        style="@style/horizontalBorderView"/>

</LinearLayout>
