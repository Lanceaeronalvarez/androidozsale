<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background_color"
    android:fillViewport="true"
    android:orientation="vertical"
    android:overScrollMode="never"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:orientation="vertical">

        <include layout="@layout/partial_toolbar_arrow" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <ImageView
                android:id="@+id/controller_register_back_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:rotation="180"
                android:src="@drawable/ic_gray_chevron"
                android:tint="#959595" />

            <ImageView
                android:id="@+id/controller_register_close_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:rotation="180"
                android:src="@drawable/ic_close"
                android:tint="#959595" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_extra_large"
            android:background="@color/white"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.35"
                android:padding="@dimen/padding_default"
                android:text="@string/first_name"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/text_size_large" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/controller_register_forename_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                app:hintEnabled="false">

                <EditText
                    android:id="@+id/controller_register_forename_field"
                    style="@style/DDEditTextStyleNoBorder"
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:maxLines="1" />

            </android.support.design.widget.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/border_thin"
            android:background="@color/white"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.35"
                android:padding="@dimen/padding_default"
                android:text="@string/last_name"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/text_size_large" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/controller_register_surname_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                app:hintEnabled="false">

                <EditText
                    android:id="@+id/controller_register_surname_field"
                    style="@style/DDEditTextStyleNoBorder"
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:maxLines="1" />

            </android.support.design.widget.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/border_thin"
            android:background="@color/white"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.35"
                android:padding="@dimen/padding_default"
                android:text="@string/email_hint"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/text_size_large" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/controller_register_email_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                app:hintEnabled="false">

                <EditText
                    android:id="@+id/controller_register_email_field"
                    style="@style/DDEditTextStyleNoBorder"
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />

            </android.support.design.widget.TextInputLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/border_thin"
            android:background="@color/white"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.35"
                android:padding="@dimen/padding_default"
                android:text="@string/password"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/text_size_large" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/controller_register_password_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                app:hintEnabled="false"
                app:passwordToggleDrawable="@drawable/ic_show_password_toggle"
                app:passwordToggleEnabled="true">

                <EditText
                    android:id="@+id/controller_register_password_field"
                    style="@style/DDEditTextStyleNoBorder"
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />

            </android.support.design.widget.TextInputLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/padding_default"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_large"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/controller_register_terms_conditions_check"
                    fontPath="@string/font_app_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="-5dp"
                    android:checked="true"
                    android:text="I agree to the "
                    android:textColor="@color/filter_text_inactive"
                    android:textSize="@dimen/text_size_medium" />

                <TextView
                    android:id="@+id/controller_register_terms_link"
                    fontPath="@string/font_app_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terms and Conditions"
                    android:textColor="@color/tab_bar_icon_active"
                    android:textSize="@dimen/text_size_medium" />
            </LinearLayout>

            <Button
                android:id="@+id/controller_register_sign_up_button"
                style="@style/DDButtonStyle"
                fontPath="@string/font_app_semibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/join_now"
                android:textSize="@dimen/text_size_xlarge" />

            <RelativeLayout
                android:id="@+id/facebook_login_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/default_button_height"
                android:layout_marginTop="@dimen/dimen_small"
                android:background="@drawable/login_default_button"
                android:clickable="true"
                android:elevation="@dimen/button_elevation">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true">

                    <ImageView
                        android:id="@+id/controller_login_facebook_image_view"
                        android:layout_width="@dimen/button_drawable_size"
                        android:layout_height="@dimen/button_drawable_size"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dimen_small"
                        android:scaleType="fitCenter"
                        android:src="@drawable/facebook"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/controller_login_with_facebook_text"
                        fontPath="@string/font_app_semibold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dimen_small"
                        android:text="@string/sign_in_with_facebook"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/text_size_xlarge" />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_small"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/dimen_small">

                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/already_a_member"
                    android:textColor="@color/dark_text"
                    android:textSize="@dimen/text_size_medium" />

                <TextView
                    android:id="@+id/controller_register_login_text"
                    fontPath="@string/font_app_semibold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:paddingEnd="0dp"
                    android:paddingStart="@dimen/dimen_extra_small"
                    android:text="@string/log_in"
                    android:textAllCaps="true"
                    android:textColor="@color/bg_button_default"
                    android:textSize="@dimen/text_size_medium" />

                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="0dp"
                    android:paddingStart="@dimen/dimen_extra_small"
                    android:text="@string/here"
                    android:textColor="@color/dark_text"
                    android:textSize="@dimen/text_size_medium" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</android.support.v4.widget.NestedScrollView>
