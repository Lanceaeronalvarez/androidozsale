<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <RelativeLayout
        android:id="@+id/view_addresses_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/address_office_delivery_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_marginLeft="@dimen/activity_horizontal_margin"
            android:layout_marginRight="@dimen/activity_horizontal_margin"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:text="home/office delivery"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_size_headline3"
            android:visibility="gone" />

        <android.support.v7.widget.RecyclerView
            android:id="@+id/controller_addresses_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/controller_address_button"
            android:layout_below="@+id/address_office_delivery_subtitle"
            android:overScrollMode="never"
            android:visibility="visible" />


        <Button
            android:id="@+id/controller_address_button"
            style="@style/DDButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_margin="@dimen/padding_default"
            android:text="@string/add_new_address" />

        <include
            layout="@layout/view_address_placeholder_layout"
            android:visibility="gone" />


    </RelativeLayout>

</LinearLayout>
