<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/controller_base_toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <include layout="@layout/partial_toolbar_title"/>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent">

        <in.srain.cube.views.ptr.PtrClassicFrameLayout
            android:id="@+id/controller_base_ptr_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/controller_search_popular_subheader"
            android:background="@color/transparent"
            android:paddingLeft="@dimen/margin_extra_small"
            android:paddingRight="@dimen/margin_extra_small"
            app:ptr_duration_to_close="200"
            app:ptr_duration_to_close_header="1000"
            app:ptr_keep_header_when_refresh="true"
            app:ptr_pull_to_fresh="false"
            app:ptr_ratio_of_header_height_to_refresh="1.2"
            app:ptr_resistance="1.7">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/controller_base_content_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <include layout="@layout/partial_no_network_layout" />

            </FrameLayout>

        </in.srain.cube.views.ptr.PtrClassicFrameLayout>

        <com.bluelinelabs.conductor.ChangeHandlerFrameLayout
            android:id="@+id/controller_search_filter_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</LinearLayout>