<?xml version="1.0" encoding="utf-8"?><!--<au.com.dealsdirect.widget.ElasticHorizontalDragDismissFrameLayout--><!----><!--android:layout_width="match_parent"--><!--android:layout_height="match_parent"--><!--android:fillViewport="true"--><!--tools:ignore="MissingPrefix">-->
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background_color"
    android:fillViewport="true"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:id="@+id/controller_details_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <android.support.v4.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_large"
                    android:background="@color/white"
                    android:orientation="horizontal">

                    <TextView
                        fontPath="@string/font_app_semibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.35"
                        android:padding="@dimen/padding_default"
                        android:text="@string/first_name"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/text_size_large" />

                    <android.support.design.widget.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.65"
                        app:hintEnabled="false">

                        <EditText
                            android:id="@+id/controller_details_text_firstname"
                            style="@style/DDEditTextStyleNoBorder"
                            fontPath="@string/font_app_medium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:maxLines="1"
                            android:textSize="@dimen/text_size_large" />

                    </android.support.design.widget.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/border_thin"
                    android:background="@color/white"
                    android:orientation="horizontal">

                    <TextView
                        fontPath="@string/font_app_semibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.35"
                        android:padding="@dimen/padding_default"
                        android:text="@string/last_name"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/text_size_large" />

                    <android.support.design.widget.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.65"
                        app:hintEnabled="false">


                        <EditText
                            android:id="@+id/controller_details_text_lastname"
                            style="@style/DDEditTextStyleNoBorder"
                            fontPath="@string/font_app_medium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:textSize="@dimen/text_size_large" />

                    </android.support.design.widget.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/border_thin"
                    android:background="@color/white"
                    android:orientation="horizontal">

                    <TextView
                        fontPath="@string/font_app_semibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.35"
                        android:padding="@dimen/padding_default"
                        android:text="@string/date_of_birth"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/text_size_large" />

                    <android.support.design.widget.TextInputLayout
                        android:id="@+id/controller_details_firstname_wrapper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.65"
                        app:hintEnabled="false">

                        <EditText
                            android:id="@+id/controller_details_text_birthday"
                            style="@style/DDEditTextStyleNoBorder"
                            fontPath="@string/font_app_medium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:inputType="date"
                            android:textSize="@dimen/text_size_large" />

                    </android.support.design.widget.TextInputLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/border_thin"
                    android:background="@color/white"
                    android:orientation="horizontal">

                    <TextView
                        fontPath="@string/font_app_semibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.35"
                        android:padding="@dimen/padding_default"
                        android:text="@string/gender"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/text_size_large" />

                    <Spinner
                        android:id="@+id/controller_details_spinner_gender"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.65"
                        android:background="#00000000"
                        android:entries="@array/genders" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/border_thin"
                    android:background="@color/white"
                    android:orientation="horizontal">

                    <TextView
                        fontPath="@string/font_app_semibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.35"
                        android:padding="@dimen/padding_default"
                        android:text="@string/email_address"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/text_size_large" />

                    <android.support.design.widget.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.65"
                        app:hintEnabled="false">


                        <EditText
                            android:id="@+id/controller_details_text_emailaddress"
                            style="@style/DDEditTextStyleNoBorder"
                            fontPath="@string/font_app_medium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textSize="@dimen/text_size_large" />

                    </android.support.design.widget.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/border_thin"
                    android:background="@color/white"
                    android:orientation="horizontal">

                    <TextView
                        fontPath="@string/font_app_semibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.35"
                        android:padding="@dimen/padding_default"
                        android:text="@string/password"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/text_size_large" />

                    <android.support.design.widget.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.65"
                        app:hintEnabled="false">

                        <EditText
                            android:id="@+id/controller_details_text_password"
                            style="@style/DDEditTextStyleNoBorder"
                            fontPath="@string/font_app_medium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textSize="@dimen/text_size_large" />

                    </android.support.design.widget.TextInputLayout>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/border_thin"
                    android:background="@color/white"
                    android:orientation="horizontal">

                    <TextView
                        fontPath="@string/font_app_semibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.35"
                        android:padding="@dimen/padding_default"
                        android:text="@string/new_password"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/text_size_large" />

                    <android.support.design.widget.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="0.65"
                        app:hintEnabled="false">

                        <EditText
                            android:id="@+id/controller_details_text_new_password"
                            style="@style/DDEditTextStyleNoBorder"
                            fontPath="@string/font_app_medium"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:inputType="textPassword"
                            android:textSize="@dimen/text_size_large" />

                    </android.support.design.widget.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/border_thin"
                    android:background="@color/white"
                    android:orientation="horizontal">

                    <TextView
                        fontPath="@string/font_app_semibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.35"
                        android:padding="@dimen/padding_default"
                        android:text="@string/confirm_password"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/text_size_large" />

                    <android.support.design.widget.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="0.65"
                        app:hintEnabled="false">

                        <EditText
                            android:id="@+id/controller_details_text_confirm_password"
                            style="@style/DDEditTextStyleNoBorder"
                            fontPath="@string/font_app_medium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textSize="@dimen/text_size_large" />

                    </android.support.design.widget.TextInputLayout>
                </LinearLayout>

            </LinearLayout>

        </android.support.v4.widget.NestedScrollView>

        <Button
            android:id="@+id/controller_details_button"
            style="@style/DDButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/padding_default"
            android:text="@string/save_changes" />
    </LinearLayout>

</android.support.design.widget.CoordinatorLayout><!--</au.com.dealsdirect.widget.ElasticHorizontalDragDismissFrameLayout>-->
