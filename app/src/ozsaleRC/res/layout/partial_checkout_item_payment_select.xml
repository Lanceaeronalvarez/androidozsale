<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/partial_checkout_payment_image"
        android:layout_width="@dimen/row_checkout_drawable_width"
        android:layout_height="@dimen/row_checkout_drawable_height"
        android:layout_marginLeft="@dimen/padding_default"
        android:paddingLeft="@dimen/margin_extra_small"
        android:paddingRight="@dimen/margin_extra_small"
        android:src="@drawable/ic_my_vouchers" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_small"
        android:orientation="vertical">

        <TextView
            android:id="@+id/partial_checkout_payment_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/padding_default"
            android:textColor="@color/row_checkout_text_light_color"
            android:textSize="@dimen/text_size_headline2"
            tools:text="@string/row_checkout_name_hint" />

        <TextView
            android:id="@+id/partial_checkout_payment_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            android:layout_marginRight="@dimen/padding_default"
            android:textColor="@color/row_checkout_text_light_color"
            tools:text="@string/row_checkout_desc_hint" />

        <TextView
            android:id="@+id/partial_checkout_payment_remove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove"
            android:textColor="@color/text_medium"
            android:textSize="@dimen/text_size_headline2"
            android:visibility="gone" />

        <View
            android:id="@+id/item_payment_select_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#ECECEC"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>