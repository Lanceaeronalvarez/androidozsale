<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/row_background_color"
    android:orientation="horizontal"
    android:padding="@dimen/padding_default"
    tools:ignore="MissingPrefix">

    <ImageView
        android:id="@+id/item_checkout_image"
        android:layout_width="@dimen/row_checkout_image_width"
        android:layout_height="@dimen/row_checkout_image_height"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/item_checkout_image"
        android:layout_alignBottom="@id/item_checkout_image"
        android:layout_toRightOf="@id/item_checkout_image"
        android:orientation="vertical"
        android:layout_marginLeft="@dimen/margin_extra_small"
        android:layout_marginRight="@dimen/margin_extra_small"
        android:paddingStart="@dimen/margin_small">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_checkout_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="@color/row_checkout_text_dark_color"
                android:textSize="@dimen/text_size_headline3"
                tools:text="Philosophy (Runway) Cotton Sleeveless Plain" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_checkout_color_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/color"
                android:textColor="@color/row_checkout_text_light_color" />

            <TextView
                android:id="@+id/item_checkout_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/row_checkout_text_light_color"
                tools:text="Pink" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_checkout_size_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/row_checkout_text_light_color"
                android:text="@string/size" />

            <TextView
                android:id="@+id/item_checkout_size_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/row_checkout_text_light_color"
                tools:text="AU 14" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/margin_extra_small">

            <au.com.dealsdirect.ui.custom.ProductQuantityLayout
                android:id="@+id/item_checkout_quantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left|bottom"/>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/item_checkout_price_label"
                    fontPath="@string/font_app_semibold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@id/item_checkout_price"
                    android:textColor="@color/row_checkout_text_dark_color"
                    android:textSize="@dimen/text_size_body"
                    android:layout_marginRight="@dimen/label_space"
                    android:text="@string/price_colon" />

                <TextView
                    android:id="@+id/item_checkout_price"
                    fontPath="@string/font_app_semibold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:textColor="@color/row_checkout_text_dark_color"
                    android:textSize="@dimen/text_size_body"
                    android:text="$19.00" />

                <TextView
                    android:id="@+id/item_checkout_subtotal_label"
                    fontPath="@string/font_app_semibold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/item_subtotal_price"
                    android:layout_alignTop="@id/item_subtotal_price"
                    android:textColor="@color/row_checkout_text_dark_color"
                    android:textSize="@dimen/text_size_body"
                    android:layout_marginRight="@dimen/label_space"
                    android:text="@string/subtotal_colon" />

                <TextView
                    android:id="@id/item_subtotal_price"
                    fontPath="@string/font_app_semibold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/item_checkout_price"
                    android:layout_alignLeft="@id/item_checkout_price"
                    android:textColor="@color/row_checkout_text_dark_color"
                    android:textSize="@dimen/text_size_body"
                    android:text="$19.00" />

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>