<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background_color"
    android:fillViewport="true"
    android:orientation="vertical"
    android:overScrollMode="never"
    tools:ingore="MissingPrefix">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/partial_toolbar_arrow" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <ImageView
                android:id="@+id/controller_login_close_icon"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimen_extra_small"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/dimen_extra_small"
                android:rotation="180"
                android:src="@drawable/ic_close"
                android:tint="@color/controller_login_close_tint_color" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_extra_large"
            android:background="@color/white"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_default"
                android:text="@string/email"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/text_size_large"
                android:layout_weight="0.35"/>

            <android.support.design.widget.TextInputLayout
                android:id="@+id/controller_login_email_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                android:layout_weight="0.65">

                <EditText
                    android:id="@+id/controller_login_email_edittext"
                    style="@style/DDEditTextStyleNoBorder"
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />

            </android.support.design.widget.TextInputLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_extra_large"
            android:background="@color/white"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_default"
                android:text="@string/password"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/text_size_large"
                android:layout_weight="0.35"/>

            <android.support.design.widget.TextInputLayout
                android:id="@+id/controller_login_password_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:passwordToggleDrawable="@drawable/ic_show_password_toggle"
                app:passwordToggleEnabled="true"
                android:layout_weight="0.65">

                <EditText
                    android:id="@+id/controller_login_password_edittext"
                    style="@style/DDEditTextStyleNoBorder"
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColorHint="@color/colorPrimaryDark" />

            </android.support.design.widget.TextInputLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_default">

            <Button
                android:id="@+id/controller_login_button"
                style="@style/DDButtonStyle"
                fontPath="@string/font_app_semibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_invite_clipboard"
                android:text="@string/log_in"
                android:textSize="@dimen/text_size_xlarge" />

            <RelativeLayout
                android:id="@+id/controller_login_fb_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/default_button_height"
                android:layout_marginTop="@dimen/dimen_small"
                android:background="@drawable/login_default_button"
                android:clickable="true"
                android:elevation="2.5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/controller_login_facebook_image_view"
                        android:layout_width="@dimen/button_drawable_size"
                        android:layout_height="@dimen/button_drawable_size"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dimen_small"
                        android:scaleType="fitCenter"
                        android:src="@drawable/facebook"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/controller_login_with_facebook_text"
                        fontPath="@string/font_app_semibold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dimen_small"
                        android:text="@string/sign_in_with_facebook"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/text_size_xlarge" />
                </LinearLayout>
            </RelativeLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    fontPath="@string/font_app_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimen_small"
                    android:layout_marginTop="@dimen/dimen_extra_large"
                    android:text="@string/not_a_member_yet_text"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="@dimen/text_size_xxxlarge" />


                <TextView
                    android:id="@+id/controller_login_signup_text"
                    style="@style/DDButtonJoinNow"
                    fontPath="@string/font_app_semibold"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/default_button_height"
                    android:gravity="center"
                    android:text="@string/join_now"
                    android:textColor="@color/colorSecondary"
                    android:textSize="@dimen/text_size_xlarge"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/controller_login_forgot_password_text"
                    fontPath="@string/font_app_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:layout_marginTop="@dimen/dimen_small"
                    android:text="@string/forgot_password"
                    android:textColor="@color/colorSecondary"
                    android:textSize="@dimen/text_size_large" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</android.support.v4.widget.NestedScrollView>
