<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/default_viewholder_item_height"
    android:paddingStart="30dp"
    android:orientation="vertical"
    android:clickable="true">

    <ImageView
        android:id="@+id/row_account_image"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="center"
        android:background="@color/white"
        android:scaleType="fitXY"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/row_account_text"
        fontPath="@string/font_app_medium"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:layout_marginStart="10dp"
        android:gravity="center_vertical"
        android:lines="1"
        android:text="Mens"
        android:textColor="@color/category_text_selector"
        android:textSize="@dimen/text_size_body"
        android:layout_toLeftOf="@+id/row_account_arrow_right"
        android:layout_alignParentLeft="true"
        tools:ignore="MissingPrefix" />

    <ImageView
        android:id="@+id/row_account_arrow_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_gray_chevron"
        android:layout_centerVertical="true"
        android:layout_alignParentRight="true"
        android:layout_marginRight="15dp"/>

    <View
        style="@style/horizontalBorderView"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>
