<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              tools:ignore="HardcodedText,MissingPrefix">

    <RelativeLayout
        android:id="@+id/new_return_item_set_detail_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="@dimen/margin_extra_small">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/new_return_item_detail_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/viewholder_return_order_checkbox_height"/>

            <ImageView
                android:id="@+id/new_return_set_detail_item_image"
                android:layout_width="@dimen/viewholder_return_order_image_width"
                android:layout_height="@dimen/viewholder_return_order_image_height"
                android:layout_toRightOf="@+id/new_return_item_detail_checkbox"
                android:padding="@dimen/margin_extra_small"
                android:scaleType="fitStart"/>

            <RelativeLayout
                android:id="@+id/new_return_item_detail_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/new_return_set_detail_item_image"
                android:paddingLeft="@dimen/margin_small">

                <TextView
                    android:id="@+id/new_return_request_item_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@string/font_app_regular"
                    android:paddingRight="@dimen/margin_extra_large"
                    android:text="Philosophy Cotton Sleeveless Plain"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/text_size_body"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/new_return_request_item_name"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/margin_small">

                    <!--<com.mysale.genie.views.custom.GenieTextView-->
                    <!--app:font="@string/fontname_lato_bold"-->
                    <!--android:id="@+id/set_detail_dollar_sign"-->
                    <!--android:layout_width="wrap_content"-->
                    <!--android:layout_height="wrap_content"-->
                    <!--android:textSize="@dimen/new_return_request_set_detail_item_total_cost"-->
                    <!--android:textColor="#FF785F"-->
                    <!--android:text="$"/>-->


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <au.com.dealsdirect.ui.custom.ProductQuantityLayout
                            android:id="@+id/new_returns_select_order_item_quantaty_selector"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small">
                        </au.com.dealsdirect.ui.custom.ProductQuantityLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_marginLeft="@dimen/margin_small"
                            android:layout_marginRight="@dimen/margin_small"
                            android:layout_toEndOf="@+id/new_returns_select_order_item_quantaty_selector"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total Price: "/>

                                <TextView
                                    android:id="@+id/new_return_request_item_total_cost"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_marginLeft="@dimen/activity_horizontal_margin"
                                    android:fontFamily="@string/font_app_regular"
                                    android:text="89.00"
                                    android:textColor="@color/colorAccent"
                                    android:textSize="@dimen/text_size_caption1"
                                    tools:ignore="HardcodedText"/>

                            </RelativeLayout>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Subtotal: "/>

                                <TextView
                                    android:id="@+id/new_returns_order_size_return_subtotal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_marginLeft="@dimen/activity_horizontal_margin"
                                    android:fontFamily="@string/font_app_regular"
                                    android:text="$12.00"
                                    android:textColor="@color/colorAccent"
                                    android:textSize="@dimen/text_size_caption1"
                                    tools:ignore="HardcodedText"/>
                            </RelativeLayout>


                            <RelativeLayout
                                android:id="@+id/new_returns_order_item_total_cost_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/new_return_request_item_total_cost"
                                android:layout_marginTop="@dimen/margin_tiny"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/new_returns_order_item_count_identifier"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@string/font_app_regular"
                                    android:text="Item Count:"
                                    android:textColor="#b7b7b7"
                                    android:textSize="@dimen/text_size_caption1"
                                    tools:ignore="HardcodedText"/>

                                <TextView
                                    android:id="@+id/new_returns_order_item_count_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignTop="@+id/new_returns_order_item_count_identifier"
                                    android:layout_marginLeft="@dimen/margin_tiny"
                                    android:layout_toEndOf="@+id/new_returns_order_item_count_identifier"
                                    android:layout_toRightOf="@+id/new_returns_order_item_count_identifier"
                                    android:fontFamily="@string/font_app_regular"
                                    android:text="0"
                                    android:textColor="@color/text_extra_light"
                                    android:textSize="@dimen/text_size_caption1"
                                    tools:ignore="HardcodedText"/>

                            </RelativeLayout>


                            <RelativeLayout
                                android:id="@+id/new_returns_order_item_id_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_below="@+id/new_returns_order_item_total_cost_detail"
                                android:layout_marginTop="@dimen/margin_tiny">

                                <TextView
                                    android:id="@+id/new_returns_order_item_id_identifier"
                                    android:layout_width="wrap_content"
                                    android:layout_height="0dp"
                                    android:fontFamily="@string/font_app_regular"
                                    android:text="Item id:"
                                    android:textColor="@color/text_extra_light"
                                    tools:ignore="HardcodedText"/>


                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/new_returns_order_item_size_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/new_returns_order_item_id_detail">

                                <TextView
                                    android:id="@+id/new_returns_order_item_size_identifier"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@tring/font_app_regular"
                                    android:text="Size:"
                                    android:textSize="@dimen/text_size_caption1"
                                    tools:ignore="HardcodedText"/>


                                <TextView
                                    android:id="@+id/new_returns_order_size_return_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_alignParentTop="true"
                                    android:fontFamily="@string/font_app_regular"
                                    android:text="12"
                                    android:textColor="@color/colorAccent"
                                    android:textSize="@dimen/text_size_caption1"
                                    tools:ignore="HardcodedText"/>
                            </RelativeLayout>

                        </LinearLayout>

                    </RelativeLayout>

                </LinearLayout>
            </RelativeLayout>

            <TextView
                android:id="@+id/new_returns_order_item_id_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/new_return_set_detail_item_image"
                android:layout_alignParentEnd="true"
                android:layout_marginBottom="@dimen/margin_large"
                android:layout_marginEnd="111dp"
                android:fontFamily="@string/font_app_regular"
                android:text="0"
                android:textColor="@color/text_extra_light"
                android:textSize="@dimen/text_size_caption1"
                android:visibility="gone"
                tools:ignore="HardcodedText"/>
        </RelativeLayout>
    </RelativeLayout>

    <View
        android:id="@+id/my_returns_set_detail_item_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/text_extra_light"/>

</LinearLayout>