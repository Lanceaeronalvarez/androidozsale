<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:layout_gravity="top"
    android:background="@color/toolbar_skin"
    android:contentInsetEnd="0dp"
    android:contentInsetLeft="0dp"
    android:contentInsetRight="0dp"
    android:contentInsetStart="0dp"
    android:fitsSystemWindows="true"
    android:minHeight="?attr/actionBarSize"
    app:contentInsetEnd="0dp"
    app:contentInsetLeft="0dp"
    app:contentInsetRight="0dp"
    app:contentInsetStart="0dp"
    app:layout_collapseMode="pin"
    tools:ignore="MissingPrefix">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@id/partial_toolbar_field_title_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:maxLines="1"
            android:padding="@dimen/margin_small"
            android:text=""
            android:textColor="@color/text_extra_dark"
            android:textSize="@dimen/text_size_headline2" />

        <ImageButton
            android:id="@+id/partial_toolbar_field_title_left_option"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_toolbar_button"
            android:padding="@dimen/margin_small"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gray_chevron_left" />

        <ImageButton
            android:id="@+id/partial_toolbar_field_title_right_option"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignBottom="@+id/partial_toolbar_field_title_textview"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@+id/partial_toolbar_field_title_textview"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_toolbar_button"
            android:src="@drawable/ic_toolbar_filter" />


    </RelativeLayout>

</android.support.v7.widget.Toolbar>