<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/background_default"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <include layout="@layout/partial_toolbar_arrow" />

    <include
        layout="@layout/partial_checkout_empty" />

    <android.support.v4.widget.NestedScrollView
        android:id="@+id/checkout_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/controller_checkout_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="blocksDescendants"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/partial_checkout_address" />

            <include layout="@layout/partial_checkout_delivery_options" />

            <include layout="@layout/partial_checkout_payment" />

            <include layout="@layout/partial_checkout_voucher" />

            <include layout="@layout/partial_checkout_summary" />

            <include layout="@layout/partial_checkout_button" />

        </LinearLayout>

    </android.support.v4.widget.NestedScrollView>
</LinearLayout>
