<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_small"
    android:layout_marginTop="@dimen/margin_small"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <View
        style="@style/horizontalBorderView"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <LinearLayout
        android:id="@+id/partial_checkout_voucher_container_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/partial_checkout_voucher_new_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_account_item"
            android:padding="@dimen/padding_default">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="9"
                android:layout_gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voucher_label"
                    android:textColor="@color/row_checkout_text_light_color"
                    android:textSize="@dimen/text_size_body" />


                <TextView
                    android:id="@+id/partial_checkout_voucher_value_text_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/row_checkout_text_light_color"
                    android:textSize="@dimen/text_size_body"
                    android:gravity="end"
                    android:visibility="gone"
                    tools:text="@string/row_voucher_name_hint" />


            </LinearLayout>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/ic_gray_chevron" />
        </LinearLayout>

    </LinearLayout>

    <!--set visibility to gone. will not be needing as of design. might be used in the future though.. jpaseneta 08/10/2018-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:visibility="gone"
        android:padding="@dimen/padding_default">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/promo_code"
            android:textColor="@color/row_checkout_text_light_color"
            android:textSize="@dimen/text_size_body" />

        <TextView
            android:id="@+id/partial_checkout_voucher_promo_code_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/colorAccent"
            tools:text="H27AEJALS" />
    </LinearLayout>

    <View
        style="@style/horizontalBorderView"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

</LinearLayout>
