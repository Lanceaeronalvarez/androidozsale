<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/margin_large">

    <ProgressBar
        android:id="@+id/order_step_progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="5dp"
        android:layout_height="0dp"
        android:progress="75"
        android:progressDrawable="@drawable/bg_order_tracking_line_vertical"
        app:layout_constraintBottom_toTopOf="@id/order_step_lower_node"
        app:layout_constraintLeft_toLeftOf="@id/order_step_upper_node"
        app:layout_constraintRight_toRightOf="@id/order_step_upper_node"
        app:layout_constraintTop_toBottomOf="@id/order_step_upper_node" />

    <TextView
        android:id="@+id/order_step_upper_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_medium"
        android:text="Upper title\nUpper Description\n\n\nUpper Date"
        android:textSize="@dimen/text_size_body"
        app:layout_constraintLeft_toRightOf="@id/order_step_upper_node"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/order_step_upper_node"
        android:layout_width="@dimen/order_tracking_node_size"
        android:layout_height="@dimen/order_tracking_node_size"
        android:layout_marginLeft="@dimen/margin_large"
        android:background="@drawable/bg_order_tracking_node_full"
        android:padding="5dp"
        android:scaleType="fitCenter"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@id/order_step_upper_label" />

    <TextView
        android:id="@+id/order_step_lower_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_medium"
        android:text="Lower title\nLower Description\n\n\nLower Date"
        android:textSize="@dimen/text_size_body"
        app:layout_constraintLeft_toRightOf="@id/order_step_lower_node"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/order_step_upper_label"
        tools:layout_editor_absoluteY="136dp" />

    <ImageView
        android:id="@+id/order_step_lower_node"
        android:layout_width="@dimen/order_tracking_node_size"
        android:layout_height="@dimen/order_tracking_node_size"
        android:background="@drawable/bg_order_tracking_node_full"
        android:padding="5dp"
        android:scaleType="fitCenter"
        app:layout_constraintLeft_toLeftOf="@id/order_step_upper_node"
        app:layout_constraintRight_toRightOf="@id/order_step_upper_node"
        app:layout_constraintTop_toTopOf="@id/order_step_lower_label" />
</androidx.constraintlayout.widget.ConstraintLayout>