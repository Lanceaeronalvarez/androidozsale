<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/margin_large">

    <ProgressBar
        android:id="@+id/order_step_progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="wrap_content"
        android:layout_height="5dp"
        android:progress="50"
        android:progressDrawable="@drawable/bg_order_tracking_line_active"
        android:rotation="90"
        app:layout_constraintBottom_toTopOf="@id/order_step_lower_node"
        app:layout_constraintLeft_toLeftOf="@id/order_step_upper_node"
        app:layout_constraintRight_toRightOf="@id/order_step_upper_node"
        app:layout_constraintTop_toBottomOf="@id/order_step_upper_node" />

    <TextView
        android:id="@+id/order_step_upper_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_medium"
        android:fontFamily="@string/font_app_bold"
        android:text="Upper title"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold"
        app:layout_constraintLeft_toRightOf="@id/order_step_upper_node"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/order_step_upper_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@string/font_app_regular"
        android:text="Upper description"
        android:textSize="@dimen/text_size_body"
        app:layout_constraintLeft_toLeftOf="@id/order_step_upper_title"
        app:layout_constraintTop_toBottomOf="@id/order_step_upper_title" />

    <TextView
        android:id="@+id/order_step_upper_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@string/font_app_regular"
        android:text="Date"
        android:textSize="@dimen/text_size_body"
        app:layout_constraintLeft_toLeftOf="@id/order_step_upper_description"
        app:layout_constraintTop_toBottomOf="@id/order_step_upper_description" />

    <ImageView
        android:id="@+id/order_step_upper_node"
        android:layout_width="@dimen/order_tracking_node_size"
        android:layout_height="@dimen/order_tracking_node_size"
        android:layout_marginLeft="@dimen/margin_large"
        android:background="@drawable/bg_order_tracking_node_full"
        android:padding="5dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/order_step_upper_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@id/order_step_upper_title" />

    <TextView
        android:id="@+id/order_step_lower_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_extra_huge"
        android:fontFamily="@string/font_app_bold"
        android:text="Lower title"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold"
        app:layout_constraintLeft_toRightOf="@id/order_step_lower_node"
        app:layout_constraintTop_toBottomOf="@id/order_step_upper_title" />

    <TextView
        android:id="@+id/order_step_lower_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@string/font_app_regular"
        android:text="Lower description"
        android:textSize="@dimen/text_size_body"
        app:layout_constraintLeft_toLeftOf="@id/order_step_lower_title"
        app:layout_constraintTop_toBottomOf="@id/order_step_lower_title" />

    <TextView
        android:id="@+id/order_step_lower_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@string/font_app_regular"
        android:text="Date"
        android:textSize="@dimen/text_size_body"
        app:layout_constraintLeft_toLeftOf="@id/order_step_lower_description"
        app:layout_constraintTop_toBottomOf="@id/order_step_lower_description" />

    <ImageView
        android:id="@+id/order_step_lower_node"
        android:layout_width="@dimen/order_tracking_node_size"
        android:layout_height="@dimen/order_tracking_node_size"
        android:background="@drawable/bg_order_tracking_node_full"
        android:padding="5dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/order_step_lower_title"
        app:layout_constraintLeft_toLeftOf="@id/order_step_upper_node"
        app:layout_constraintRight_toRightOf="@id/order_step_upper_node"
        app:layout_constraintTop_toTopOf="@id/order_step_lower_title" />
</androidx.constraintlayout.widget.ConstraintLayout>