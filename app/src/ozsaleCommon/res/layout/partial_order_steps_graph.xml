<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/my_order_information_graph_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/my_order_graph_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large"
        android:orientation="horizontal"
        tools:ignore="UselessParent">

        <View
            android:id="@+id/left_spacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:visibility="invisible"
            app:layout_constraintEnd_toStartOf="@id/order_node_1"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/order_node_1"
            android:layout_width="@dimen/order_tracking_node_size"
            android:layout_height="@dimen/order_tracking_node_size"
            android:background="@drawable/bg_order_tracking_node_full"
            android:padding="5dp"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toStartOf="@id/order_node_connector_1"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/left_spacer"
            app:layout_constraintTop_toTopOf="parent" />

        <ProgressBar
            android:id="@+id/order_node_connector_1"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="@dimen/margin_extra_small"
            android:progress="100"
            android:progressDrawable="@drawable/bg_order_tracking_line_active"
            app:layout_constraintBottom_toBottomOf="@id/order_node_1"
            app:layout_constraintEnd_toStartOf="@id/order_node_2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/order_node_1"
            app:layout_constraintTop_toTopOf="@id/order_node_1" />

        <ImageView
            android:id="@+id/order_node_2"
            android:layout_width="@dimen/order_tracking_node_size"
            android:layout_height="@dimen/order_tracking_node_size"
            android:background="@drawable/bg_order_tracking_node_full"
            android:padding="5dp"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toStartOf="@id/order_node_connector_2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/order_node_connector_1"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <ProgressBar
            android:id="@+id/order_node_connector_2"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="@dimen/margin_extra_small"
            android:progress="50"
            android:progressDrawable="@drawable/bg_order_tracking_line_active"
            app:layout_constraintBottom_toBottomOf="@id/order_node_2"
            app:layout_constraintEnd_toStartOf="@id/order_node_3"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/order_node_2"
            app:layout_constraintTop_toTopOf="@id/order_node_2" />

        <ImageView
            android:id="@+id/order_node_3"
            android:layout_width="@dimen/order_tracking_node_size"
            android:layout_height="@dimen/order_tracking_node_size"
            android:background="@drawable/bg_order_tracking_node_hollow"
            android:padding="5dp"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toStartOf="@id/order_node_connector_3"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/order_node_connector_2"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <ProgressBar
            android:id="@+id/order_node_connector_3"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="@dimen/margin_extra_small"
            android:progress="0"
            android:progressDrawable="@drawable/bg_order_tracking_line_active"
            app:layout_constraintBottom_toBottomOf="@id/order_node_3"
            app:layout_constraintEnd_toStartOf="@id/order_node_4"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/order_node_3"
            app:layout_constraintTop_toTopOf="@id/order_node_3" />

        <ImageView
            android:id="@+id/order_node_4"
            android:layout_width="@dimen/order_tracking_node_size"
            android:layout_height="@dimen/order_tracking_node_size"
            android:background="@drawable/bg_order_tracking_node_inactive"
            android:gravity="center"
            android:padding="5dp"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toStartOf="@id/order_node_connector_4"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/order_node_connector_3"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <ProgressBar
            android:id="@+id/order_node_connector_4"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="@dimen/margin_extra_small"
            android:progress="0"
            android:progressDrawable="@drawable/bg_order_tracking_line_active"
            app:layout_constraintBottom_toBottomOf="@id/order_node_4"
            app:layout_constraintEnd_toStartOf="@id/order_node_5"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/order_node_4"
            app:layout_constraintTop_toTopOf="@id/order_node_4" />

        <ImageView
            android:id="@+id/order_node_5"
            android:layout_width="@dimen/order_tracking_node_size"
            android:layout_height="@dimen/order_tracking_node_size"
            android:background="@drawable/bg_order_tracking_node_not_received"
            android:padding="5dp"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toStartOf="@id/right_spacer"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/order_node_connector_4"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <View
            android:id="@+id/right_spacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="0.5"
            app:layout_constraintStart_toEndOf="@id/order_node_5"
            app:layout_constraintTop_toTopOf="parent" />


        <LinearLayout
            android:id="@+id/order_node_container_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="vertical"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintLeft_toLeftOf="@id/order_node_1"
            app:layout_constraintRight_toRightOf="@id/order_node_1"
            app:layout_constraintTop_toBottomOf="@id/order_node_1">

            <TextView
                android:id="@+id/order_node_title_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@string/font_app_bold"
                android:gravity="center"
                android:text="@string/order_date"
                android:textColor="@color/order_tracking_done"
                android:textSize="@dimen/text_size_caption1"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/order_node_date_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@string/font_app_regular"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/text_light"
                android:textSize="@dimen/text_size_caption1"
                tools:ignore="HardcodedText"
                tools:text="05 Sep" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/order_node_container_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="vertical"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintLeft_toLeftOf="@id/order_node_2"
            app:layout_constraintRight_toRightOf="@id/order_node_2"
            app:layout_constraintTop_toBottomOf="@id/order_node_2">

            <TextView
                android:id="@+id/order_node_title_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@string/font_app_bold"
                android:gravity="center"
                android:text="@string/stock_arrived"
                android:textColor="@color/order_tracking_done"
                android:textSize="@dimen/text_size_caption1"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/order_node_date_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@string/font_app_regular"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/text_light"
                android:textSize="@dimen/text_size_caption1"
                tools:ignore="HardcodedText"
                tools:text="05 Sep" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/order_node_container_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="vertical"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintLeft_toLeftOf="@id/order_node_3"
            app:layout_constraintRight_toRightOf="@id/order_node_3"
            app:layout_constraintTop_toBottomOf="@id/order_node_3">

            <TextView
                android:id="@+id/order_node_title_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@string/font_app_bold"
                android:gravity="center"
                android:text="@string/order_packed"
                android:textColor="@color/order_tracking_active"
                android:textSize="@dimen/text_size_caption1"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/order_node_date_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@string/font_app_regular"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/text_light"
                android:textSize="@dimen/text_size_caption1"
                tools:ignore="HardcodedText"
                tools:text="05 Sep" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/order_node_container_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="vertical"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintLeft_toLeftOf="@id/order_node_4"
            app:layout_constraintRight_toRightOf="@id/order_node_4"
            app:layout_constraintTop_toBottomOf="@id/order_node_4">

            <TextView
                android:id="@+id/order_node_title_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@string/font_app_bold"
                android:gravity="center"
                android:text="@string/dispatched"
                android:textColor="@color/order_tracking_inactive"
                android:textSize="@dimen/text_size_caption1"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/order_node_date_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@string/font_app_regular"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/text_light"
                android:textSize="@dimen/text_size_caption1"
                tools:ignore="HardcodedText"
                tools:text="05 Sep" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/received_order_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="vertical"
            app:layout_constraintLeft_toLeftOf="@id/order_node_5"
            app:layout_constraintRight_toRightOf="@id/order_node_5"
            app:layout_constraintTop_toBottomOf="@id/order_node_5">

            <TextView
                android:id="@+id/order_node_title_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@string/font_app_bold"
                android:gravity="center"
                android:text="@string/received"
                android:textColor="@color/order_tracking_inactive"
                android:textSize="@dimen/text_size_caption1"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/order_node_date_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@string/font_app_regular"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/text_light"
                android:textSize="@dimen/text_size_caption1"
                tools:ignore="HardcodedText"
                tools:text="05 Sep" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="wrap_content"
        android:layout_height="@dimen/border_thin"
        android:layout_marginTop="@dimen/margin_large"
        android:background="@color/border_light" />

</LinearLayout>