<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingTop="@dimen/margin_tiny"
    tools:ignore="MissingPrefix"
    android:id="@+id/row_item_order_details_layout"
    android:visibility="gone">



    <RelativeLayout
        android:layout_width="@dimen/order_image_width"
        android:layout_height="@dimen/order_image_height"
        android:id="@+id/controller_order_details_image_container"
        android:layout_marginLeft="@dimen/activity_horizontal_margin"
        android:layout_marginBottom="@dimen/margin_small">

        <ImageView
            android:id="@+id/controller_order_details_item_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/controller_order_details_cancelled_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelled"
            android:padding="5dp"
            android:background="@color/vco_color_true_red"
            android:textColor="@color/white"
            android:layout_alignParentRight="true"
            android:fontFamily="@string/font_app_bold"
            android:textSize="@dimen/text_size_caption2"
            android:visibility="gone"/>

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="@dimen/margin_huge"
        android:layout_height="@dimen/margin_huge"
        android:layout_alignParentRight="true"
        android:id="@+id/img_button_layout">

        <ImageButton
            android:id="@+id/order_item_details_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/margin_small"
            android:background="@drawable/ic_orders_ellipsis" />

    </RelativeLayout>


    <LinearLayout
        android:id="@+id/order_item_details_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/controller_order_details_image_container"
        android:layout_marginLeft="@dimen/margin_extra_small"
        android:layout_marginRight="@dimen/activity_horizontal_margin"
        android:layout_toRightOf="@+id/controller_order_details_image_container"
        android:orientation="vertical">

        <TextView
            android:id="@+id/controller_order_details_item_product_name_textview"
            fontPath="@string/font_app_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_size_body"
            tools:ignore="HardcodedText"
            tools:text="Item Name" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/product_size_indicator"
                fontPath="@string/font_app_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/size"
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_body"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/controller_order_details_item_size_textview"
                fontPath="@string/font_app_semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_extra_small"
                android:textColor="@color/text_extra_dark"
                android:textSize="@dimen/text_size_body"
                tools:ignore="HardcodedText"
                tools:text="Small" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/product_quantity_indicator"
                fontPath="@string/font_app_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quantity"
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_body"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/controller_order_details_item_quantity_textview"
                fontPath="@string/font_app_semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_extra_small"
                android:textColor="@color/text_extra_dark"
                android:textSize="@dimen/text_size_body"
                tools:ignore="HardcodedText"
                tools:text="5" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/product_price_indicator"
                fontPath="@string/font_app_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price_colon"
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_body"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/controller_order_details_item_price_textview"
                fontPath="@string/font_app_semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_extra_small"
                android:textColor="@color/text_extra_dark"
                android:textSize="@dimen/text_size_body"
                tools:ignore="HardcodedText"
                tools:text="$5.00" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/product_subtotal_indicator"
                fontPath="@string/font_app_regular"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/subtotal_colon"
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_body"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/controller_order_details_item_subtotal_textview"
                fontPath="@string/font_app_semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_extra_small"
                android:textColor="@color/text_extra_dark"
                android:textSize="@dimen/text_size_body"
                tools:ignore="HardcodedText"
                tools:text="$1.00" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="wrap_content"
        android:layout_height="@dimen/border_regular"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_medium"
        android:background="@color/border_regular"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>

