<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingTop="@dimen/margin_small"
    tools:ignore="MissingPrefix">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/viewholder_subcategory_height"
        android:layout_marginEnd="@dimen/margin_small"
        android:layout_marginStart="@dimen/margin_extra_small"
        android:background="@color/white">

        <TextView
            android:id="@+id/viewholder_facet_item_title"
            fontPath="@string/font_app_regular"
            style="@style/TextViewStyle"
            android:layout_gravity="start|center_vertical"
            tools:text="Category" />

        <ImageView
            android:id="@+id/viewholder_subcategory_check"
            android:layout_width="@dimen/row_facet_check_icon_width"
            android:layout_height="@dimen/row_facet_check_icon_height"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/ic_check"
            android:visibility="visible" />

    </FrameLayout>

    <View
        android:id="@+id/viewholder_subcategoryitems_border"
        android:layout_width="match_parent"
        android:layout_height="@dimen/border_regular"
        android:layout_marginLeft="@dimen/margin_tiny"
        android:background="@color/border_regular"
        android:visibility="visible" />

</LinearLayout>
