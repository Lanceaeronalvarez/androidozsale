<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    android:orientation="vertical">

    <include layout="@layout/partial_toolbar_logo" />

    <android.support.design.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <in.srain.cube.views.ptr.PtrClassicFrameLayout
            android:id="@+id/controller_sale_items_ptr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:ptr_duration_to_close="200"
            app:ptr_duration_to_close_header="1000"
            app:ptr_keep_header_when_refresh="true"
            app:ptr_pull_to_fresh="false"
            app:ptr_ratio_of_header_height_to_refresh="1.2"
            app:ptr_resistance="1.7">

            <android.support.v7.widget.RecyclerView
                android:id="@+id/controller_shop_banner_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/border_regular"/>
        </in.srain.cube.views.ptr.PtrClassicFrameLayout>

        <android.support.design.widget.AppBarLayout
            android:id="@+id/controller_sale_items_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white">

            <android.support.design.widget.CollapsingToolbarLayout
                android:id="@+id/main.collapsing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fitsSystemWindows="true"
                android:paddingBottom="@dimen/margin_small"
                app:contentScrim="@color/white"
                app:layout_scrollFlags="scroll|enterAlways">

                <au.com.dealsdirect.ui.custom.SearchEditText
                    android:id="@+id/partial_toolbar_field_title_edittext"
                    style="@style/DDEditTextSearchBar"
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/activity_horizontal_margin"
                    android:layout_marginRight="@dimen/activity_horizontal_margin"
                    android:clickable="true"
                    android:drawableLeft="@drawable/ic_search_gray"
                    android:drawablePadding="@dimen/margin_extra_small"
                    android:hint="@string/search_tag"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/text_medium"
                    android:textColorHint="@color/text_medium"
                    android:textCursorDrawable="@drawable/bg_field_cursor"
                    android:textSize="@dimen/text_size_body"
                    android:visibility="visible"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.5" />

            </android.support.design.widget.CollapsingToolbarLayout>

        </android.support.design.widget.AppBarLayout>

    </android.support.design.widget.CoordinatorLayout>

</LinearLayout>
