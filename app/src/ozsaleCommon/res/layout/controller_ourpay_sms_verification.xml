<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <include layout="@layout/partial_toolbar_arrow" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            fontPath="@string/font_app_semibold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            android:layout_marginTop="@dimen/padding_default"
            android:paddingEnd="@dimen/padding_default"
            android:paddingStart="@dimen/padding_default"
            android:text="@string/an_sms_with_your_code_has_been_sent_to_this_number"
            android:textColor="@color/text_medium"
            android:textSize="@dimen/text_size_caption1" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                fontPath="@string/font_app_semibold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:padding="@dimen/padding_default"
                android:text="@string/country_code"
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_caption1" />

            <EditText
                android:id="@+id/controller_ourpay_edittext_extension"
                style="@style/DDEditTextStyleNoBorder"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"
                android:background="@color/transparent"
                android:enabled="false"
                android:textColor="@color/text_extra_dark" />

        </LinearLayout>

        <View style="@style/horizontalBorderView" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                fontPath="@string/font_app_semibold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:padding="@dimen/padding_default"
                android:text="@string/mobile_number"
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_caption1" />

            <EditText
                android:id="@+id/controller_ourpay_edittext_phone"
                style="@style/DDEditTextStyleNoBorder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:focusableInTouchMode="true"
                android:inputType="phone"
                android:textColor="@color/text_extra_dark" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/padding_default">

            <TextView
                android:id="@+id/ourpay_text_phone_error"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.35"
                android:text="@string/invalid_phone_number"
                android:textColor="@color/ourpay_red"
                android:textSize="@dimen/text_size_caption1"
                android:visibility="visible" />

            <TextView
                android:id="@+id/ourpay_text_resend_code"
                fontPath="@string/font_app_semibold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:gravity="end"
                android:text="@string/resend_code"
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_caption1" />

        </LinearLayout>

        <View
            style="@style/horizontalBorderView"
            android:layout_marginTop="@dimen/padding_default" />

        <TextView
            fontPath="@string/font_app_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enter_your_code_below"
            android:textColor="@color/text_medium"
            android:layout_marginBottom="@dimen/margin_extra_small"
            android:paddingStart="@dimen/padding_default"
            android:paddingEnd="@dimen/padding_default"
            android:textSize="@dimen/text_size_caption1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                fontPath="@string/font_app_semibold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:padding="@dimen/padding_default"
                android:text="@string/ourpay_code_hint"
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_caption1" />

            <EditText
                android:id="@+id/controller_ourpay_edittext_code"
                style="@style/DDEditTextStyleNoBorder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:focusableInTouchMode="true"
                android:textColor="@color/text_extra_dark"
                android:hint="@string/ourpay_code_hint"
                android:inputType="phone"
                android:maxLength="6" />
        </LinearLayout>

        <TextView
            android:id="@+id/ourpay_text_code_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:padding="@dimen/padding_default"
            android:text="@string/invalid_code"
            android:textColor="@color/ourpay_red"
            android:textSize="@dimen/text_size_caption1"
            android:visibility="visible" />

        <Button
            android:id="@+id/ourpay_button_confirm"
            style="@style/DDButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_default"
            android:layout_marginEnd="@dimen/padding_default"
            android:text="@string/confirm" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/controller_ourpay_progress_extension"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"/>
</LinearLayout>