<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/row_background_color"
    android:orientation="horizontal"
    android:padding="@dimen/padding_default"
    tools:ignore="MissingPrefix">

    <ImageView
        android:id="@+id/item_checkout_image"
        android:layout_width="@dimen/row_checkout_image_width"
        android:layout_height="@dimen/row_checkout_image_height"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/item_checkout_details_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/item_checkout_image"
        android:layout_marginLeft="@dimen/margin_extra_small"
        android:layout_marginRight="@dimen/margin_extra_small"
        android:layout_marginStart="@dimen/margin_small"
        android:layout_toEndOf="@id/item_checkout_image"
        android:orientation="vertical">


        <TextView
            android:id="@+id/item_checkout_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_extra_dark"
            android:textSize="@dimen/text_size_body"
            tools:text="Philosophy (Runway) Cotton Sleeveless Plain" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_checkout_color_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/color"
                android:textColor="@color/text_medium" />

            <TextView
                android:id="@+id/item_checkout_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_extra_dark"
                tools:text="Pink" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_checkout_size_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/size"
                android:textColor="@color/text_medium" />

            <TextView
                android:id="@+id/item_checkout_size_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_extra_dark"
                tools:text="AU 14" />
        </LinearLayout>

        <au.com.dealsdirect.ui.custom.PersonalisationLayout
            android:id="@+id/item_checkout_personalisation_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_checkout_price_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price_colon"
                android:textColor="@color/text_medium" />

            <TextView
                android:id="@+id/item_checkout_price"
                fontPath="@string/font_app_semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_extra_dark"
                tools:text="$19.00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_checkout_subtotal_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtotal_colon"
                android:textColor="@color/text_medium" />

            <TextView
                android:id="@+id/item_subtotal_price"
                fontPath="@string/font_app_semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_extra_dark"
                tools:text="$19.00" />

        </LinearLayout>

        <au.com.dealsdirect.ui.custom.ProductQuantityLayout
            android:id="@+id/item_checkout_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_extra_small" />


    </LinearLayout>

    <View
        style="@style/horizontalBorderView"
        android:layout_below="@id/item_checkout_details_container"
        android:layout_marginTop="@dimen/padding_default_half"/>

</RelativeLayout>