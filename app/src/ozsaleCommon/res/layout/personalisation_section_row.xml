<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <TextView
            android:id="@+id/personalisation_section_row_label"
            fontPath="@string/font_app_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:paddingEnd="@dimen/padding_small"
            android:paddingStart="@dimen/padding_small"
            android:textColor="@color/text_label"
            tools:ignore="MissingPrefix"
            tools:text="Label" />

        <au.com.dealsdirect.ui.custom.ClearFocusEditText
            android:id="@+id/personalisation_section_row_edit_text"
            fontPath="@string/font_app_semibold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/personalisation_section_row_label"
            android:background="@null"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:padding="@dimen/padding_small"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:textColor="@color/text_field"
            android:textColorHint="@color/text_hint"
            tools:text="John Doe" />

        <View
            android:id="@+id/personalisation_section_row_inner_border"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_below="@id/personalisation_section_row_edit_text"
            android:layout_marginStart="8dp"
            android:background="@color/border_regular" />

    </RelativeLayout>

    <View
        android:id="@+id/personalisation_section_row_border"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="5dp"
        android:background="@color/border_regular"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/personalisation_section_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/personalisation_section_row_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="@dimen/margin_small"
            android:text="@string/this_is_a_required_field"
            android:textColor="@color/personalisation_error_color"
            android:textSize="@dimen/text_size_caption1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/personalisation_section_row_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="@string/max_characters"
            android:textSize="@dimen/text_size_caption1"
            android:visibility="gone" />

    </RelativeLayout>

</LinearLayout>
