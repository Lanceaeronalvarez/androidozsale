<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <include android:id="@+id/controller_view_address_toolbar"
        layout="@layout/partial_toolbar_arrow"/>

    <RelativeLayout
        android:id="@+id/view_addresses_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:layout_below="@id/controller_view_address_toolbar">

        <include
            layout="@layout/view_address_placeholder_layout"
            android:visibility="gone" />

        <TextView
            fontPath="@string/font_app_light"
            android:id="@+id/address_office_delivery_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/padding_default"
            android:layout_marginRight="@dimen/padding_default"
            android:layout_marginTop="@dimen/padding_default"
            android:layout_marginBottom="@dimen/padding_default_half"
            android:text="@string/my_addresses"
            android:textColor="@color/text_medium"
            android:textSize="@dimen/text_size_caption2"
            android:visibility="visible"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/controller_address_button"
            android:layout_below="@+id/address_office_delivery_subtitle">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/controller_addresses_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:visibility="visible" />

        </FrameLayout>

        <Button
            android:id="@+id/controller_address_button"
            style="@style/DDButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_margin="@dimen/padding_default"
            android:text="@string/add_new_address" />


    </RelativeLayout>

</RelativeLayout>
