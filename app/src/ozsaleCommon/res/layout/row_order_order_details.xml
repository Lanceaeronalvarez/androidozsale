<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/order_number_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <TextView
        android:id="@+id/controller_order_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_default"
        android:layout_marginEnd="@dimen/padding_default"
        android:layout_marginTop="@dimen/padding_default"
        android:layout_marginBottom="@dimen/padding_default_half"
        android:textSize="@dimen/text_size_caption2"
        android:text="@string/my_orders"
        android:textAllCaps="true" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/padding_default"
        android:paddingEnd="@dimen/padding_default"
        android:paddingTop="@dimen/padding_default_half"
        android:paddingBottom="@dimen/padding_default_half"
        android:background="@color/white">

        <TextView
            android:id="@+id/order_number_text_identifier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_sharp_colon"
            android:textColor="@color/text_extra_dark"
            android:textSize="@dimen/text_size_headline3"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/order_number_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_toEndOf="@id/order_number_text_identifier"
            android:textColor="@color/text_extra_dark"
            android:textSize="@dimen/text_size_headline3"
            tools:ignore="HardcodedText"
            tools:text="204400890" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_disclosure_indicator" />

    </RelativeLayout>

    <android.support.v7.widget.RecyclerView
        android:id="@+id/order_items_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white" />


    <TextView
        android:id="@+id/controller_order_status_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        android:layout_marginTop="@dimen/margin_small"
        android:textSize="@dimen/text_size_caption2"
        android:text="@string/order_details"
        android:textAllCaps="true" />


    <LinearLayout
        android:id="@+id/product_list_order_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:visibility="visible">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_medium"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            android:layout_marginTop="@dimen/margin_medium">

            <TextView
                android:id="@+id/delivery_address_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delivery_address"
                android:textSize="@dimen/text_size_body" />

            <TextView
                android:id="@+id/delivery_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_extra_small"
                android:layout_toEndOf="@id/delivery_address_label"
                android:gravity="end"
                android:textColor="@color/text_light"
                android:textSize="@dimen/text_size_body" />

        </RelativeLayout>

        <View
            android:layout_width="wrap_content"
            android:layout_height="@dimen/border_regular"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:background="@color/border_regular" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_medium"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            android:layout_marginTop="@dimen/margin_medium">

            <TextView
                android:id="@+id/order_date_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/approved_date"
                android:textSize="@dimen/text_size_body" />

            <TextView
                android:id="@+id/order_date_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_extra_small"
                android:layout_toEndOf="@id/order_date_label"
                android:gravity="end"
                android:text=""
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_body" />
        </RelativeLayout>

        <View
            android:layout_width="wrap_content"
            android:layout_height="@dimen/border_regular"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:background="@color/border_regular" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_medium"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            android:layout_marginTop="@dimen/margin_medium">

            <TextView
                android:id="@+id/status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_colon"
                android:textSize="@dimen/text_size_body" />

            <TextView
                android:id="@+id/status_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_extra_small"
                android:layout_toEndOf="@id/status_label"
                android:gravity="end"
                android:text=""
                android:textColor="@color/text_medium"
                android:textSize="@dimen/text_size_body" />

        </RelativeLayout>

        <View
            android:layout_width="wrap_content"
            android:layout_height="@dimen/border_regular"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:background="@color/border_regular" />

        <TextView
            android:id="@+id/controller_order_track_here_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            android:drawableRight="@drawable/ic_right_arrow"
            android:paddingBottom="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_medium"
            android:text="@string/tracking"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_size_body" />


    </LinearLayout>

</LinearLayout>