<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    android:orientation="vertical">

    <include
        android:id="@+id/controller_return_orders_toolbar_layout"
        layout="@layout/partial_toolbar_arrow" />

    <include
        layout="@layout/partial_no_return_orders_placeholder_layout"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/controller_return_orders_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/controller_return_orders_toolbar_layout"
        android:visibility="visible">

        <TextView
            android:id="@+id/controller_return_order_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:fontFamily="@string/font_app_medium"
            android:padding="@dimen/padding_default"
            android:text="@string/select_invoice"
            android:textColor="@color/text_light"
            android:textSize="@dimen/text_size_body" />

        <androidx.recyclerview.widget.RecyclerView xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/controller_returns_select_orders_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/controller_return_order_title"
            android:orientation="vertical"
            android:overScrollMode="never" />

    </RelativeLayout>


</LinearLayout>
