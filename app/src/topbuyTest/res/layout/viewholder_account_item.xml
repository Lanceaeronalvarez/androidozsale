<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:id="@+id/my_account_recycler_row_layout"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/bg_account_item_states">

    <RelativeLayout
        android:id="@+id/row_account_container"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_marginBottom="10dp" >

        <ImageView
            android:id="@+id/row_account_image"
            android:layout_marginTop="5dp"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignTop="@+id/row_account_text"
            android:layout_alignBottom="@+id/row_account_text"
            android:scaleType="fitCenter"
            tools:ignore="ContentDescription"/>


        <TextView
            android:id="@id/row_account_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="45dp"
            android:layout_marginStart="45dp"
            android:layout_marginTop="-5dp"
            android:text=""
            android:textStyle="bold"
            android:textColor="#dbffffff"
            android:textSize="20sp"/>



    </RelativeLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="62dp"
        android:layout_marginStart="62dp"
        android:layout_marginRight="0dp"
        android:layout_marginEnd="0dp"
        android:paddingLeft="5dp"
        android:paddingStart="5dp"
        android:paddingRight="0dp"
        android:paddingEnd="0dp"
        android:background="#2fffffff"/>

</LinearLayout>