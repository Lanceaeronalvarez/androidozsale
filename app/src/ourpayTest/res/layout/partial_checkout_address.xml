<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/edit_text_corner_radius"
    app:cardUseCompatPadding="true"
    app:contentPadding="@dimen/padding_default"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            fontPath="@string/font_app_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delivery_address"
            android:textColor="@color/text_medium" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_default">

            <ImageView
                android:id="@+id/partial_checkout_address_change"
                android:layout_width="@dimen/toolbar_widget_size"
                android:layout_height="@dimen/toolbar_widget_size"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_chevron_right" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/partial_checkout_address_change">

                <RelativeLayout
                    android:id="@+id/partial_checkout_address_new_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        fontPath="@string/font_app_semibold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:gravity="center_vertical"
                        android:text="@string/add_delivery_address"
                        android:textColor="@color/gray_active_field_text"
                        android:textSize="@dimen/text_size_headline2" />

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/partial_checkout_address_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="center_vertical"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/partial_checkout_address_name"
                        fontPath="@string/font_app_semibold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_medium"
                        android:textSize="@dimen/text_size_headline2"
                        tools:text="Mary Doe" />

                    <TextView
                        android:id="@+id/partial_checkout_address_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_medium"
                        android:textSize="@dimen/text_size_body"
                        tools:text="Pharmacy Warringah, Shop 4123, Broovale, NSW, 2100, Australia, +0123 123 123" />


                </LinearLayout>

            </FrameLayout>

        </RelativeLayout>

    </LinearLayout>

</android.support.v7.widget.CardView>