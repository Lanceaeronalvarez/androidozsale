<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/edit_text_corner_radius"
    app:cardUseCompatPadding="true"
    app:contentPadding="@dimen/padding_default"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            fontPath="@string/font_app_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voucher"
            android:textColor="@color/colorBlueDark" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_default">

            <ImageView
                android:id="@+id/partial_checkout_voucher_change"
                android:layout_width="@dimen/toolbar_widget_size"
                android:layout_height="@dimen/toolbar_widget_size"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_chevron_right" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/partial_checkout_voucher_change">

                <RelativeLayout
                    android:id="@+id/partial_checkout_voucher_new_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:visibility="visible">

                    <EditText
                        android:id="@+id/partial_checkout_voucher_edittext"
                        style="@style/DDEditTextStyleNoBorder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/enter_promo_code"
                        android:maxLines="1"
                        android:inputType="text"
                        android:textColor="@color/row_checkout_text_light_color"
                        android:textColorHint="@color/row_checkout_text_light_color"
                        android:imeOptions="actionDone"
                        android:visibility="gone"/>

                    <TextView
                        fontPath="@string/font_app_semibold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:gravity="center_vertical"
                        android:text="@string/add_new_voucher"
                        android:textColor="@color/gray_active_field_text"
                        android:textSize="@dimen/text_size_headline2" />

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/partial_checkout_voucher_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/partial_checkout_payment_image"
                        android:layout_width="@dimen/toolbar_widget_size"
                        android:layout_height="@dimen/toolbar_widget_size"
                        android:src="@drawable/ic_my_vouchers" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginLeft="@dimen/padding_default">

                        <TextView
                            fontPath="@string/font_app_semibold"
                            android:id="@+id/partial_checkout_voucher_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/gray_title_text"
                            android:textSize="@dimen/text_size_headline2"
                            tools:text="$5 voucher" />

                        <TextView
                            android:id="@+id/partial_checkout_voucher_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_medium"
                            android:textSize="@dimen/text_size_body"
                            tools:text="voucher will expire on 12/25/16" />


                    </LinearLayout>
                </LinearLayout>

            </FrameLayout>

        </RelativeLayout>

    </LinearLayout>

</android.support.v7.widget.CardView>