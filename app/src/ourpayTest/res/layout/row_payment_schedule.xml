<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginStart="10dp"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edit_text_rounded"
        android:paddingEnd="20dp"
        android:paddingStart="20dp">

        <TextView
            android:id="@+id/row_payment_schedule_day"
            fontPath="@string/font_app_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:textColor="@color/edit_text_label"
            android:textSize="@dimen/text_size_xxxlarge"
            tools:ignore="MissingPrefix"
            tools:text="12" />

        <TextView
            android:id="@+id/row_payment_schedule_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/row_payment_schedule_day"
            android:paddingBottom="20dp"
            android:textColor="#adadad"
            android:textSize="@dimen/text_size_large"
            tools:text="Jan" />

        <View
            android:id="@+id/row_payment_schedule_divider"
            android:layout_width="@dimen/divider_height"
            android:layout_height="match_parent"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="20dp"
            android:layout_toEndOf="@id/row_payment_schedule_day"
            android:background="@color/border_gray" />

        <ImageView
            android:id="@+id/row_payment_schedule_card_image"
            android:layout_width="30dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/row_payment_schedule_divider"
            android:src="@drawable/ic_credit_card"
            android:tint="@color/colorPrimaryDark" />

        <TextView
            android:id="@+id/row_payment_schedule_card_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/row_payment_schedule_card_image"
            android:textColor="#adadad"
            android:textSize="@dimen/text_size_xlarge"
            tools:text="95068491" />

        <TextView
            android:id="@+id/row_payment_schedule_value"
            fontPath="@string/font_app_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:textColor="@color/edit_text_label"
            android:textSize="@dimen/text_size_xxxlarge"
            tools:ignore="MissingPrefix"
            tools:text="$100" />

    </RelativeLayout>

</LinearLayout>