<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background_color"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">


    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/edit_text_corner_radius"
        app:cardUseCompatPadding="true"
        tools:ignore="MissingPrefix">

        <RelativeLayout
            android:id="@+id/view_addresses_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/padding_default"
            android:visibility="visible">

            <TextView
                android:id="@+id/address_office_delivery_subtitle"
                fontPath="@string/font_app_semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delivery_address"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_size_body" />


            <android.support.v7.widget.RecyclerView
                android:id="@+id/controller_addresses_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_default"
                android:layout_below="@+id/address_office_delivery_subtitle"
                android:overScrollMode="never" />

            <Button
                android:id="@+id/controller_address_button"
                style="@style/DDButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_margin="@dimen/padding_default"
                android:text="@string/add_new_address"
                android:visibility="gone" />

            <include
                layout="@layout/view_address_placeholder_layout"
                android:visibility="gone" />

        </RelativeLayout>
    </android.support.v7.widget.CardView>

</LinearLayout>
