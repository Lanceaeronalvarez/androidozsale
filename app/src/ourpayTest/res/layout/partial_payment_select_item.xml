<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_checkout_options"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="@dimen/padding_default"
    android:gravity="center"
    tools:ignore="MissingPrefix">

    <ImageView
        android:id="@+id/partial_checkout_payment_image"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_my_vouchers" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/partial_checkout_payment_remove"
        android:layout_toEndOf="@id/partial_checkout_payment_image"
        android:layout_marginStart="@dimen/padding_default"
        android:orientation="vertical">

        <TextView
            fontPath="@string/font_app_bold"
            android:id="@+id/partial_checkout_payment_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_medium"
            android:textSize="@dimen/text_size_headline2"
            tools:text="Master Card" />

        <TextView
            fontPath="@string/font_app_light"
            android:id="@+id/partial_checkout_payment_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_medium"
            tools:text="card ending in 02/16" />
    </LinearLayout>

    <ImageView
        android:id="@+id/partial_checkout_payment_remove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:src="@drawable/ic_remove"
        android:visibility="gone" />


</RelativeLayout>