<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/padding_default"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">

        <LinearLayout
            android:id="@+id/partial_checkout_button_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <Button
                android:id="@+id/partial_checkout_button_pay"
                style="@style/DDButtonStyle"
                android:layout_width="match_parent"
                android:text="@string/pay"
                android:visibility="gone" />

            <RelativeLayout
                android:id="@+id/partial_checkout_button_paypal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/default_button_height"
                android:layout_marginBottom="@dimen/padding_default"
                android:background="@drawable/bg_paypal_button"
                android:clickable="true"
                android:visibility="gone"
                android:elevation="1.5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/partial_checkout_button_paypal_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/pay_with"
                        android:textColor="#254181"
                        android:textSize="@dimen/text_size_headline1" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/paypal_logo"
                        tools:ignore="ContentDescription" />

                </LinearLayout>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/partial_checkout_button_masterpass"
                android:layout_width="match_parent"
                android:layout_height="@dimen/default_button_height"
                android:layout_marginBottom="@dimen/padding_default"
                android:background="@drawable/bg_masterpass_button"
                android:clickable="true"
                android:visibility="gone"
                android:elevation="1.5dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_logo_masterpass" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_masterpass_button_side"
                    android:src="@drawable/ic_chevron_right" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/partial_checkout_ourpay_panel_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_default"
                android:layout_marginTop="@dimen/padding_default"
                android:orientation="vertical"/>

        </LinearLayout>



    </LinearLayout>
</RelativeLayout>
