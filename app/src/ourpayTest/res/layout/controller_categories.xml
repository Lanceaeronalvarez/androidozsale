<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_categories_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/status_bar_height"
    android:background="@color/white"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/default_padding"
        android:layout_marginRight="@dimen/default_padding"
        android:background="#00000000">

        <ImageView
            android:id="@+id/btn_left_arrow_categories"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:src="@drawable/ic_item_details_back_arrow" />

        <TextView
            android:id="@+id/current_category_text"
            fontPath="@string/font_app_bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/btn_left_arrow_categories"
            android:gravity="center"
            android:text="@string/category_title"
            android:textColor="@color/gray_field_text"
            android:textSize="@dimen/text_size_xxxlarge"
            android:transitionName="categoryHeaderTransitionName" />

    </RelativeLayout>

    <View style="@style/horizontalBorderView"/>


    <android.support.v7.widget.RecyclerView
        android:id="@+id/categories_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/default_padding"
        android:overScrollMode="never" />


</LinearLayout>