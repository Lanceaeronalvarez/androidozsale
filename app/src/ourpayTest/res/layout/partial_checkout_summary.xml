<?xml version="1.0" encoding="utf-8"?>

<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/edit_text_corner_radius"
    app:cardUseCompatPadding="true"
    tools:ignore="MissingPrefix">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/partial_checkout_summary_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_default"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/subtotal"
                    android:textColor="@color/gray_active_field_text" />

                <TextView
                    android:id="@+id/partial_checkout_summary_subtotal"
                    fontPath="@string/font_app_medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/gray_title_text"
                    android:textSize="@dimen/text_size_caption1"
                    android:textStyle="bold"
                    tools:text="$9" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/shipping_fee"
                    android:textColor="@color/gray_active_field_text" />

                <TextView
                    android:id="@+id/partial_checkout_summary_shipping_fee"
                    fontPath="@string/font_app_medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/gray_title_text"
                    android:textSize="@dimen/text_size_caption1"
                    android:textStyle="bold"
                    tools:text="$9" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/partial_checkout_summary_voucher_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/voucher"
                    android:textColor="@color/gray_active_field_text" />

                <TextView
                    android:id="@+id/partial_checkout_summary_voucher"
                    fontPath="@string/font_app_medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/gray_title_text"
                    android:textSize="@dimen/text_size_caption1"
                    android:textStyle="bold"
                    tools:text="$9" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/partial_checkout_summary_tax_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tax"
                    android:textColor="@color/gray_active_field_text" />

                <TextView
                    android:id="@+id/partial_checkout_summary_tax"
                    fontPath="@string/font_app_medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/gray_title_text"
                    android:textSize="@dimen/text_size_caption1"
                    android:textStyle="bold"
                    tools:text="$9" />

            </LinearLayout>

        </LinearLayout>

        <View style="@style/horizontalBorderView"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/padding_default">

            <TextView
                android:id="@+id/textView"
                fontPath="@string/font_app_bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/total"
                android:textColor="#676767"
                android:textSize="@dimen/text_size_headline2" />

            <TextView
                android:id="@+id/partial_checkout_summary_total"
                fontPath="@string/font_app_bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/cart_order_price_text_color"
                android:textSize="@dimen/text_size_headline1"
                tools:text="$27" />

        </LinearLayout>

    </LinearLayout>
</android.support.v7.widget.CardView>