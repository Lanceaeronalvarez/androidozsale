<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/default_padding"
    tools:ignore="MissingPrefix">

    <android.support.v7.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/corner_radius"
        app:cardUseCompatPadding="true">

        <ImageView
            android:id="@+id/item_checkout_image"
            android:layout_width="100dp"
            android:layout_height="150dp"
            android:scaleType="fitXY"
            tools:ignore="ContentDescription" />
    </android.support.v7.widget.CardView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:paddingEnd="@dimen/default_padding"
        android:paddingStart="@dimen/default_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_above="@+id/item_checkout_quantity">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/item_checkout_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:textColor="#717171"
                    android:ellipsize="end"
                    android:textSize="@dimen/text_size_xlarge"
                    tools:text="@string/test_product_name" />

                <TextView
                    android:id="@+id/item_checkout_price"
                    fontPath="@string/font_app_semibold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:gravity="end"
                    android:textColor="@color/cart_order_price_text_color"
                    android:textSize="@dimen/text_size_xlarge"
                    tools:text="$19.00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_padding"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/item_checkout_color_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/color" />

                <TextView
                    android:id="@+id/item_checkout_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Pink" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/item_checkout_size_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/size" />

                <TextView
                    android:id="@+id/item_checkout_size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="AU 14" />
            </LinearLayout>

        </LinearLayout>


        <TextView
            android:id="@+id/item_subtotal_price"
            fontPath="@string/font_app_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/row_checkout_text_dark_color"
            android:textSize="@dimen/text_size_large"
            android:visibility="gone"
            android:text="$19.00" />

        <!--Insert Quantity Indicator here-->

        <au.com.dealsdirect.ui.custom.ProductQuantityLayout
            android:id="@+id/item_checkout_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true" />
    </RelativeLayout>

</LinearLayout>