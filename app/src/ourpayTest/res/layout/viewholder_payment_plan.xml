<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_edit_text_rounded">

    <RelativeLayout
        android:id="@+id/viewholder_payment_plan_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/default_padding">

        <TextView
            android:id="@+id/viewholder_payment_plan_title"
            fontPath="@string/font_app_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/default_padding"
            android:textColor="@color/edit_text_label"
            android:textSize="@dimen/text_size_xxxlarge"
            tools:ignore="MissingPrefix"
            tools:text="mysale" />

        <TextView
            android:id="@+id/row_payment_plan_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/viewholder_payment_plan_title"
            android:layout_marginStart="@dimen/default_padding"
            android:textColor="@color/payment_month_header_color"
            android:textSize="@dimen/text_size_large"
            tools:text="95068491" />

        <TextView
            android:id="@+id/viewholder_payment_plan_value"
            fontPath="@string/font_app_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textColor="@color/edit_text_label"
            android:textSize="@dimen/text_size_xxxlarge"
            tools:ignore="MissingPrefix"
            tools:text="$100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/viewholder_payment_plan_value"
            android:layout_toStartOf="@id/viewholder_payment_plan_balance"
            android:text="@string/balance"
            android:textColor="@color/payment_month_header_color"
            android:textSize="@dimen/text_size_large" />

        <TextView
            android:id="@+id/viewholder_payment_plan_balance"
            fontPath="@string/font_app_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/viewholder_payment_plan_value"
            android:textColor="@color/edit_text_label"
            android:textSize="@dimen/text_size_large"
            tools:ignore="MissingPrefix" />
    </RelativeLayout>

    <View
        android:id="@+id/viewholder_payment_plan_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:layout_below="@id/viewholder_payment_plan_summary"
        android:background="@color/border_gray" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/viewholder_payment_plan_divider"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/default_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/default_padding"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/viewholder_payment_plan_schedule_circle1"
                android:layout_width="@dimen/progress_graph_circle_size"
                android:layout_height="@dimen/progress_graph_circle_size"
                android:src="@drawable/ic_schedule_cancelled" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@color/border_gray" />

            <ImageView
                android:id="@+id/viewholder_payment_plan_schedule_circle2"
                android:layout_width="@dimen/progress_graph_circle_size"
                android:layout_height="@dimen/progress_graph_circle_size"
                android:src="@drawable/ic_schedule_cancelled" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@color/border_gray" />

            <ImageView
                android:id="@+id/viewholder_payment_plan_schedule_circle3"
                android:layout_width="@dimen/progress_graph_circle_size"
                android:layout_height="@dimen/progress_graph_circle_size"
                android:src="@drawable/ic_schedule_cancelled" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@color/border_gray" />

            <ImageView
                android:id="@+id/viewholder_payment_plan_schedule_circle4"
                android:layout_width="@dimen/progress_graph_circle_size"
                android:layout_height="@dimen/progress_graph_circle_size"
                android:src="@drawable/ic_schedule_cancelled" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/viewholder_payment_plan_schedule_date1"
                android:layout_width="@dimen/progress_date_textview_size"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:textColor="@color/edit_text_content"
                android:textSize="@dimen/text_size_large"
                tools:text="feb 01" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/viewholder_payment_plan_schedule_date2"
                android:layout_width="@dimen/progress_date_textview_size"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:textColor="@color/edit_text_content"
                android:textSize="@dimen/text_size_large"
                tools:text="feb 14" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/row_payment_plan_schedule_date3"
                android:layout_width="@dimen/progress_date_textview_size"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:textColor="@color/edit_text_content"
                android:textSize="@dimen/text_size_large"
                tools:text="feb 28" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/row_payment_plan_schedule_date4"
                android:layout_width="@dimen/progress_date_textview_size"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:textColor="@color/edit_text_content"
                android:textSize="@dimen/text_size_large"
                tools:text="mar 14" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row_payment_plan_schedule_value1"
                fontPath="@string/font_app_bold"
                android:layout_width="@dimen/progress_date_textview_size"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/edit_text_label"
                android:textSize="@dimen/text_size_large"
                tools:ignore="MissingPrefix"
                tools:text="@string/_25" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/viewholder_payment_plan_schedule_value2"
                fontPath="@string/font_app_bold"
                android:layout_width="@dimen/progress_date_textview_size"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/edit_text_label"
                android:textSize="@dimen/text_size_large"
                tools:ignore="MissingPrefix"
                tools:text="@string/_25" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/viewholder_payment_plan_schedule_value3"
                fontPath="@string/font_app_bold"
                android:layout_width="@dimen/progress_date_textview_size"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/edit_text_label"
                android:textSize="@dimen/text_size_large"
                tools:ignore="MissingPrefix"
                tools:text="@string/_25" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/viewholder_payment_plan_schedule_value4"
                fontPath="@string/font_app_bold"
                android:layout_width="@dimen/progress_date_textview_size"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/edit_text_label"
                android:textSize="@dimen/text_size_large"
                tools:ignore="MissingPrefix"
                tools:text="@string/_25" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>