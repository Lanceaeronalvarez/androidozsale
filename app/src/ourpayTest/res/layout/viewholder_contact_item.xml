<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/my_contact_us_recycler_row_item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_account_item"
    tools:ignore="MissingPrefix"
    android:clickable="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/my_contact_item_container_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RelativeLayout
            android:id="@+id/my_contact_us_row_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_default">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/my_contact_us_row_item_time_stamp_text_view"
                android:orientation="vertical">

                <TextView
                    fontPath="@string/font_app_bold"
                    android:id="@+id/my_contact_us_row_title_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_medium"
                    android:textSize="@dimen/text_size_headline3"
                    tools:text="Puma Designer Collaboration" />

                <TextView
                    fontPath="@string/font_app_light"
                    android:id="@+id/my_contact_us_row_description_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/text_medium"
                    android:textSize="@dimen/text_size_body"
                    tools:text="hi my order has not yet arrived" />
            </LinearLayout>

            <TextView
                android:id="@+id/my_contact_us_row_item_time_stamp_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="@color/text_extra_light"
                android:textSize="@dimen/text_size_caption1"
                tools:text="06:57pm"/>


        </RelativeLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_regular" />

</LinearLayout>