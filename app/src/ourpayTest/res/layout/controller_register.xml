<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_splash"
    android:orientation="vertical"
    tools:ignore="MissingPrefix">

    <include layout="@layout/partial_toolbar_login" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/controller_register_back_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:rotation="180"
                android:src="@drawable/ic_gray_chevron"
                android:tint="#959595"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/controller_splash_app_logo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/logo_white"/>

            <LinearLayout
                android:id="@+id/controller_login_input_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/padding_default"
                android:background="@drawable/bg_edit_text_rounded"
                android:orientation="vertical">

                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/first_name"
                    android:padding="@dimen/padding_default"
                    android:textColor="@color/dark_text"
                    android:textSize="@dimen/text_size_caption1"/>

                <android.support.design.widget.TextInputLayout
                    android:id="@+id/controller_register_forename_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/controller_register_forename_field"
                        style="@style/DDEditTextStyle"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/first_name"
                        android:inputType="textPersonName"
                        android:maxLines="1"/>

                </android.support.design.widget.TextInputLayout>

                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/last_name"
                    android:textColor="@color/dark_text"
                    android:textSize="@dimen/text_size_caption1"
                    android:padding="@dimen/padding_default"/>

                <android.support.design.widget.TextInputLayout
                    android:id="@+id/controller_register_surname_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/controller_register_surname_field"
                        style="@style/DDEditTextStyle"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/last_name"
                        android:inputType="textPersonName"
                        android:maxLines="1"/>

                </android.support.design.widget.TextInputLayout>


                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/email_address"
                    android:textColor="@color/dark_text"
                    android:textSize="@dimen/text_size_caption1"
                    android:padding="@dimen/padding_default"/>

                <android.support.design.widget.TextInputLayout
                    android:id="@+id/controller_register_email_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/controller_register_email_field"
                        style="@style/DDEditTextStyle"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/email_hint"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"/>

                </android.support.design.widget.TextInputLayout>

                <TextView
                    fontPath="@string/font_app_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:padding="@dimen/padding_default"
                    android:text="@string/password"
                    android:textColor="@color/dark_text"
                    android:textSize="@dimen/text_size_caption1"/>

                <android.support.design.widget.TextInputLayout
                    android:id="@+id/controller_register_password_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleDrawable="@drawable/ic_show_password_toggle">

                    <EditText
                        android:id="@+id/controller_register_password_field"
                        style="@style/DDEditTextStyle"
                        fontPath="@string/font_app_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/password_hint"
                        android:inputType="textPassword"/>

                </android.support.design.widget.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:padding="@dimen/padding_default"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/controller_register_terms_conditions_check"
                        fontPath="@string/font_app_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_caption1"
                        android:checked="false"
                        android:textColor="@color/filter_text_inactive"
                        android:layout_marginLeft="-5dp"
                        android:text="I agree to the "  />

                    <TextView
                        android:id="@+id/controller_register_terms_link"
                        fontPath="@string/font_app_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_caption1"
                        android:textColor="@color/tab_bar_icon_active"
                        android:text="Terms and Conditions" />
                </LinearLayout>



            </LinearLayout>

            <Button
                android:id="@+id/controller_register_sign_up_button"
                style="@style/DDButtonStyle"
                fontPath="@string/font_app_semibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/padding_default"
                android:padding="@dimen/padding_default"
                android:text="@string/join_now"
                android:textSize="@dimen/text_size_headline3"/>

            <RelativeLayout
                android:id="@+id/controller_login_fb_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/default_button_height"
                android:layout_margin="@dimen/padding_default"
                android:background="@drawable/login_default_button"
                android:clickable="true"
                android:elevation="@dimen/cardview_default_elevation">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/controller_login_facebook_image_view"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/facebook"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/controller_login_with_facebook_text"
                        fontPath="@string/font_app_semibold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/padding_default"
                        android:text="@string/sign_in_with_facebook"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/text_size_headline3" />
                </LinearLayout>
            </RelativeLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingBottom="@dimen/padding_default"
                android:visibility="gone"
                android:gravity="bottom">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <TextView
                        fontPath="@string/font_app_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/already_a_member"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/controller_register_login_text"
                        fontPath="@string/font_app_semibold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="0dp"
                        android:paddingStart="5dp"
                        android:text="@string/log_in"
                        android:textAllCaps="true"
                        android:textColor="@color/bg_button_default"
                        android:textSize="@dimen/text_size_headline2" />

                    <TextView
                        fontPath="@string/font_app_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="0dp"
                        android:paddingStart="5dp"
                        android:text="@string/here"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_body" />

                </LinearLayout>


                <TextView
                    android:id="@+id/controller_login_forgot_password_text"
                    fontPath="@string/font_app_light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:text="@string/forgot_password"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_body" />

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>