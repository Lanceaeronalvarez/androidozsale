<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/controller_edit_account_header"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:contentDescription="@string/controller_edit_account_header"
        android:scaleType="fitXY"
        android:src="@drawable/bg_default_horizontal" />

    <TextView
        fontPath="@string/font_lato_bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/status_bar_height"
        android:padding="10dp"
        android:text="@string/edit_account"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_xxxlarge"
        tools:ignore="MissingPrefix" />

    <ImageButton
        android:id="@+id/controller_back"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/status_bar_height"
        android:background="@drawable/bg_toolbar_ripple"
        android:clickable="true"
        android:contentDescription="@string/ic_back"
        android:src="@drawable/ic_back" />

    <android.support.design.widget.FloatingActionButton
        android:layout_width="180dp"
        android:layout_height="160dp"
        android:src="@mipmap/ic_launcher_round"
        android:translationY="-20dp"
        app:backgroundTint="@android:color/transparent"
        app:borderWidth="0dp"
        app:elevation="0dp"
        app:layout_anchor="@id/controller_edit_account_header"
        app:layout_anchorGravity="bottom|center_horizontal" />

    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="160dp"
        android:overScrollMode="never"
        android:translationZ="-1dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/bg_edit_text_rounded"
                android:orientation="vertical"
                android:paddingBottom="20dp"
                android:paddingTop="10dp">

                <TextView
                    fontPath="@string/font_lato_bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/name"
                    android:textColor="@color/edit_text_label"
                    android:textSize="@dimen/text_size_large"
                    tools:ignore="MissingPrefix" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/transparent"
                    android:hint="@string/mary_doe"
                    android:textColor="@color/edit_text_content"
                    android:textSize="@dimen/text_size_large" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/border_gray" />

                <TextView
                    fontPath="@string/font_lato_bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/contact_number"
                    android:textColor="@color/edit_text_label"
                    android:textSize="@dimen/text_size_large"
                    tools:ignore="MissingPrefix" />

                <TextView
                    android:id="@+id/controller_contact_number_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_chevron"
                    android:hint="@string/_1_202_555_0104"
                    android:textColor="@color/edit_text_content"
                    android:textSize="@dimen/text_size_large" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/border_gray" />

                <TextView
                    fontPath="@string/font_lato_bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/email_address"
                    android:textColor="@color/edit_text_label"
                    android:textSize="@dimen/text_size_large"
                    tools:ignore="MissingPrefix" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/transparent"
                    android:hint="@string/marydoe_gmail_com"
                    android:textColor="@color/edit_text_content"
                    android:textSize="@dimen/text_size_large" />

            </LinearLayout>

            <Button
                android:id="@+id/controller_account_edit_button"
                style="@style/OPButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/save_changes" />

        </LinearLayout>

    </android.support.v4.widget.NestedScrollView>

</android.support.design.widget.CoordinatorLayout>