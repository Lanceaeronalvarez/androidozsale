<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:contentDescription="@string/controller_edit_account_header"
        android:scaleType="fitXY"
        android:src="@drawable/bg_default_horizontal" />

    <ImageView
        android:layout_width="300dp"
        android:layout_height="172dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="50dp"
        android:background="@drawable/bg_credit_card"
        android:elevation="6dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_credit_card" />

    <TextView
        android:id="@+id/controller_credit_card_header"
        fontPath="@string/font_lato_bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/status_bar_height"
        android:padding="10dp"
        android:text="@string/add_new_credit_card"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_xxxlarge"
        tools:ignore="MissingPrefix" />

    <ImageButton
        android:id="@+id/controller_back"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/status_bar_height"
        android:background="@drawable/bg_toolbar_ripple"
        android:clickable="true"
        android:contentDescription="@string/ic_back"
        android:src="@drawable/ic_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="220dp"
        android:background="@color/bg_gray"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            fontPath="@string/font_lato_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="@string/fill_out_credit_card_details"
            android:textColor="@color/edit_text_content"
            android:textSize="@dimen/text_size_xxxlarge"
            tools:ignore="MissingPrefix" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_edit_text_rounded"
            android:orientation="vertical">

            <TextView
                fontPath="@string/font_lato_bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="@string/credit_card_number"
                android:textColor="@color/edit_text_label"
                android:textSize="@dimen/text_size_large"
                tools:ignore="MissingPrefix" />

            <EditText
                android:id="@+id/controller_credit_card_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:hint="@string/_1234_5678_9012_3456"
                android:inputType="number"
                android:textColor="@color/edit_text_content"
                android:textSize="@dimen/text_size_large" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="20dp"
                android:background="@color/border_gray" />

            <TextView
                fontPath="@string/font_lato_bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:text="@string/cardholder_s_name"
                android:textColor="@color/edit_text_label"
                android:textSize="@dimen/text_size_large"
                tools:ignore="MissingPrefix" />

            <EditText
                android:id="@+id/controller_credit_card_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:hint="@string/mary_doe"
                android:textColor="@color/edit_text_content"
                android:textSize="@dimen/text_size_large" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="20dp"
                android:background="@color/border_gray" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/controller_credit_card_cvv_label"
                    fontPath="@string/font_lato_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/cvv"
                    android:textColor="@color/edit_text_label"
                    android:textSize="@dimen/text_size_large"
                    tools:ignore="MissingPrefix" />

                <EditText
                    android:id="@+id/controller_credit_card_cvv_input"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/controller_credit_card_cvv_label"
                    android:layout_marginBottom="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/transparent"
                    android:hint="@string/_9679_9679_9679"
                    android:textColor="@color/edit_text_content"
                    android:textSize="@dimen/text_size_large" />

                <View
                    android:id="@+id/controller_credit_card_divider_vertical"
                    android:layout_width="@dimen/divider_height"
                    android:layout_height="83dp"
                    android:layout_centerInParent="true"
                    android:background="@color/border_gray" />

                <TextView
                    android:id="@+id/controller_credit_card_expiry_label"
                    fontPath="@string/font_lato_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_toEndOf="@id/controller_credit_card_divider_vertical"
                    android:text="@string/expiration_date"
                    android:textColor="@color/edit_text_label"
                    android:textSize="@dimen/text_size_large"
                    tools:ignore="MissingPrefix" />

                <TextView
                    android:id="@+id/controller_credit_card_expiry_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/controller_credit_card_expiry_label"
                    android:layout_marginBottom="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_toEndOf="@id/controller_credit_card_divider_vertical"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_chevron"
                    android:hint="@string/dec_2025"
                    android:textColor="@color/edit_text_content"
                    android:textSize="@dimen/text_size_large" />


            </RelativeLayout>

        </LinearLayout>

        <Button
            android:id="@+id/controller_credit_card_save_button"
            style="@style/OPButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="@string/save_changes" />

    </LinearLayout>

</android.support.design.widget.CoordinatorLayout>