<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <android.support.v4.view.ViewPager
        android:id="@+id/controller_welcome_view_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_default"
        android:layout_above="@+id/controller_welcome_login_button"
        android:overScrollMode="never" />

    <me.relex.circleindicator.CircleIndicator
        android:id="@+id/controller_welcome_page_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/controller_welcome_view_pager"
        android:layout_marginBottom="20dp"
        app:ci_animator="@animator/alpha"
        app:ci_animator_reverse="@animator/alpha_reverse"
        app:ci_drawable="@drawable/page_indicator_active"
        app:ci_drawable_unselected="@drawable/page_indicator_inactive"
        app:ci_height="7dp"
        app:ci_width="7dp" />

    <Button
        android:id="@+id/controller_welcome_login_button"
        style="@style/OPButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/partial_signup_footer"
        android:layout_margin="20dp"
        android:text="@string/log_in" />

    <include layout="@layout/partial_signup_footer" />

</RelativeLayout>