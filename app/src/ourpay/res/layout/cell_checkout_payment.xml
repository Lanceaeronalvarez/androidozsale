<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/cell_checkout_item_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        android:layout_marginStart="5dp"
        android:background="@drawable/bg_checkout_payment"
        android:clickable="true"
        android:gravity="start|bottom"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/cell_checkout_payment_card_number"
            fontPath="@string/font_lato_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_3456"
            android:textColor="@color/payment_text_selector"
            android:textSize="@dimen/text_size_xlarge"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/cell_checkout_payment_expiry"
            fontPath="@string/font_lato_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/cell_checkout_payment_card_number"
            android:text="@string/valid_thru_dec_2025"
            android:textColor="@color/payment_text_selector"
            android:textSize="@dimen/text_size_medium"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/cell_checkout_payment_name"
            fontPath="@string/font_lato_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/cell_checkout_payment_expiry"
            android:text="@string/mary_doe"
            android:textColor="@color/payment_text_selector"
            android:textSize="@dimen/text_size_medium"
            tools:ignore="MissingPrefix" />

    </RelativeLayout>

</RelativeLayout>