<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="260dp"
    android:layout_margin="5dp"
    app:cardCornerRadius="8dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="195dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_sample_product" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal|bottom"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cell_shop_product_name"
            fontPath="@string/font_lato_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/edit_text_label"
            android:textSize="@dimen/text_size_xxlarge"
            tools:ignore="MissingPrefix"
            tools:text="Lavish Alice" />

        <TextView
            android:id="@+id/cell_shop_product_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#adadad"
            android:textSize="@dimen/text_size_medium"
            tools:text="Women's Fashion Fit" />

        <TextView
            android:id="@+id/cell_shop_product_value"
            fontPath="@string/font_lato_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_size_xxlarge"
            tools:ignore="MissingPrefix"
            tools:text="$45.00" />

    </LinearLayout>

</android.support.v7.widget.CardView>