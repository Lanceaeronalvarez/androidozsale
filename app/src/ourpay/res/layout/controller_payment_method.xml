<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:contentDescription="@string/controller_edit_account_header"
        android:scaleType="fitXY"
        android:src="@drawable/bg_default_horizontal" />

    <android.support.v4.view.ViewPager
        android:id="@+id/controller_payment_method_view_pager"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="70dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingEnd="30dp"
        android:paddingStart="30dp" />

    <me.relex.circleindicator.CircleIndicator
        android:id="@+id/controller_payment_method_page_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="165dp"
        app:ci_animator="@animator/alpha"
        app:ci_animator_reverse="@animator/alpha_reverse"
        app:ci_drawable="@drawable/page_indicator_active"
        app:ci_drawable_unselected="@drawable/page_indicator_inactive"
        app:ci_height="7dp"
        app:ci_width="7dp" />

    <TextView
        fontPath="@string/font_lato_bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/status_bar_height"
        android:padding="10dp"
        android:text="@string/select_payment_method"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_xxxlarge"
        tools:ignore="MissingPrefix" />

    <ImageButton
        android:id="@+id/controller_back"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/status_bar_height"
        android:background="@drawable/bg_toolbar_ripple"
        android:clickable="true"
        android:contentDescription="@string/ic_back"
        android:src="@drawable/ic_back" />

    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="180dp"
        android:fillViewport="true"
        android:overScrollMode="never">

        <include layout="@layout/content_payment_method" />

    </android.support.v4.widget.NestedScrollView>

</android.support.design.widget.CoordinatorLayout>