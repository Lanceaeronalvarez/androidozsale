<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/controller_account_header"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:contentDescription="@string/controller_account_header"
        android:scaleType="fitXY"
        android:src="@drawable/bg_default_horizontal" />

    <ImageButton
        android:id="@+id/controller_account_logout"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/status_bar_height"
        android:background="@drawable/bg_toolbar_ripple"
        android:clickable="true"
        android:contentDescription="@string/ic_logout"
        android:padding="16dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_account_logout" />

    <ImageButton
        android:id="@+id/controller_account_edit"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/status_bar_height"
        android:background="@drawable/bg_toolbar_ripple"
        android:clickable="true"
        android:contentDescription="@string/ic_edit"
        android:padding="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_account_edit" />

    <android.support.design.widget.FloatingActionButton
        android:layout_width="180dp"
        android:layout_height="160dp"
        android:src="@mipmap/ic_launcher_round"
        android:translationY="-20dp"
        app:backgroundTint="@android:color/transparent"
        app:borderWidth="0dp"
        app:elevation="0dp"
        app:layout_anchor="@id/controller_account_header"
        app:layout_anchorGravity="bottom|center_horizontal" />

    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="160dp"
        android:overScrollMode="never"
        android:translationZ="-1dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="20dp"
                    android:paddingTop="20dp">

                    <TextView
                        fontPath="@string/font_lato_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/email_address"
                        android:textColor="@color/edit_text_label"
                        android:textSize="@dimen/text_size_large"
                        tools:ignore="MissingPrefix" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:text="@string/marydoe_gmail_com"
                        android:textColor="@color/edit_text_content"
                        android:textSize="@dimen/text_size_large" />

                </LinearLayout>

                <View
                    android:layout_width="@dimen/divider_height"
                    android:layout_height="match_parent"
                    android:background="@color/border_gray" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="20dp"
                    android:paddingTop="20dp">

                    <TextView
                        fontPath="@string/font_lato_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contact_number"
                        android:textColor="@color/edit_text_label"
                        android:textSize="@dimen/text_size_large"
                        tools:ignore="MissingPrefix" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:text="@string/_1_202_555_0104"
                        android:textColor="@color/edit_text_content"
                        android:textSize="@dimen/text_size_large" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                fontPath="@string/font_lato_heavy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_membership"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/gold_membership"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:translationZ="4dp"
                tools:ignore="MissingPrefix" />

            <TextView
                fontPath="@string/font_lato_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/your_cards"
                android:textColor="@color/edit_text_content"
                android:textSize="@dimen/text_size_xxxlarge"
                tools:ignore="MissingPrefix" />

            <com.lsjwzh.widget.recyclerviewpager.RecyclerViewPager
                android:id="@+id/controller_account_recycler"
                android:layout_width="match_parent"
                android:layout_height="194dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingEnd="30dp"
                android:paddingStart="30dp"
                app:rvp_singlePageFling="true"
                app:rvp_triggerOffset="0.1" />

            <Button
                android:id="@+id/controller_account_add_credit_card"
                style="@style/OPButtonStyle.Hollow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:drawablePadding="-80dp"
                android:drawableStart="@drawable/ic_add"
                android:paddingEnd="10dp"
                android:paddingStart="100dp"
                android:text="@string/add_new_credit_card" />

        </LinearLayout>

    </android.support.v4.widget.NestedScrollView>

</android.support.design.widget.CoordinatorLayout>