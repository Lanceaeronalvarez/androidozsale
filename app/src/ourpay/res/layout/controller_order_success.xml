<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_default_horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="@dimen/status_bar_height"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            fontPath="@string/font_lato_semibold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/order_successful"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_size_xxxxxlarge"
            tools:ignore="MissingPrefix" />

        <TextView
            fontPath="@string/font_lato_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="20dp"
            android:gravity="center"
            android:text="@string/your_order_will_arrive_within_14_to_28_working_days_after_the_sale_has_finished"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_xxlarge"
            tools:ignore="MissingPrefix" />

    </LinearLayout>

    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="160dp"
        android:background="@color/bg_gray"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit_text_rounded"
                android:orientation="vertical"
                android:paddingTop="10dp">

                <TextView
                    fontPath="@string/font_lato_bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/delivery_address"
                    android:textColor="@color/edit_text_label"
                    android:textSize="@dimen/text_size_large"
                    tools:ignore="MissingPrefix" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/transparent"
                    android:text="@string/regent_u_7_1824_aubrey_st_surfers_paradise_qld_4170_0_123_224_32_34"
                    android:textColor="@color/edit_text_content"
                    android:textSize="@dimen/text_size_large" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:layout_marginTop="20dp"
                    android:background="@color/border_gray" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/controller_order_success_total_label"
                        fontPath="@string/font_lato_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/total_payment"
                        android:textColor="@color/edit_text_label"
                        android:textSize="@dimen/text_size_large"
                        tools:ignore="MissingPrefix" />

                    <TextView
                        android:id="@+id/controller_order_success_total_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/controller_order_success_total_label"
                        android:layout_marginBottom="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:background="@android:color/transparent"
                        android:text="@string/_350_00"
                        android:textColor="@color/edit_text_content"
                        android:textSize="@dimen/text_size_large" />

                    <View
                        android:id="@+id/controller_order_success_divider_vertical"
                        android:layout_width="@dimen/divider_height"
                        android:layout_height="83dp"
                        android:layout_centerInParent="true"
                        android:background="@color/border_gray" />

                    <TextView
                        android:id="@+id/controller_order_success_order_label"
                        fontPath="@string/font_lato_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_toEndOf="@id/controller_order_success_divider_vertical"
                        android:text="@string/order_number"
                        android:textColor="@color/edit_text_label"
                        android:textSize="@dimen/text_size_large"
                        tools:ignore="MissingPrefix" />

                    <TextView
                        android:id="@+id/controller_order_success_order_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/controller_order_success_order_label"
                        android:layout_marginBottom="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:layout_toEndOf="@id/controller_order_success_divider_vertical"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:text="@string/_49206291"
                        android:textColor="@color/edit_text_content"
                        android:textSize="@dimen/text_size_large" />

                </RelativeLayout>

            </LinearLayout>

            <Button
                android:id="@+id/controller_order_success_continue_shopping_button"
                style="@style/OPButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:text="@string/continue_shopping" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/border_gray" />

            <include layout="@layout/partial_ourpay_grid" />

            <TextView
                fontPath="@string/font_lato_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:drawableBottom="@drawable/ic_logo_gray"
                android:gravity="center"
                android:scaleX=".60"
                android:scaleY=".60"
                android:text="@string/thank_you_for_using"
                android:textColor="@color/edit_text_label"
                android:textSize="28sp"
                tools:ignore="MissingPrefix" />

        </LinearLayout>

    </android.support.v4.widget.NestedScrollView>

</android.support.design.widget.CoordinatorLayout>