<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Making the app fullscreen and the status bar background transparent. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>

    <style name="OPButtonStyle" parent="Base.Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">@dimen/text_size_xlarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_button_rounded</item>
    </style>

    <style name="OPButtonStyle.Dark" parent="Base.Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">@dimen/text_size_xlarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_button_rounded_dark</item>
    </style>


    <style name="OPButtonStyle.Hollow" parent="Base.Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">@dimen/text_size_xlarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/edit_text_content</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_button_rounded_hollow</item>
        <item name="fontPath">@string/font_lato_bold</item>
    </style>

    <style name="OPTabLayoutStyle" parent="Widget.Design.TabLayout">
        <item name="tabTextAppearance">@style/OPTabLayoutTextAppearance</item>
    </style>

    <style name="OPTabLayoutTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/text_size_xlarge</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontPath">@string/font_lato_semibold</item>
    </style>
</resources>
