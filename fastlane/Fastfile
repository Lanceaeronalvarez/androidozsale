default_platform :android

# Uploads the app to Fabric
def uploadToFabric(app_name, emails, apk_name)
  puts "Uploading to fabric"
    tries = 3
    begin
      # Optional, lets you filter out merge commits
      #changelog_from_git_commits(merge_commit_filtering: 'exclude_merges')

      crashlytics(api_token: API_TOKEN,
           build_secret: BUILD_SECRET,
                 emails: emails,
               apk_path: GRADLE_APK_OUTPUT_PATH + apk_name,
          notifications: true)
    rescue Exception => e
      puts e
      if tries > 0
        retry
      else
        puts "Error uploading"
      end
    end
end

# Builds the app with scheme name
def build(app_flavor)
  # Adjust the `build_type` and `flavor` params as needed to build the right APK for your setup
  gradle(task: "assemble", flavor: app_flavor)
end

# Displays emails on which the build will be sent to
def displayEmails(emails)
  puts "----------------------"
  puts "--Sending emails to:--"
  puts "----------------------"
  puts emails
  puts "----------------------"
end

lane :dd_build do |options|
  build(options[:app_flavor])

  emails = options[:emails]

  displayEmails(emails)

  uploadToFabric(options[:app_name], emails, options[:apk_name])
end

