<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="60dp">

        <LinearLayout
            android:id="@+id/ptr_classic_header_rotate_view_header_text"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ptr_classic_header_rotate_view_layout"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ptr_classic_header_rotate_view_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#666666"
                android:textSize="12sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/ptr_classic_header_rotate_view_header_last_update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#999999"
                android:textSize="10sp"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/ptr_classic_header_rotate_view_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true">

            <ImageView
                android:id="@+id/ptr_classic_header_rotate_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ptr_rotate_arrow"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/ptr_classic_header_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:src="@drawable/ic_deals"/>

            <ProgressBar
                android:id="@+id/ptr_classic_header_rotate_view_progressbar"
                style="@android:style/Widget.Material.ProgressBar.Small"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:color="#F00065"
                android:indeterminateTintMode="src_in"/>

            <ProgressBar
                android:id="@+id/ptr_classic_header_pull_view_progressbar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="center"
                android:max="100"
                android:padding="3dp"
                android:progress="100"
                android:progressDrawable="@drawable/bg_progress"/>
        </FrameLayout>
    </RelativeLayout>

</LinearLayout>
